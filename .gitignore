node_modules/
dist/
.astro/
.env
.env.production
.DS_Store
npm-debug.log*
__pycache__/

# Le dossier du jeu est fabriqué de bout en bout par outils/construire-jeu.mjs,
# à chaque construction. Ses sources sont dans jeu/, à la racine.
public/jeu/

# Idem pour la carte, fabriquée par outils/construire-carte.mjs depuis carte/.
# carte/relief.json, lui, est versionné : c'est un relevé, pas une sortie.
public/carte/
dist-*/

# Idem pour l'atlas des variétés, recopié par outils/construire-arabica.mjs
# depuis arabica/.
public/arabica/

# Idem pour l'arbre à souhaits, recopié par outils/construire-wishes.mjs
# depuis wishes/.
public/wishes/

# Tuiles d'altitude mises de côté par outils/relever-relief.mjs.
.cache/
/livraison/
/.avant/

# Sondes jetables de l'épreuve : elles vivent le temps d'un diagnostic.
tests/.*.mjs
