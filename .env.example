# --- Shopify (Storefront API / Buy Button SDK) ---
# Boutique Shopify : xxxx.myshopify.com
PUBLIC_SHOPIFY_DOMAIN=
# Jeton d'acces Storefront API (public, lecture seule)
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# URL de l'espace client Shopify (facultatif)
PUBLIC_SHOPIFY_ACCOUNT_URL=

# --- Site ---
SITE_URL=https://yunma.fr

# --- Liste d'attente (cafes epuises) ---
# Adresse du service qui enregistre les demandes de notification.
# Vide : la fiche propose un courriel pre-rempli au lieu d'un champ de saisie.
PUBLIC_LISTE_ATTENTE_URL=
