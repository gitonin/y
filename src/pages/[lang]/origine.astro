---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import AnchorNav from '../../components/AnchorNav.astro';
import Icon from '../../components/Icon.astro';
import SplitTitle from '../../components/SplitTitle.astro';
import type { IconName } from '../../components/Icon.astro';
import { langPaths } from '../../i18n/paths';
import { useTranslations, route, absolute, type Lang } from '../../i18n/utils';
import { products } from '../../data/products';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const base = Astro.site ?? new URL('https://yunma.fr');

const sectionPhotos = ['cretes-brumeuses', 'recolte-cueilleurs', 'sechage-lits'] as const;
/* Une icône par étape, dans l'ordre du tableau `steps` des dictionnaires. */
const stepIcons: IconName[] = ['cherries', 'droplet', 'dry', 'funnel', 'bean', 'cup'];
/* Dans l'ordre des engagements du dictionnaire. */
const valueIcons: IconName[] = ['leaf', 'community', 'sprout'];

const anchors = [
  { id: 'terroir', label: t.origine.anchors.terroir },
  { id: 'histoire', label: t.origine.anchors.histoire },
  { id: 'savoir-faire', label: t.origine.anchors.savoirFaire },
  { id: 'engagements', label: t.origine.anchors.engagements },
];

const jsonld = [
  {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, base).href,
    name: t.origine.seoTitle,
    description: t.origine.seoDescription,
    inLanguage: t.meta.hreflang,
    isPartOf: { '@id': `${base.origin}/#website` },
    about: { '@type': 'Place', name: 'Yunnan', address: { '@type': 'PostalAddress', addressCountry: 'CN' } },
  },
  {
    '@type': 'HowTo',
    name: t.savoirFaire.seoTitle,
    description: t.savoirFaire.seoDescription,
    inLanguage: t.meta.hreflang,
    step: t.savoirFaire.steps.map((step, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: step.title,
      text: step.text,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.common.home, item: absolute(Astro.site, `${lang}/`) },
      { '@type': 'ListItem', position: 2, name: t.nav.origine, item: absolute(Astro.site, `${lang}/origine/`) },
    ],
  },
];
---

<Base lang={lang} title={t.origine.seoTitle} description={t.origine.seoDescription} jsonld={jsonld}>
  <PageHero lang={lang} label={t.origine.label} title={t.origine.title} intro={t.origine.intro} crumb={t.nav.origine} />

  <AnchorNav items={anchors} ariaLabel={t.common.breadcrumb} />

  <!-- ============ LE YUNNAN ============ -->
  <section id="terroir" class="anchor-target">
    <div class="wrap">
      <figure class="media media--wide" data-reveal>
        <Photo name="cretes-brumeuses" lang={lang} priority sizes="(min-width: 1560px) 1560px, 100vw" />
      </figure>
    </div>

    <div class="section">
      <div class="wrap osections">
        {
          t.origine.sections.map((section, i) => (
            <article class="osection">
              <div class="osection__text">
                <span class="label" data-reveal>{section.label}</span>
                <h2 class="osection__title" data-reveal>{section.title}</h2>
                <p class="muted" data-reveal>{section.text}</p>
              </div>
              <figure class="media media--tall osection__media">
                <Photo
                  name={sectionPhotos[i % sectionPhotos.length]}
                  lang={lang}
                  position="50% 55%"
                  sizes="(min-width: 860px) 56vw, 100vw"
                />
              </figure>
            </article>
          ))
        }
      </div>
    </div>

    <div class="quote panel">
      <div class="wrap wrap--narrow">
        <blockquote data-reveal>“{t.origine.quote}”</blockquote>
      </div>
    </div>

    <div class="section section--tight">
      <div class="wrap terroirs">
        <div>
          <span class="label" data-reveal>{t.origine.mapTitle}</span>
          <p class="lead terroirs__lead" data-reveal>{t.origine.mapText}</p>
        </div>
        <ul class="terroirs__list">
          {
            products.slice(0, 3).map((product) => (
              <li data-reveal>
                <span class="label">{product.subtitle[lang].split(',')[0]}</span>
                <p class="small muted">
                  {product.specs.altitude[lang]} · {product.specs.process[lang]}
                </p>
                <p class="small muted">{product.specs.notes[lang]}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ SOUTIEN ORO YUNNAN ============ -->
  <section class="oro panel panel--soft">
    <div class="wrap oro__inner">
      <div class="oro__mark" data-reveal>
        <span class="oro__initials" aria-hidden="true">ORO</span>
        <span class="oro__oval" aria-hidden="true"></span>
      </div>
      <div class="oro__text">
        <span class="label" data-reveal>{t.origine.oroLabel}</span>
        <h2 class="oro__name" data-reveal>{t.origine.oroName}</h2>
        <p class="small muted oro__full" data-reveal>{t.origine.oroFull}</p>
        <p class="muted oro__body" data-reveal>{t.origine.oroText}</p>
      </div>
    </div>
  </section>

  <!-- ============ NOTRE HISTOIRE ============ -->
  <section id="histoire" class="section anchor-target">
    <div class="wrap">
      <span class="label" data-reveal>{t.apropos.label}</span>
      <SplitTitle text={t.apropos.title} as="h2" size="lg" class="hsection-title" />

      <div class="grid grid--sidebar hstory">
        <p class="lead" data-reveal>{t.apropos.storyText}</p>
        <div class="mission stack">
          <div data-reveal>
            <h3 class="mission__title">{t.apropos.missionTitle}</h3>
            <p class="muted">{t.apropos.missionText}</p>
          </div>
          <div data-reveal>
            <h3 class="mission__title">{t.apropos.approachTitle}</h3>
            <p class="muted">{t.apropos.approachText}</p>
          </div>
        </div>
      </div>

      <figure class="media media--wide hstory__media" data-reveal>
        <Photo name="recolte-cueilleurs" lang={lang} sizes="(min-width: 1560px) 1560px, 100vw" />
      </figure>

      <h3 class="label figures__title" data-reveal>{t.apropos.figuresTitle}</h3>
      <dl class="figures">
        {
          t.apropos.figures.map((figure, i) => (
            <div data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <dt class="figures__value">{figure.value}</dt>
              <dd class="small muted">{figure.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ============ SAVOIR-FAIRE ============ -->
  <section id="savoir-faire" class="section panel anchor-target">
    <div class="wrap">
      <span class="label" data-reveal>{t.savoirFaire.label}</span>
      <SplitTitle text={t.savoirFaire.title} as="h2" size="lg" class="hsection-title" />
      <p class="lead muted craft__intro" data-reveal>{t.savoirFaire.intro}</p>

      <ol class="steps">
        {
          t.savoirFaire.steps.map((step, i) => (
            <li class="step" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
              <div class="step__head">
                <Icon name={stepIcons[i]} size={26} class="step__icon" />
                <span class="step__n label">{step.n}</span>
              </div>
              <h3 class="step__title">{step.title}</h3>
              <p class="small muted">{step.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="brews__head">
        <div>
          <h3 class="brews__title">{t.savoirFaire.brewTitle}</h3>
          <p class="muted" data-reveal>{t.savoirFaire.brewText}</p>
        </div>
        <a class="link" href={route(lang, 'cafes')} data-reveal>
          {t.home.coffeesCta}<span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <table class="brews">
        <thead>
          <tr>
            <th scope="col">{t.savoirFaire.brewMethod}</th>
            <th scope="col">Ratio</th>
            <th scope="col">T°</th>
            <th scope="col">⏱</th>
          </tr>
        </thead>
        <tbody>
          {
            t.savoirFaire.brews.map((brew) => (
              <tr>
                <th scope="row">{brew.name}</th>
                <td>{brew.ratio}</td>
                <td>{brew.temp}</td>
                <td>{brew.time}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- ============ ENGAGEMENTS ============ -->
  <section id="engagements" class="section section--tight anchor-target">
    <div class="wrap">
      <h2 class="label" data-reveal>{t.apropos.valuesTitle}</h2>
      <ul class="values">
        {
          t.apropos.values.map((value, i) => (
            <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <Icon name={valueIcons[i]} size={28} class="values__icon" />
              <h3 class="values__title">{value.title}</h3>
              <p class="small muted">{value.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ CLÔTURE ============ -->
  <section class="closing">
    <div class="closing__media media">
      <Photo name="cretes-brumeuses" lang={lang} decorative sizes="100vw" />
    </div>
    <div class="closing__inner wrap">
      <SplitTitle text={t.apropos.closing} as="p" size="closing" class="on-dark" />
      <a class="link closing__cta" href={route(lang, 'cafes')}>
        {t.home.coffeesCta}<span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .anchor-target {
    scroll-margin-top: calc(var(--header-h) + 3.25rem);
  }

  :global(.hsection-title) {
    margin-top: 0.75rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* ---------- Le Yunnan ---------- */
  .osections {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
  }

  .osection {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 860px) {
    .osection {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }

    .osection:nth-child(even) .osection__text {
      order: 2;
    }
  }

  .osection__text {
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }

  .osection__title {
    font-size: var(--fs-h3);
  }

  .osection__text p {
    max-width: 46ch;
  }

  .quote {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    text-align: center;
  }

  .quote blockquote {
    font-size: var(--fs-h3);
    line-height: 1.32;
    letter-spacing: -0.015em;
    max-width: 24ch;
    margin-inline: auto;
  }

  .terroirs {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    justify-items: start;
  }

  .terroirs__lead {
    margin-top: 0.75rem;
  }

  .terroirs__list {
    display: grid;
    gap: 1.25rem;
    width: 100%;
  }

  @media (min-width: 760px) {
    .terroirs__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .terroirs__list li {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .terroirs__list p {
    margin-top: 0.35rem;
  }

  /* ---------- ORO Yunnan ---------- */
  .oro {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .oro__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 760px) {
    .oro__inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .oro__mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 132px;
    height: 84px;
  }

  .oro__oval {
    position: absolute;
    inset: 0;
    border: 2px solid var(--ink-30);
    border-radius: 50%;
  }

  .oro__initials {
    font-size: 1.5rem;
    letter-spacing: 0.06em;
    color: var(--ink-70);
  }

  .oro__name {
    margin-top: 0.6rem;
    font-size: var(--fs-h3);
  }

  .oro__full {
    margin-top: 0.25rem;
  }

  .oro__body {
    margin-top: 1rem;
    max-width: 62ch;
  }

  /* ---------- Notre histoire ---------- */
  .hstory {
    align-items: start;
  }

  .mission {
    --stack: 2rem;
  }

  .mission__title {
    font-size: var(--fs-h3);
    margin-bottom: 0.65rem;
  }

  .mission p {
    max-width: 48ch;
  }

  .hstory__media {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .figures__title {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .figures {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 700px) {
    .figures {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .figures > div {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .figures__value {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .figures dd {
    margin: 0;
    max-width: 22ch;
  }

  /* ---------- Savoir-faire ---------- */
  .craft__intro {
    max-width: 52ch;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .steps {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  @media (min-width: 700px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .step {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .step__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .step__icon {
    color: var(--ink-70);
  }

  .step__n {
    color: var(--accent);
  }

  .step__title {
    margin-top: 0.65rem;
    margin-bottom: 0.5rem;
    font-size: var(--fs-h3);
    font-weight: var(--w-regular);
  }

  .brews__head {
    display: grid;
    gap: 1rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  @media (min-width: 860px) {
    .brews__head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }

  .brews__title {
    font-size: var(--fs-h3);
    margin-bottom: 0.5rem;
  }

  .brews {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }

  .brews th,
  .brews td {
    text-align: left;
    padding: 0.9rem 0.75rem 0.9rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: var(--w-regular);
  }

  .brews thead th {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-50);
  }

  .brews tbody th {
    color: var(--ink);
  }

  /* ---------- Engagements ---------- */
  .values {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  @media (min-width: 800px) {
    .values {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .values__icon {
    margin-bottom: 1.1rem;
    color: var(--accent);
  }

  .values__title {
    font-size: 1.0625rem;
    margin-bottom: 0.4rem;
  }

  /* ---------- Clôture ---------- */
  .closing {
    position: relative;
    min-height: 70svh;
    display: flex;
    align-items: flex-end;
    padding-block: clamp(3rem, 8vw, 6rem);
    overflow: hidden;
  }

  .closing__media {
    position: absolute;
    inset: 0;
  }

  .closing__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(33, 33, 33, 0) 24%, rgba(33, 33, 33, 0.28) 62%, rgba(33, 33, 33, 0.6) 100%);
  }

  .closing__inner {
    position: relative;
    z-index: 2;
    color: var(--white);
  }

  .closing__cta {
    margin-top: 1.25rem;
    color: var(--white);
  }
</style>
