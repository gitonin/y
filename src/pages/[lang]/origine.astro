---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import AnchorNav from '../../components/AnchorNav.astro';
import Icon from '../../components/Icon.astro';
import SplitTitle from '../../components/SplitTitle.astro';
import Poincon from '../../components/Poincon.astro';
import PushFin from '../../components/PushFin.astro';
import type { IconName } from '../../components/Icon.astro';
import { langPaths } from '../../i18n/paths';
import { useTranslations, route, absolute, asset, type Lang } from '../../i18n/utils';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const base = Astro.site ?? new URL('https://yunma.fr');

/* La page est longue : les sous-parties sont séparées par de grands visuels
   pleine largeur, et ponctuées de phrases courtes sorties du texte. */
const sectionPhotos = ['ferme-gaosheng', 'producteur-torch-estate', 'cerises-branche'] as const;
/* Une icône par étape, dans l'ordre du tableau `steps` des dictionnaires. */
const stepIcons: IconName[] = ['cherries', 'droplet', 'dry', 'funnel', 'bean', 'cup'];
const anchors = [
  { id: 'terroir', label: t.origine.anchors.terroir },
  { id: 'histoire', label: t.origine.anchors.histoire },
  { id: 'savoir-faire', label: t.origine.anchors.savoirFaire },
];

const jsonld = [
  {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, base).href,
    name: t.origine.seoTitle,
    description: t.origine.seoDescription,
    inLanguage: t.meta.hreflang,
    isPartOf: { '@id': `${base.origin}/#website` },
    about: { '@type': 'Place', name: 'Yunnan', address: { '@type': 'PostalAddress', addressCountry: 'CN' } },
  },
  {
    '@type': 'HowTo',
    name: t.savoirFaire.seoTitle,
    description: t.savoirFaire.seoDescription,
    inLanguage: t.meta.hreflang,
    step: t.savoirFaire.steps.map((step, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: step.title,
      text: step.text,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.common.home, item: absolute(Astro.site, `${lang}/`) },
      { '@type': 'ListItem', position: 2, name: t.nav.origine, item: absolute(Astro.site, `${lang}/origine/`) },
    ],
  },
];
---

<Base
  lang={lang}
  title={t.origine.seoTitle}
  description={t.origine.seoDescription}
  jsonld={jsonld}
  fil={[{ label: t.nav.origine }]}
>
  <PageHero lang={lang} label={t.origine.label} title={t.origine.title} intro={t.origine.intro} />

  <AnchorNav items={anchors} ariaLabel={t.common.breadcrumb} />

  <!-- ============ LE YUNNAN ============ -->
  <figure class="media grand-visuel" data-reveal>
    <Photo name="panneau-plantation" lang={lang} priority sizes="100vw" />
  </figure>

  <section id="terroir" class="section section--souffle anchor-target">
    <div class="wrap osections">
      {
        t.origine.sections.map((section, i) => (
          <article class="osection">
            <div class="osection__text">
              <span class="label" data-reveal>{section.label}</span>
              <h2 class="osection__title" data-reveal>{section.title}</h2>
              <p class="muted" data-reveal>{section.text}</p>
            </div>
            <figure class="media media--tall osection__media" data-reveal>
              <Photo
                name={sectionPhotos[i % sectionPhotos.length]}
                lang={lang}
                position="50% 55%"
                sizes="(min-width: 860px) 56vw, 100vw"
              />
            </figure>
          </article>
        ))
      }
    </div>
  </section>

  {/* Le poinçon marque le passage du terroir aux fermes, et la citation reste
      sur le fond de la page : la respiration suffit à la détacher. */}
  <Poincon />

  <!-- Phrase manifeste, entre le terroir et les fermes -->
  <div class="citation">
    <div class="wrap">
      <p class="display" data-reveal>{t.origine.quote}</p>
    </div>
  </div>

  <figure class="media grand-visuel" data-reveal>
    <Photo name="fermiers-cafe" lang={lang} sizes="100vw" />
  </figure>

  <!-- ============ NOS TERROIRS ============ -->
  <section class="section panel panel--soft">
    <div class="wrap">
      <div class="citation citation--inline">
        <p class="display" data-reveal>{t.origine.pulls.terroir}</p>
      </div>

      <div class="terroirs">
        <div>
          <span class="label" data-reveal>{t.origine.mapTitle}</span>
          <p class="lead terroirs__lead" data-reveal>{t.origine.mapText}</p>
        </div>
        <ul class="terroirs__list">
          {
            t.origine.terroirs.map((terroir) => (
              <li data-reveal>
                <span class="label">{terroir.name}</span>
                <p class="small muted">{terroir.detail}</p>
                <p class="small muted">{terroir.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ SOUTIEN ORO YUNNAN ============ -->
  <section class="oro panel panel--soft">
    <div class="wrap oro__inner">
      <div class="oro__mark" data-reveal>
        <img
          src={asset('brand/oro-yunnan.png')}
          alt={`${t.origine.oroName} — ${t.origine.oroFull}`}
          width="1827"
          height="218"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="oro__text">
        <span class="label" data-reveal>{t.origine.oroLabel}</span>
        <h2 class="oro__name" data-reveal>{t.origine.oroName}</h2>
        <p class="small muted oro__full" data-reveal>{t.origine.oroFull}</p>
        <p class="muted oro__body" data-reveal>{t.origine.oroText}</p>
        <a
          class="link oro__cta"
          href="https://oroyunnanfr.com/fr/le-cafe-du-yunnan/"
          target="_blank"
          rel="noopener"
          data-reveal
        >
          {t.origine.oroCta}<span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <figure class="media grand-visuel" data-reveal>
    <Photo name="ferme-yun-lan-estate" lang={lang} sizes="100vw" />
  </figure>

  <!-- ============ NOTRE HISTOIRE ============ -->
  <section id="histoire" class="section section--souffle anchor-target">
    <div class="wrap">
      <span class="label" data-reveal>{t.apropos.label}</span>
      <SplitTitle text={t.apropos.title} as="h2" size="lg" class="sec-title hsection-title" />

      <div class="grid grid--sidebar hstory">
        <p class="lead" data-reveal>{t.apropos.storyText}</p>
        <div class="mission stack">
          <div data-reveal>
            <h3 class="mission__title">{t.apropos.missionTitle}</h3>
            <p class="muted">{t.apropos.missionText}</p>
          </div>
          <div data-reveal>
            <h3 class="mission__title">{t.apropos.approachTitle}</h3>
            <p class="muted">{t.apropos.approachText}</p>
          </div>
        </div>
      </div>

      <h3 class="label figures__title" data-reveal>{t.apropos.figuresTitle}</h3>
      <dl class="figures">
        {
          t.apropos.figures.map((figure, i) => (
            <div data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <dt class="figures__value">{figure.value}</dt>
              <dd class="small muted">{figure.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Poincon />

  <!-- Phrase sortie du récit -->
  <div class="citation">
    <div class="wrap">
      <p class="display" data-reveal>{t.origine.pulls.histoire}</p>
    </div>
  </div>

  <figure class="media grand-visuel" data-reveal>
    <Photo name="sechage-lits" lang={lang} sizes="100vw" />
  </figure>

  <!-- ============ SAVOIR-FAIRE ============ -->
  <section id="savoir-faire" class="section section--souffle anchor-target">
    <div class="wrap">
      <span class="label" data-reveal>{t.savoirFaire.label}</span>
      <SplitTitle text={t.savoirFaire.title} as="h2" size="lg" class="sec-title hsection-title" />
      <p class="lead muted craft__intro" data-reveal>{t.savoirFaire.intro}</p>

      <ol class="steps">
        {
          t.savoirFaire.steps.map((step, i) => (
            <li class="step" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
              <div class="step__head">
                <Icon name={stepIcons[i]} size={26} class="step__icon" />
                <span class="step__n label">{step.n}</span>
              </div>
              <h3 class="step__title">{step.title}</h3>
              <p class="small muted">{step.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="citation citation--inline">
        <p class="display" data-reveal>{t.origine.pulls.savoirFaire}</p>
      </div>
    </div>
  </section>

  <!-- ============ PRÉPARER UN CAFÉ YUNMA ============ -->
  {/* Sur fond anthracite : c'est un mode d'emploi, pas un récit — il se
      détache du reste de la page. */}
  <section class="section brews-bloc panel--ink">
    <div class="wrap">
      <div class="brews__head">
        <div>
          <h3 class="brews__title">{t.savoirFaire.brewTitle}</h3>
          <p class="muted" data-reveal>{t.savoirFaire.brewText}</p>
        </div>
        <a class="link" href={route(lang, 'cafes')} data-reveal>
          {t.home.coffeesCta}<span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <table class="brews">
        <thead>
          <tr>
            <th scope="col">{t.savoirFaire.brewMethod}</th>
            <th scope="col">{t.savoirFaire.brewRatio}</th>
            <th scope="col">{t.savoirFaire.brewTemp}</th>
            <th scope="col" class="brews__time">
              <Icon name="timer" size={15} label={t.savoirFaire.brewTime} />
            </th>
          </tr>
        </thead>
        <tbody>
          {
            t.savoirFaire.brews.map((brew) => (
              <tr>
                <th scope="row">{brew.name}</th>
                <td>{brew.ratio}</td>
                <td>{brew.temp}</td>
                <td>{brew.time}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- ============ CLÔTURE ============ -->
  <PushFin lang={lang} text={t.apropos.closing} cta={t.home.coffeesCta} href={route(lang, 'cafes')} />
</Base>

<style>
  .anchor-target {
    scroll-margin-top: calc(var(--header-h) + 3.25rem);
  }

  /* La page est dense : ses grandes sections respirent un cran de plus que
     le reste du site. */
  .section--souffle {
    padding-block: clamp(5rem, 10vw, 11rem);
  }

  /* Sauf juste après un grand visuel : la photographie fait la séparation, et
     la pleine respiration n'ajouterait qu'une bande de fond vide. */
  .grand-visuel + .section {
    padding-top: var(--espace-apres-visuel);
  }


  /* ---------- Grands visuels d'entre-deux ---------- */
  /* Pleine largeur, sans gouttière : ils séparent les sous-parties et
     laissent l'œil se reposer entre deux blocs de texte. */
  .grand-visuel {
    width: 100%;
    aspect-ratio: 4 / 5;
  }

  @media (min-width: 760px) {
    .grand-visuel {
      aspect-ratio: 16 / 9;
    }
  }

  /* ---------- Citations ---------- */
  /* De grandes phrases courtes, tirées du propos, qui coupent le défilement
     et donnent un point d'appui d'une sous-partie à l'autre. */
  .citation {
    padding-block: clamp(4rem, 10vw, 8.5rem);
  }

  /* Quand un poinçon précède la citation, il tient lieu de respiration haute. */
  :global(.poincon) + .citation {
    padding-top: 0;
  }

  .citation p {
    font-size: clamp(1.75rem, 1.05rem + 3.1vw, 3.5rem);
    line-height: 1.1;
    max-width: 17ch;
  }

  /* Variante posée à l'intérieur d'une section, sans changement de fond. */
  .citation--inline {
    padding-block: 0;
    margin-block: clamp(2.75rem, 7vw, 5rem);
  }

  .citation--inline p {
    font-size: clamp(1.4375rem, 1rem + 2.1vw, 2.5rem);
    max-width: 20ch;
  }

  /* ---------- Le Yunnan ---------- */
  .osections {
    display: grid;
    gap: clamp(3.5rem, 8vw, 7rem);
  }

  .osection {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 860px) {
    .osection {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }

    .osection:nth-child(even) .osection__text {
      order: 2;
    }
  }

  .osection__text {
    display: grid;
    align-content: start;
  }

  .osection__title {
    margin-top: var(--espace-surtitre);
    margin-bottom: var(--espace-titre);
    font-size: var(--fs-h3);
  }

  .osection__text p {
    max-width: 46ch;
  }

  .terroirs {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    justify-items: start;
  }

  .terroirs__lead {
    margin-top: var(--espace-surtitre);
  }

  .terroirs__list {
    display: grid;
    gap: 1.25rem;
    width: 100%;
  }

  @media (min-width: 760px) {
    .terroirs__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .terroirs__list li {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .terroirs__list p {
    margin-top: var(--espace-carte);
  }

  /* ---------- ORO Yunnan ---------- */
  .oro {
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .oro__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .oro__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }
  }

  .oro__mark {
    max-width: 420px;
  }

  .oro__mark img {
    display: block;
    width: 100%;
    height: auto;
  }

  .oro__name {
    margin-top: var(--espace-surtitre);
    font-size: var(--fs-h3);
  }

  .oro__full {
    margin-top: var(--espace-carte);
  }

  .oro__body {
    margin-top: var(--espace-titre);
    max-width: 62ch;
  }

  .oro__cta {
    margin-top: var(--espace-titre);
  }

  /* ---------- Notre histoire ---------- */
  .hstory {
    align-items: start;
  }

  .mission {
    --stack: 2rem;
  }

  .mission__title {
    font-size: var(--fs-h3);
    margin-bottom: 0.65rem;
  }

  .mission p {
    max-width: 48ch;
  }

  .figures__title {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .figures {
    margin-top: var(--espace-titre);
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 700px) {
    .figures {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .figures > div {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .figures__value {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .figures dd {
    margin: 0;
    max-width: 22ch;
  }

  /* ---------- Savoir-faire ---------- */
  .craft__intro {
    max-width: 52ch;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .steps {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  @media (min-width: 700px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .step {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .step__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .step__icon {
    color: var(--ink-70);
  }

  .step__n {
    color: var(--accent);
  }

  .step__title {
    margin-top: 0.65rem;
    margin-bottom: 0.5rem;
    font-size: var(--fs-h3);
    font-weight: var(--w-regular);
  }

  /* ---------- Préparer un café ---------- */
  /* Le tableau vit sur l'anthracite : ses en-têtes et ses filets reprennent la
     teinte du papier, en retrait, plutôt que l'encre qui s'y perdrait.

     Ces trois teintes passent par des variables, et non par des sélecteurs plus
     appuyés. La version précédente s'y était fait prendre : la règle claire,
     écrite en tête, était écrasée par une règle sombre écrite plus bas, et les
     en-têtes se retrouvaient à 52 % d'encre sur de l'anthracite — illisibles.
     Une variable se transmet à l'élément et ne se dispute avec personne. */
  .brews-bloc .brews {
    --brews-entete: rgba(235, 231, 222, 0.62);
    --brews-filet: rgba(235, 231, 222, 0.22);
    --brews-corps: var(--paper);
  }

  .brews__head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  @media (min-width: 860px) {
    .brews__head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }

  .brews__title {
    font-size: var(--fs-h3);
    margin-bottom: 0.5rem;
  }

  .brews {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }

  /* Les teintes du tableau sur fond clair ; le bloc anthracite les redéfinit. */
  .brews {
    --brews-entete: var(--ink-50);
    --brews-filet: var(--line);
    --brews-corps: var(--ink);
  }

  .brews th,
  .brews td {
    text-align: left;
    padding: 0.9rem 0.75rem 0.9rem 0;
    border-bottom: 1px solid var(--brews-filet);
    font-weight: var(--w-regular);
  }

  .brews__time :global(svg) {
    display: inline-block;
    vertical-align: -0.24em;
    color: var(--brews-entete);
  }

  .brews thead th {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--brews-entete);
  }

  .brews tbody th {
    color: var(--brews-corps);
  }

</style>
