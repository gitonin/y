---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Packshot from '../../../components/Packshot.astro';
import BuyBox from '../../../components/BuyBox.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Photo from '../../../components/Photo.astro';
import Icon from '../../../components/Icon.astro';
import type { IconName } from '../../../components/Icon.astro';
import { languages, useTranslations, url, route, formatPrice, absolute, type Lang } from '../../../i18n/utils';
import type { Product } from '../../../data/products';
import { products, getProduct, fromPrice, toPrice, defaultVariant } from '../../../data/products';
import { SITE } from '../../../consts';

export const getStaticPaths: GetStaticPaths = () =>
  languages.flatMap((lang) => products.map((product) => ({ params: { lang, slug: product.slug }, props: { product } })));

const lang = Astro.params.lang as Lang;
/* Le produit vient de getStaticPaths ; on le type ici pour que la page soit vérifiable. */
const product = Astro.props.product as Product;
const t = useTranslations(lang);
const base = Astro.site ?? new URL('https://yunma.fr');
/* Le prix affiché en haut de page est celui de la variante sélectionnée :
   il est réactualisé par l'encart d'achat à chaque changement de format. */
const variantePardefaut = defaultVariant(product);
/* Deux suggestions : la grille est sur deux colonnes, une troisième
   carte resterait seule sur sa ligne. */
/* Deux suggestions : la grille est sur deux colonnes, une troisième carte
   resterait seule sur sa ligne. */
const related = product.related.map((slug) => getProduct(slug)).filter(Boolean).slice(0, 2);

const specRows = [
  { label: t.product.origin, value: product.specs.origin[lang] },
  { label: t.product.altitude, value: product.specs.altitude[lang] },
  { label: t.product.variety, value: product.specs.variety[lang] },
  { label: t.product.process, value: product.specs.process[lang] },
  { label: t.product.notes, value: product.specs.notes[lang] },
];

const detailRows: { label: string; value: string; icon: IconName }[] = [
  { label: t.product.drying, value: product.specs.drying[lang], icon: 'dry' },
  { label: t.product.harvest, value: product.specs.harvest[lang], icon: 'cherries' },
  { label: t.product.roast, value: product.specs.roast[lang], icon: 'bean' },
];

const canonical = new URL(Astro.url.pathname, base).href;

/* Une offre par format ; regroupées quand les prix diffèrent, pour que Google
   annonce une fourchette plutôt qu'un prix unique. */
const offres = product.variants.map((variant) => ({
  '@type': 'Offer',
  name: variant.label[lang],
  url: canonical,
  priceCurrency: SITE.currency,
  price: variant.price.toFixed(2),
  availability: variant.available ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  itemCondition: 'https://schema.org/NewCondition',
  seller: { '@id': `${base.origin}/#organization` },
  shippingDetails: {
    '@type': 'OfferShippingDetails',
    shippingDestination: { '@type': 'DefinedRegion', addressCountry: ['FR', 'BE', 'DE', 'ES', 'IT', 'NL'] },
  },
}));
const offreProduit =
  product.variants.length > 1
    ? {
        '@type': 'AggregateOffer',
        priceCurrency: SITE.currency,
        lowPrice: fromPrice(product).toFixed(2),
        highPrice: toPrice(product).toFixed(2),
        offerCount: product.variants.length,
        offers: offres,
      }
    : offres[0];

const jsonld = [
  {
    '@type': 'Product',
    '@id': `${canonical}#product`,
    name: product.name[lang],
    description: product.description[lang],
    sku: product.sku,
    category: product.category === 'grain' ? 'Coffee beans' : product.category === 'drip' ? 'Drip coffee bags' : 'Coffee gift set',
    brand: { '@type': 'Brand', name: SITE.name },
    url: canonical,
    image: absolute(Astro.site, 'og/yunma-og.png'),
    countryOfOrigin: 'CN',
    additionalProperty: [...specRows, ...detailRows].map((row) => ({
      '@type': 'PropertyValue',
      name: row.label,
      value: row.value,
    })),
    offers: offreProduit,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.common.home, item: absolute(Astro.site, `${lang}/`) },
      { '@type': 'ListItem', position: 2, name: t.nav.cafes, item: absolute(Astro.site, `${lang}/cafes/`) },
      { '@type': 'ListItem', position: 3, name: product.name[lang], item: canonical },
    ],
  },
];

/* Sous le visuel du producteur, une accroche courte : la première phrase du
   récit de la ferme. Le texte complet attend dans le tiroir. */
const accroche = product.farm.text[lang].split('\n')[0].split('. ')[0] + '.';

const seoTitle = `${product.name[lang]} — ${product.subtitle[lang]}`;
const seoDescription = `${product.short[lang]} ${product.description[lang]}`.slice(0, 300);
---

<Base
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  type="product"
  jsonld={jsonld}
  keywords={[product.name[lang], product.subtitle[lang], t.common.tagline]}
>
  <div class="wrap page-top">
    <Breadcrumbs
      lang={lang}
      items={[
        { href: url(lang), label: t.common.home },
        { href: route(lang, 'cafes'), label: t.nav.cafes },
        { label: product.name[lang] },
      ]}
    />

    <div class="pdp">
      <div class="pdp__visual">
        <div class="media pdp__media bleed-mobile">
          <Packshot product={product} lang={lang} size="lg" />
        </div>
      </div>

      <div class="pdp__info">
        <h1 class="pdp__title">{product.name[lang]}</h1>
        <p class="pdp__sub muted">{product.subtitle[lang]}</p>
        <p class="pdp__price mono-num" data-price-display data-product={product.slug}>
          {formatPrice(variantePardefaut.price, lang)}
        </p>
        <p class="pdp__short">{product.short[lang]}</p>

        <BuyBox product={product} lang={lang} hidePrice />

        <a class="link pdp__more" href="#about">
          {t.common.learnMore}<span class="arrow" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <!-- ============ DERRIÈRE CE CAFÉ ============ -->
    <section class="prod" data-reveal aria-labelledby="h-prod">
      <figure class="media prod__media bleed-mobile">
        <Photo name={product.farm.photo} lang={lang} sizes="(min-width: 900px) 54vw, 100vw" />
      </figure>
      <div class="prod__text">
        <span class="label">{t.product.producerTitle}</span>
        <h2 class="prod__name" id="h-prod">{product.farm.name}</h2>
        <p class="small muted prod__place">{product.farm.place[lang]}</p>
        <p class="prod__body">{accroche}</p>
      </div>
    </section>

    <!-- ============ LE CAFÉ, ET COMMENT LE FAIRE ============ -->
    <section class="carte bleed-mobile" id="about" data-reveal>
      <div class="carte__inner">
        <div class="carte__bloc">
          <h2 class="carte__titre">{t.product.aboutTitle}</h2>
          <p>{product.description[lang]}</p>
          <p class="carte__second">{product.story[lang]}</p>
        </div>
        <div class="carte__bloc">
          <h2 class="carte__titre">{t.product.brewTitle}</h2>
          <p>{product.brew[lang]}</p>
          <dl class="carte__reperes">
            {
              detailRows.map((row) => (
                <div>
                  <Icon name={row.icon} size={20} class="carte__icone" />
                  <div>
                    <dt class="label">{row.label}</dt>
                    <dd>{row.value}</dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <!-- ============ TIROIRS ============ -->
    <section class="tiroirs" data-reveal aria-labelledby="h-tiroirs">
      <h2 class="label" id="h-tiroirs">{t.product.drawersTitle}</h2>

      <details class="tiroir" name="pdp">
        <summary>
          <span>{t.product.specsDrawer}</span>
          <span class="tiroir__signe" aria-hidden="true" />
        </summary>
        <div class="tiroir__corps">
          <dl class="fiche">
            {
              specRows.map((row) => (
                <div class="fiche__ligne">
                  <dt class="label">{row.label}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </details>

      <details class="tiroir" name="pdp">
        <summary>
          <span>{t.product.farmDrawer}</span>
          <span class="tiroir__signe" aria-hidden="true" />
        </summary>
        <div class="tiroir__corps">
          <figure class="media tiroir__media bleed-mobile">
            <Photo name={product.ambiance} lang={lang} sizes="(min-width: 900px) 46vw, 100vw" />
          </figure>
          {
            product.farm.text[lang].split('\n').map((paragraphe) => (
              <p class="muted tiroir__para">{paragraphe}</p>
            ))
          }
        </div>
      </details>

      {
        product.includes && (
          <details class="tiroir" name="pdp">
            <summary>
              <span>{t.product.includesDrawer}</span>
              <span class="tiroir__signe" aria-hidden="true" />
            </summary>
            <div class="tiroir__corps">
              <ul class="includes">
                {product.includes.map((item) => (
                  <li>{item[lang]}</li>
                ))}
              </ul>
            </div>
          </details>
        )
      }
    </section>

    {
      related.length > 0 && (
        <section class="related" aria-labelledby="h-related">
          <h2 class="label" id="h-related">
            {t.product.relatedTitle}
          </h2>
          <div class="related__grid">
            {related.map((item, i) => item && <ProductCard product={item} lang={lang} index={i} />)}
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .page-top {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: var(--section);
  }

  .pdp {
    display: grid;
    gap: clamp(1.75rem, 4vw, 4rem);
    margin-top: clamp(1.25rem, 3vw, 2.25rem);
  }

  @media (min-width: 900px) {
    .pdp {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: start;
    }

    .pdp__visual {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }

  .pdp__media {
    background: none;
  }

  .pdp__title {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem);
    color: var(--accent);
    letter-spacing: -0.015em;
  }

  .pdp__sub {
    margin-top: 0.35rem;
    font-size: var(--fs-small);
  }

  .pdp__price {
    margin-top: 0.9rem;
    font-size: 1.125rem;
  }

  .pdp__short {
    margin-top: 0.9rem;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
    font-size: var(--fs-lead);
    line-height: 1.4;
    letter-spacing: -0.01em;
    max-width: 30ch;
  }

  .specs {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--line-soft);
    display: grid;
    gap: 0.9rem;
  }

  .specs__row dd {
    margin: 0.2rem 0 0;
    font-size: var(--fs-small);
  }

  /* ---------- Derrière ce café ---------- */
  .prod {
    margin-top: clamp(3rem, 7vw, 5rem);
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .prod {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  .prod__media {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 900px) {
    .prod__media {
      aspect-ratio: 3 / 2;
    }
  }

  .prod__name {
    margin-top: 0.6rem;
    font-size: var(--fs-h3);
    font-weight: var(--w-bold);
  }

  .prod__place {
    margin-top: 0.2rem;
  }

  .prod__body {
    margin-top: 1rem;
    max-width: 44ch;
  }

  /* ---------- Le café, et comment le faire ---------- */
  /* Le fond appuyé détache ces deux blocs du reste de la page : c'est là
     que se joue la décision d'achat, une fois le prix passé. */
  .carte {
    margin-top: clamp(3rem, 7vw, 5rem);
    background: var(--paper-3);
  }

  .carte__inner {
    padding: clamp(1.75rem, 5vw, 3.5rem);
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  @media (min-width: 900px) {
    .carte__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .carte__bloc {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    max-width: 52ch;
  }

  .carte__titre {
    font-size: var(--fs-h3);
    font-weight: var(--w-bold);
    margin-bottom: 0.3rem;
  }

  .carte__second {
    color: var(--ink-70);
  }

  .carte__reperes {
    margin-top: 0.75rem;
    display: grid;
    gap: 1rem;
  }

  .carte__reperes > div {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .carte__reperes :global(.carte__icone) {
    flex: none;
    margin-top: 0.15rem;
    color: var(--ink-50);
  }

  .carte__reperes dd {
    margin: 0.15rem 0 0;
  }

  /* ---------- Tiroirs ---------- */
  .tiroirs {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .tiroir {
    border-bottom: 1px solid var(--line);
  }

  .tiroir:first-of-type {
    border-top: 1px solid var(--line);
    margin-top: 1.25rem;
  }

  .tiroir summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: clamp(1.1rem, 2.5vw, 1.5rem);
    cursor: pointer;
    list-style: none;
    font-size: var(--fs-lead);
    font-weight: var(--w-medium);
    letter-spacing: -0.01em;
    transition: color 0.35s var(--ease);
  }

  .tiroir summary::-webkit-details-marker {
    display: none;
  }

  .tiroir summary:hover {
    color: var(--accent);
  }

  /* Une croix qui devient un trait : le signe dit l'état du tiroir. */
  .tiroir__signe {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }

  .tiroir__signe::before,
  .tiroir__signe::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 0.45s var(--ease-out-expo);
  }

  .tiroir__signe::after {
    transform: rotate(90deg);
  }

  .tiroir[open] .tiroir__signe::after {
    transform: rotate(0deg);
  }

  .tiroir__corps {
    padding-bottom: clamp(1.5rem, 3.5vw, 2.25rem);
    display: grid;
    gap: 1rem;
    max-width: 68ch;
  }

  .tiroir__media {
    aspect-ratio: 3 / 2;
    margin-bottom: 0.5rem;
  }

  .tiroir__para {
    margin: 0;
  }

  .fiche {
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 640px) {
    .fiche {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.1rem 2rem;
    }
  }

  .fiche__ligne dd {
    margin: 0.2rem 0 0;
  }

  .includes {
    display: grid;
    gap: 0.5rem;
  }

  .includes li {
    padding-left: 1.1rem;
    position: relative;
    color: var(--ink-70);
  }

  .includes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* ---------- Vous aimerez aussi ---------- */
  .related {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  /* Deux colonnes, à toutes les largeurs. */
  .related__grid {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.75rem);
  }

  /* En paire, chaque visuel garde sa gouttière. */
  .related__grid :global(.bleed-mobile) {
    margin-inline: 0;
    width: 100%;
  }

</style>
