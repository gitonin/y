---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCard from '../../../components/ProductCard.astro';
import SplitTitle from '../../../components/SplitTitle.astro';
import ProBand from '../../../components/ProBand.astro';
import ClosingBand from '../../../components/ClosingBand.astro';
import { langPaths } from '../../../i18n/paths';
import { useTranslations, url, route, absolute, type Lang } from '../../../i18n/utils';
import { products } from '../../../data/products';
import { SITE } from '../../../consts';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const base = Astro.site ?? new URL('https://yunma.fr');

const filters = [
  { key: 'all', label: t.cafes.filterAll },
  { key: 'grain', label: t.cafes.filterGrains },
  { key: 'drip', label: t.cafes.filterDrip },
  { key: 'set', label: t.cafes.filterSets },
];

const jsonld = [
  {
    '@type': 'CollectionPage',
    '@id': new URL(Astro.url.pathname, base).href,
    name: t.cafes.seoTitle,
    description: t.cafes.seoDescription,
    inLanguage: t.meta.hreflang,
    isPartOf: { '@id': `${base.origin}/#website` },
  },
  {
    '@type': 'ItemList',
    name: t.cafes.title,
    numberOfItems: products.length,
    itemListElement: products.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absolute(Astro.site, `${lang}/cafes/${p.slug}/`),
      name: p.name[lang],
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.common.home, item: absolute(Astro.site, `${lang}/`) },
      { '@type': 'ListItem', position: 2, name: t.nav.cafes, item: absolute(Astro.site, `${lang}/cafes/`) },
    ],
  },
];
---

<Base lang={lang} title={t.cafes.seoTitle} description={t.cafes.seoDescription} jsonld={jsonld}>
  <div class="wrap page-top">
    <Breadcrumbs lang={lang} items={[{ href: url(lang), label: t.common.home }, { label: t.nav.cafes }]} />

    <header class="chead">
      <span class="label" data-reveal>{t.cafes.label}</span>
      <SplitTitle text={t.cafes.title} as="h1" size="xl" class="chead__title" />
      <p class="lead muted chead__intro" data-reveal>{t.cafes.intro}</p>
    </header>

    <div class="barre" data-reveal>
      <div class="filters" role="group" aria-label={t.cafes.filterAll}>
        {
          filters.map((f) => (
            <button type="button" class="filters__btn" data-filter={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>
              {f.label}
            </button>
          ))
        }
      </div>

      {/* Bascule d'affichage — utile là où la grille est la plus étroite. */}
      <div class="vue" role="group" aria-label={t.cafes.viewLabel}>
        <button type="button" class="vue__btn" data-cols="1" aria-pressed="true" title={t.cafes.viewOne}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <rect x="4.5" y="4.5" width="15" height="15" />
          </svg>
          <span class="visually-hidden">{t.cafes.viewOne}</span>
        </button>
        <button type="button" class="vue__btn" data-cols="2" aria-pressed="false" title={t.cafes.viewTwo}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <rect x="4.5" y="4.5" width="6" height="15" />
            <rect x="13.5" y="4.5" width="6" height="15" />
          </svg>
          <span class="visually-hidden">{t.cafes.viewTwo}</span>
        </button>
      </div>
    </div>

    <div class="clist" data-product-list data-colonnes="1">
      {
        products.map((product, i) => (
          <div data-category={product.category}>
            <ProductCard product={product} lang={lang} index={i} />
          </div>
        ))
      }
    </div>

    <p class="clist__empty muted" data-list-empty hidden>{t.cafes.empty}</p>

    <aside class="help panel panel--soft" data-reveal>
      <div>
        <h2 class="help__title">{t.cafes.helpTitle}</h2>
        <p class="muted help__text">{t.cafes.helpText}</p>
      </div>
      <a class="link" href={route(lang, 'contact')}>
        {t.common.contactUs}<span class="arrow" aria-hidden="true">→</span>
      </a>
    </aside>
  </div>

  <!-- ============ PUSH ORIGINE ============ -->
  <ClosingBand lang={lang} />

  <!-- ============ PUSH PRO ============ -->
  <ProBand lang={lang} />
</Base>

<style>
  .page-top {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: var(--section);
  }

  .chead {
    margin-block: clamp(1.5rem, 4vw, 2.5rem) clamp(2rem, 5vw, 3rem);
  }

  :global(.chead__title) {
    margin-top: 0.75rem;
    max-width: 14ch;
  }

  .chead__intro {
    margin-top: 1.25rem;
    max-width: 46ch;
  }

  .barre {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .vue {
    display: flex;
    flex: none;
    gap: 0.35rem;
  }

  /* Au-delà de deux colonnes, la bascule n'a plus d'objet. */
  @media (min-width: 900px) {
    .vue {
      display: none;
    }
  }

  .vue__btn {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    color: var(--ink-30);
    transition:
      color 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  .vue__btn svg {
    width: 18px;
    height: 18px;
  }

  .vue__btn[aria-pressed='true'] {
    color: var(--ink);
    border-color: var(--ink-30);
  }

  .filters__btn {
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--line);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-50);
    transition:
      color 0.35s var(--ease),
      border-color 0.35s var(--ease),
      background-color 0.35s var(--ease);
  }

  .filters__btn:hover {
    color: var(--ink);
    border-color: var(--ink-30);
  }

  .filters__btn[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  /* Une colonne au départ, comme demandé : le visuel occupe alors toute la
     largeur de l'écran. La bascule fait passer à deux. */
  .clist {
    display: grid;
    grid-template-columns: repeat(var(--colonnes, 1), minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1rem, 2.5vw, 2rem);
  }

  .clist[data-colonnes='2'] {
    --colonnes: 2;
  }

  /* Sur deux colonnes, chaque visuel reprend sa gouttière : sans quoi les
     deux colonnes se toucheraient. */
  .clist[data-colonnes='2'] :global(.bleed-mobile) {
    margin-inline: 0;
    width: 100%;
  }

  @media (min-width: 700px) {
    .clist,
    .clist[data-colonnes='2'] {
      --colonnes: 2;
    }
  }

  @media (min-width: 900px) {
    .clist,
    .clist[data-colonnes='2'] {
      --colonnes: 3;
    }
  }

  .clist > [hidden] {
    display: none;
  }

  .clist__empty {
    padding-block: 3rem;
    text-align: center;
  }

  .help {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .help {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2rem;
    }
  }

  .help__title {
    font-size: var(--fs-h3);
  }

  .help__text {
    margin-top: 0.5rem;
    max-width: 52ch;
  }
</style>

<script>
  const initFilters = () => {
    const list = document.querySelector<HTMLElement>('[data-product-list]');
    if (!list || list.dataset.bound) return;
    list.dataset.bound = '1';

    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = list.querySelectorAll<HTMLElement>('[data-category]');
    const empty = document.querySelector<HTMLElement>('[data-list-empty]');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.filter!;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let visible = 0;
        items.forEach((item, i) => {
          const match = key === 'all' || item.dataset.category === key;
          item.hidden = !match;
          if (match) {
            visible += 1;
            const card = item.firstElementChild as HTMLElement | null;
            if (card) {
              card.style.setProperty('--reveal-delay', `${(i % 3) * 60}ms`);
              card.classList.remove('is-visible');
              requestAnimationFrame(() => requestAnimationFrame(() => card.classList.add('is-visible')));
            }
          }
        });
        if (empty) empty.hidden = visible > 0;
      });
    });
  };

  /**
   * Choix d'affichage — une ou deux colonnes. Le réglage tient dans le
   * navigateur du visiteur : il retrouve sa grille d'une visite à l'autre.
   * Un stockage indisponible (navigation privée, site bloqué) ne doit pas
   * empêcher la bascule de fonctionner, d'où les gardes.
   */
  const CLE = 'yunma:colonnes';

  const lire = () => {
    try {
      return localStorage.getItem(CLE);
    } catch {
      return null;
    }
  };

  const initColonnes = () => {
    const liste = document.querySelector<HTMLElement>('[data-product-list]');
    const boutons = document.querySelectorAll<HTMLButtonElement>('[data-cols]');
    if (!liste || !boutons.length) return;

    const appliquer = (valeur: string) => {
      liste.dataset.colonnes = valeur;
      boutons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cols === valeur)));
    };

    const memorise = lire();
    if (memorise === '1' || memorise === '2') appliquer(memorise);

    if (liste.dataset.boundCols) return;
    liste.dataset.boundCols = '1';

    boutons.forEach((b) =>
      b.addEventListener('click', () => {
        const valeur = b.dataset.cols!;
        appliquer(valeur);
        try {
          localStorage.setItem(CLE, valeur);
        } catch {
          /* le choix vaudra pour cette page seulement */
        }
      }),
    );
  };

  document.addEventListener('astro:page-load', initFilters);
  document.addEventListener('astro:page-load', initColonnes);
  initColonnes();
</script>
