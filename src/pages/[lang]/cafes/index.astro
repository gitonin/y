---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import SplitTitle from '../../../components/SplitTitle.astro';
import ProBand from '../../../components/ProBand.astro';
import ClosingBand from '../../../components/ClosingBand.astro';
import { langPaths } from '../../../i18n/paths';
import { useTranslations, route, absolute, type Lang } from '../../../i18n/utils';
import { products } from '../../../data/products';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const base = Astro.site ?? new URL('https://yunma.fr');

/**
 * L'ordre de la vitrine, qui n'est pas celui du fichier de contenu : il sert le
 * rythme de la page. Une référence seule ouvre, deux se partagent la ligne
 * suivante, et la figure se répète — les deux cafés en grains encadrés par leur
 * aîné, puis le coffret seul avant les deux boîtes de sachets.
 *
 * Une référence absente de cette liste vient à la suite, plutôt que de
 * disparaître : ajouter un café au catalogue ne doit pas demander de penser à
 * ce tableau.
 */
const ORDRE = [
  'yun-lan-estate',
  'torch-estate-lot-01',
  'torch-estate-lot-02',
  'coffret-decouverte',
  'drip-bags-catimor',
  'drip-bags-bourbon-jaune',
];
const rang = (slug: string) => {
  const i = ORDRE.indexOf(slug);
  return i === -1 ? ORDRE.length : i;
};
const vitrine = [...products].sort((a, b) => rang(a.slug) - rang(b.slug));

const filters = [
  { key: 'all', label: t.cafes.filterAll },
  { key: 'grain', label: t.cafes.filterGrains },
  { key: 'drip', label: t.cafes.filterDrip },
  { key: 'set', label: t.cafes.filterSets },
];

const jsonld = [
  {
    '@type': 'CollectionPage',
    '@id': new URL(Astro.url.pathname, base).href,
    name: t.cafes.seoTitle,
    description: t.cafes.seoDescription,
    inLanguage: t.meta.hreflang,
    isPartOf: { '@id': `${base.origin}/#website` },
  },
  {
    '@type': 'ItemList',
    name: t.cafes.title,
    numberOfItems: vitrine.length,
    itemListElement: vitrine.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absolute(Astro.site, `${lang}/cafes/${p.slug}/`),
      name: p.name[lang],
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.common.home, item: absolute(Astro.site, `${lang}/`) },
      { '@type': 'ListItem', position: 2, name: t.nav.cafes, item: absolute(Astro.site, `${lang}/cafes/`) },
    ],
  },
];
---

<Base lang={lang} title={t.cafes.seoTitle} description={t.cafes.seoDescription} jsonld={jsonld}>
  <div class="wrap page-top">
    <header class="chead">
      <span class="label" data-reveal>{t.cafes.label}</span>
      <SplitTitle text={t.cafes.title} as="h1" size="xl" class="sec-title chead__title" />
      <p class="lead muted chead__intro" data-reveal>{t.cafes.intro}</p>
    </header>

    <div class="filters" role="group" aria-label={t.cafes.filterAll} data-reveal>
      {
        filters.map((f) => (
          <button type="button" class="filters__btn" data-filter={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>
            {f.label}
          </button>
        ))
      }
    </div>

    <div class="clist" data-product-list>
      {
        vitrine.map((product, i) => (
          <div data-category={product.category}>
            <ProductCard product={product} lang={lang} index={i} />
          </div>
        ))
      }
    </div>

    <p class="clist__empty muted" data-list-empty hidden>{t.cafes.empty}</p>

    <aside class="help panel panel--soft" data-reveal>
      <div>
        <h2 class="help__title">{t.cafes.helpTitle}</h2>
        <p class="muted help__text">{t.cafes.helpText}</p>
      </div>
      <a class="link" href={route(lang, 'contact')}>
        {t.common.contactUs}<span class="arrow" aria-hidden="true">→</span>
      </a>
    </aside>
  </div>

  <!-- ============ PRO ============ -->
  <ProBand lang={lang} />

  <!-- ============ IMAGE DE FIN ============ -->
  <ClosingBand lang={lang} />
</Base>

<style>
  .page-top {
    padding-bottom: var(--section);
  }

  .chead {
    margin-block: clamp(1.5rem, 4vw, 2.5rem) clamp(2rem, 5vw, 3rem);
  }

  :global(.chead__title) {
    max-width: 14ch;
  }

  .chead__intro {
    max-width: 46ch;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* Sur un écran étroit, les quatre filtres passent avant le catalogue : ils
     s'effacent donc de deux points et se resserrent, pour annoncer sans
     occuper. Ils retrouvent leur taille dès qu'il y a de la place. */
  .filters__btn {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line);
    font-size: 0.5625rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-50);
    transition:
      color 0.35s var(--ease),
      border-color 0.35s var(--ease),
      background-color 0.35s var(--ease);
  }

  @media (min-width: 600px) {
    .filters__btn {
      padding: 0.55rem 1.1rem;
      font-size: var(--fs-label);
    }
  }

  .filters__btn:hover {
    color: var(--ink);
    border-color: var(--ink-30);
  }

  /* Le filtre actif porte l'orange foncé de la marque. C'est bien le cran
     sombre : sur le clair, l'orange vif ne donne que 3,6 de contraste avec le
     papier, sous le seuil d'un texte de cette taille ; le foncé en donne 4,9. */
  .filters__btn[aria-pressed='true'] {
    background: var(--accent-deep);
    border-color: var(--accent-deep);
    color: var(--paper);
  }

  .clist {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1rem, 2.5vw, 2rem);
  }

  /* Le rythme de la page : une carte prend toute la largeur, les deux suivantes
     se partagent la ligne, et ainsi de suite. C'est la figure de l'accueil,
     répétée. :global() est nécessaire — la carte vient d'un composant et ne
     porte pas la portée de cette page.

     Le compte porte sur toutes les cartes, y compris celles qu'un filtre
     masque. C'est voulu : avec l'ordre ci-dessus, chaque filtre retombe sur une
     mise en page juste — les trois cafés en grains gardent leur aîné en tête,
     le coffret reste seul et pleine largeur, les deux boîtes se partagent
     la ligne. */
  .clist > :nth-child(3n + 1) {
    grid-column: 1 / -1;
  }

  /* Sur grand écran, un carré pleine largeur ferait plus d'un écran de haut
     pour un seul sachet. Le carré reste, mais le texte vient se poser à côté. */
  @media (min-width: 900px) {
    .clist > :nth-child(3n + 1) :global(.pcard__link) {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 4vw, 4rem);
      align-items: center;
    }

    .clist > :nth-child(3n + 1) :global(.pcard__body) {
      padding-top: 0;
    }
  }

  .clist > [hidden] {
    display: none;
  }

  .clist__empty {
    padding-block: 3rem;
    text-align: center;
  }

  .help {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .help {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2rem;
    }
  }

  .help__title {
    font-size: var(--fs-h3);
  }

  .help__text {
    margin-top: 0.5rem;
    max-width: 52ch;
  }
</style>

<script>
  const initFilters = () => {
    const list = document.querySelector<HTMLElement>('[data-product-list]');
    if (!list || list.dataset.bound) return;
    list.dataset.bound = '1';

    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = list.querySelectorAll<HTMLElement>('[data-category]');
    const empty = document.querySelector<HTMLElement>('[data-list-empty]');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.filter!;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let visible = 0;
        items.forEach((item, i) => {
          const match = key === 'all' || item.dataset.category === key;
          item.hidden = !match;
          if (match) {
            visible += 1;
            const card = item.firstElementChild as HTMLElement | null;
            if (card) {
              card.style.setProperty('--reveal-delay', `${(i % 3) * 60}ms`);
              card.classList.remove('is-visible');
              requestAnimationFrame(() => requestAnimationFrame(() => card.classList.add('is-visible')));
            }
          }
        });
        if (empty) empty.hidden = visible > 0;
      });
    });
  };

  document.addEventListener('astro:page-load', initFilters);
</script>
