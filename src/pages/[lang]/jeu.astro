---
/**
 * Le jeu du cheval des nuages — un quiz à deux ou quatre joueurs.
 *
 * Chacun sur son téléphone, tous dans la même partie. La page tient les six
 * écrans (accueil, salon, question, révélation, podium) et n'en montre qu'un :
 * les fabriquer en JavaScript ferait vivre les textes à deux endroits, dans
 * trois langues.
 *
 * Le serveur est `public/jeu/api.php`, interrogé une fois par seconde. Rien
 * ici ne fonctionne sans lui — ce qui exclut l'aperçu GitHub Pages, qui ne
 * sert que des fichiers.
 *
 * Chaque joueur lit la partie dans sa langue : le serveur renvoie les trois,
 * et la page affiche la sienne. Pour une marque franco-yunnanaise, ce n'est
 * pas un détail.
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Poincon from '../../components/Poincon.astro';
import { langPaths } from '../../i18n/paths';
import { useTranslations, route, asset, type Lang } from '../../i18n/utils';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const j = t.jeu;
---

<Base lang={lang} title={j.titre} description={j.seo} noindex>
  <div class="wrap jeu" data-jeu data-api={asset('jeu/api.php')} data-langue={lang}>
    <!-- ----------------------------------------------------- accueil -->
    <section class="jeu__ecran" data-ecran="accueil">
      <Poincon tight />
      <h1 class="jeu__titre">{j.titre}</h1>
      <p class="jeu__intro lead">{j.intro}</p>

      <button class="btn jeu__principal" type="button" data-creer>{j.creer}</button>

      <p class="label jeu__ou">{j.ouRejoindre}</p>
      <form class="jeu__code" data-form-code>
        <input
          name="code"
          type="text"
          inputmode="text"
          autocomplete="off"
          autocapitalize="characters"
          maxlength="4"
          placeholder={j.codePlaceholder}
          aria-label={j.codeDeLaPartie}
        />
        <button class="btn btn--ligne" type="submit">{j.entrer}</button>
      </form>
    </section>

    <!-- -------------------------------------------------------- nom -->
    <section class="jeu__ecran" data-ecran="nom" hidden>
      <Poincon tight />
      <h1 class="jeu__titre">{j.salonTitre}</h1>
      <p class="jeu__code-rappel mono-num" data-code-rappel></p>
      <form class="jeu__nom" data-form-nom>
        <label class="label" for="jeu-nom">{j.nomLabel}</label>
        <input id="jeu-nom" name="nom" type="text" maxlength="16" autocomplete="given-name" placeholder={j.nomPlaceholder} required />
        <button class="btn" type="submit">{j.rejoindre}</button>
      </form>
    </section>

    <!-- ------------------------------------------------------ salon -->
    <section class="jeu__ecran" data-ecran="salon" hidden>
      <Poincon tight />
      <p class="label">{j.codeDeLaPartie}</p>
      <p class="jeu__grand-code mono-num" data-code></p>

      <div class="jeu__qr" data-qr hidden>
        <div data-qr-image></div>
        <p class="small muted">{j.scannez}</p>
      </div>

      <button class="btn btn--ligne jeu__copier" type="button" data-copier hidden>{j.copier}</button>

      <p class="label jeu__sous-titre">{j.joueurs}</p>
      <ul class="jeu__joueurs" data-joueurs></ul>

      <button class="btn jeu__principal" type="button" data-lancer hidden>{j.lancer}</button>
      <p class="small muted" data-attente>{j.attenteHote}</p>
    </section>

    <!-- --------------------------------------------------- question -->
    <section class="jeu__ecran" data-ecran="question" hidden>
      <header class="jeu__tete">
        <p class="label" data-compteur></p>
        <p class="jeu__chrono mono-num" data-chrono></p>
      </header>
      <div class="jeu__jauge"><span data-jauge></span></div>

      <h2 class="jeu__enonce" data-enonce></h2>
      <div class="jeu__reponses" data-reponses></div>
      <p class="small muted jeu__attente-rep" data-attente-reponses></p>
    </section>

    <!-- ------------------------------------------------- révélation -->
    <section class="jeu__ecran" data-ecran="revelation" hidden>
      <p class="label" data-verdict></p>
      <h2 class="jeu__enonce jeu__enonce--petit" data-enonce-rev></h2>
      <p class="jeu__bonne" data-bonne></p>
      <p class="jeu__explication muted" data-explication></p>

      <p class="label jeu__sous-titre">{j.classement}</p>
      <ul class="jeu__joueurs" data-classement></ul>

      <button class="btn jeu__principal" type="button" data-suivante hidden></button>
      <p class="small muted" data-attente-hote>{j.attenteHote}</p>
    </section>

    <!-- -------------------------------------------------------- fin -->
    <section class="jeu__ecran" data-ecran="fin" hidden>
      <Poincon tight />
      <h1 class="jeu__titre">{j.finTitre}</h1>
      <p class="jeu__niveau" data-niveau></p>
      <ul class="jeu__podium" data-podium></ul>
      <button class="btn jeu__principal" type="button" data-rejouer>{j.rejouer}</button>
      <a class="link" href={route(lang, 'cafes')}>{j.retourBoutique}<span class="arrow" aria-hidden="true">→</span></a>
    </section>

    <p class="jeu__erreur small" data-erreur hidden></p>
  </div>

  <script type="application/json" data-jeu-textes set:html={JSON.stringify(j)} is:inline />
</Base>

<style>
  .jeu {
    max-width: 34rem;
    padding-top: clamp(1.5rem, 5vw, 3rem);
    padding-bottom: var(--section);
  }

  .jeu__ecran {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }

  .jeu__ecran[hidden] {
    display: none;
  }

  .jeu__titre {
    font-size: var(--fs-h2);
    font-family: var(--font-titre);
    font-weight: var(--w-semi);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .jeu__intro {
    max-width: 30ch;
  }

  .jeu__principal,
  .jeu__code,
  .jeu__nom {
    width: 100%;
  }

  .jeu__ou {
    margin-top: 0.75rem;
    color: var(--ink-50);
  }

  .jeu__code {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
  }

  .jeu__nom {
    display: grid;
    gap: 0.5rem;
  }

  .jeu input[type='text'] {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
    font: inherit;
  }

  .jeu__code input {
    font-family: var(--font-sans);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-align: center;
  }

  .jeu input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /* Le code se lit à voix haute d'un bout à l'autre de la pièce. */
  .jeu__grand-code {
    font-size: clamp(3rem, 18vw, 5rem);
    line-height: 1;
    letter-spacing: 0.12em;
    font-weight: var(--w-semi);
  }

  .jeu__code-rappel {
    font-size: 1.5rem;
    letter-spacing: 0.2em;
    color: var(--ink-50);
  }

  .jeu__qr {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    padding: 0.9rem;
    background: var(--white);
    border: 1px solid var(--line);
  }

  .jeu__qr :global(svg) {
    width: 10.5rem;
    height: 10.5rem;
    display: block;
  }

  .jeu__sous-titre {
    margin-top: 0.75rem;
    color: var(--ink-50);
  }

  .jeu__joueurs,
  .jeu__podium {
    width: 100%;
    display: grid;
    gap: 0.4rem;
  }

  /* Les lignes de joueurs et les boutons de réponse sont fabriqués par le
     script : Astro ne leur pose pas sa marque de portée, et une règle écrite
     normalement ici ne les atteindrait jamais. D'où `:global`, maintenu sous
     `.jeu` pour ne rien laisser fuir dans le reste du site. */
  .jeu :global(.jeu__joueur) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--line);
    background: var(--paper-5);
  }

  /* Quatre joueurs, quatre teintes de la charte — il n'en existe pas une
     cinquième, et c'est aussi pourquoi la partie s'arrête à quatre. */
  .jeu :global(.jeu__pastille) {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--teinte);
  }

  .jeu :global(.jeu__joueur--vous) {
    border-color: var(--ink-30);
  }

  .jeu :global(.jeu__vous) {
    color: var(--ink-50);
    font-size: var(--fs-small);
  }

  .jeu :global(.jeu__score) {
    font-variant-numeric: tabular-nums;
  }

  .jeu__tete {
    width: 100%;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  /* Le chronomètre tend sans crier : des chiffres qui se vident, et un filet
     qui se rétracte. Pas de rouge — la charte n'en a pas. */
  .jeu__chrono {
    font-size: 1.5rem;
    font-weight: var(--w-semi);
  }

  .jeu__jauge {
    width: 100%;
    height: 2px;
    background: var(--line);
  }

  .jeu__jauge span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--accent);
    transform-origin: left;
    transition: transform 0.95s linear;
  }

  .jeu__enonce {
    font-size: var(--fs-h3);
    font-family: var(--font-titre);
    font-weight: var(--w-semi);
    letter-spacing: -0.014em;
    line-height: 1.25;
  }

  .jeu__enonce--petit {
    font-size: 1.0625rem;
    color: var(--ink-70);
  }

  .jeu__reponses {
    width: 100%;
    display: grid;
    gap: 0.5rem;
  }

  .jeu :global(.jeu__reponse) {
    width: 100%;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
    font: inherit;
    text-align: left;
    line-height: 1.4;
    transition: border-color 0.25s var(--ease), background-color 0.25s var(--ease);
  }

  .jeu :global(.jeu__reponse:hover:not(:disabled)) {
    border-color: var(--ink-30);
  }

  .jeu :global(.jeu__reponse[aria-pressed='true']) {
    border-color: var(--accent);
    background: var(--paper-5);
  }

  .jeu :global(.jeu__reponse:disabled) {
    cursor: default;
  }

  .jeu :global(.jeu__reponse--choisie) {
    border-color: var(--accent);
  }

  /* Juste et faux sans vert ni rouge : l'un s'affirme, l'autre s'éteint. */
  .jeu__bonne {
    font-family: var(--font-titre);
    font-weight: var(--w-semi);
    font-size: 1.125rem;
    color: var(--accent-deep);
  }

  .jeu__explication {
    line-height: 1.6;
  }

  [data-verdict] {
    color: var(--accent-deep);
  }

  [data-verdict].est-faux {
    color: var(--ink-30);
  }

  .jeu__attente-rep {
    min-height: 1.2em;
  }

  .jeu__niveau {
    font-family: var(--font-titre);
    font-weight: var(--w-semi);
    font-size: var(--fs-h3);
    color: var(--accent-deep);
  }

  .jeu :global(.jeu__podium .jeu__joueur:first-child) {
    border-color: var(--accent);
  }

  .jeu__erreur {
    margin-top: 1.5rem;
    color: var(--accent-deep);
  }
</style>

<script>
  import { lancerJeu } from '../../scripts/jeu';
  document.addEventListener('astro:page-load', lancerJeu);
</script>
