---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import SplitTitle from '../../components/SplitTitle.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';
import { langPaths } from '../../i18n/paths';
import { useTranslations, route, absolute, type Lang } from '../../i18n/utils';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const base = Astro.site ?? new URL('https://yunma.fr');

/* Dans l'ordre des engagements du dictionnaire. */
const valueIcons: IconName[] = ['leaf', 'community', 'sprout'];

const jsonld = [
  {
    '@type': 'AboutPage',
    '@id': new URL(Astro.url.pathname, base).href,
    name: t.apropos.seoTitle,
    description: t.apropos.seoDescription,
    inLanguage: t.meta.hreflang,
    mainEntity: { '@id': `${base.origin}/#organization` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.common.home, item: absolute(Astro.site, `${lang}/`) },
      { '@type': 'ListItem', position: 2, name: t.nav.apropos, item: absolute(Astro.site, `${lang}/a-propos/`) },
    ],
  },
];
---

<Base lang={lang} title={t.apropos.seoTitle} description={t.apropos.seoDescription} jsonld={jsonld}>
  <PageHero lang={lang} label={t.apropos.label} title={t.apropos.title} intro={t.apropos.intro} crumb={t.nav.apropos} />

  <div class="wrap">
    <figure class="media media--wide" data-reveal>
      <Photo name="recolte-cueilleurs" lang={lang} priority sizes="(min-width: 1560px) 1560px, 100vw" />
    </figure>
  </div>

  <section class="section">
    <div class="wrap grid grid--sidebar">
      <p class="lead" data-reveal>{t.apropos.storyText}</p>
      <div class="mission stack">
        <div data-reveal>
          <h2 class="mission__title">{t.apropos.missionTitle}</h2>
          <p class="muted">{t.apropos.missionText}</p>
        </div>
        <div data-reveal>
          <h2 class="mission__title">{t.apropos.approachTitle}</h2>
          <p class="muted">{t.apropos.approachText}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight panel">
    <div class="wrap">
      <h2 class="label" data-reveal>{t.apropos.valuesTitle}</h2>
      <ul class="values">
        {
          t.apropos.values.map((value, i) => (
            <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <Icon name={valueIcons[i]} size={28} class="values__icon" />
              <h3 class="values__title">{value.title}</h3>
              <p class="small muted">{value.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2 class="label" data-reveal>{t.apropos.figuresTitle}</h2>
      <dl class="figures">
        {
          t.apropos.figures.map((figure, i) => (
            <div data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <dt class="figures__value">{figure.value}</dt>
              <dd class="small muted">{figure.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="closing">
    <div class="closing__media media">
      <Photo name="cretes-brumeuses" lang={lang} decorative sizes="100vw" />
    </div>
    <div class="closing__inner wrap">
      <SplitTitle text={t.apropos.closing} as="p" size="closing" class="on-dark" />
      <a class="link closing__cta" href={route(lang, 'journal')}>
        {t.apropos.closingCta}<span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .mission {
    --stack: 2rem;
  }

  .mission__title {
    font-size: var(--fs-h3);
    margin-bottom: 0.65rem;
  }

  .mission p {
    max-width: 48ch;
  }

  .values {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  @media (min-width: 800px) {
    .values {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .values__icon {
    margin-bottom: 1.1rem;
    color: var(--accent);
  }

  .values__title {
    font-size: 1.0625rem;
    margin-bottom: 0.4rem;
  }

  .figures {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 700px) {
    .figures {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .figures > div {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .figures__value {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .figures dd {
    margin: 0;
    max-width: 22ch;
  }

  .closing {
    position: relative;
    min-height: 70svh;
    display: flex;
    align-items: flex-end;
    padding-block: clamp(3rem, 8vw, 6rem);
    overflow: hidden;
  }

  .closing__media {
    position: absolute;
    inset: 0;
  }

  .closing__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(33, 33, 33, 0) 24%, rgba(33, 33, 33, 0.28) 62%, rgba(33, 33, 33, 0.6) 100%);
  }

  .closing__inner {
    position: relative;
    z-index: 2;
    color: var(--white);
  }

  .closing__cta {
    margin-top: 1.25rem;
    color: var(--white);
  }
</style>
