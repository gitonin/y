---
/**
 * Ancienne page, désormais fondue dans « Origine ».
 * On garde l'adresse pour ne pas casser les liens déjà partagés.
 */
import type { GetStaticPaths } from 'astro';
import { langPaths } from '../../i18n/paths';
import { useTranslations, route, absolute, asset, type Lang } from '../../i18n/utils';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const cible = `${route(lang, 'origine')}#histoire`;
const canonique = absolute(Astro.site, `${lang}/origine/`);
---

<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.origine.seoTitle}</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonique} />
    <meta http-equiv="refresh" content={`0; url=${cible}`} />
    <link rel="icon" href={asset('brand/favicon-96.png')} type="image/png" sizes="96x96" />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #ebe7de;
        color: #212121;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 14px;
      }
      a {
        color: #b95f2c;
      }
    </style>
  </head>
  <body>
    <p><a href={cible}>{t.origine.title.split('\n').join(' ')}</a></p>
  </body>
</html>
