---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import SplitTitle from '../../components/SplitTitle.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/Icon.astro';
import { langPaths } from '../../i18n/paths';
import { useTranslations, absolute, type Lang } from '../../i18n/utils';
import { SITE } from '../../consts';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const base = Astro.site ?? new URL('https://yunma.fr');

/* Dans l'ordre des engagements du dictionnaire. */
const commitIcons: IconName[] = ['leaf', 'community', 'book'];

const jsonld = [
  {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, base).href,
    name: t.pro.seoTitle,
    description: t.pro.seoDescription,
    inLanguage: t.meta.hreflang,
    isPartOf: { '@id': `${base.origin}/#website` },
  },
  {
    '@type': 'Service',
    name: t.pro.offerTitle,
    provider: { '@id': `${base.origin}/#organization` },
    areaServed: ['FR', 'BE', 'LU', 'CH'],
    audience: { '@type': 'BusinessAudience', name: t.pro.forWhoText },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: t.pro.offerTitle,
      itemListElement: t.pro.offers.map((offer) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: offer.title, description: offer.text },
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.common.home, item: absolute(Astro.site, `${lang}/`) },
      { '@type': 'ListItem', position: 2, name: t.nav.pro, item: absolute(Astro.site, `${lang}/pro/`) },
    ],
  },
];
---

<Base
  lang={lang}
  title={t.pro.seoTitle}
  description={t.pro.seoDescription}
  jsonld={jsonld}
  fil={[{ label: t.nav.pro }]}
>
  <section class="phead">
    <div class="wrap phead__inner">
      <div class="phead__text">
        <span class="label" data-reveal>{t.pro.label}</span>
        <SplitTitle text={t.pro.title} as="h1" size="xl" class="sec-title phead__title" />
        <p class="lead muted phead__intro" data-reveal>{t.pro.intro}</p>
        <a class="link" href="#contact-pro" data-reveal>
          {t.pro.cta}<span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <figure class="media phead__media">
        <Photo name="main-plante" lang={lang} priority sizes="(min-width: 900px) 54vw, 100vw" />
      </figure>
    </div>
  </section>

  {/* Même olive que le bloc de contact qui referme la page : les deux blocs
      « pro » se répondent, au lieu d'un gris de plus. */}
  <section class="section section--tight panel--olive">
    <div class="wrap offers__wrap">
      <header class="offers__head">
        <h2 class="offers__title">{t.pro.offerTitle}</h2>
        <p class="muted" data-reveal>{t.pro.forWhoText}</p>
      </header>
      <ul class="offers">
        {
          t.pro.offers.map((offer, i) => (
            <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <h3 class="offers__name">{offer.title}</h3>
              <p class="small muted">{offer.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2 class="label" data-reveal>{t.pro.commitmentsTitle}</h2>
      <ul class="commits">
        {
          t.pro.commitments.map((item, i) => (
            <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <Icon name={commitIcons[i]} size={28} class="commits__icon" />
              <h3 class="commits__title">{item.title}</h3>
              <p class="small muted">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="pcontact panel--olive" id="contact-pro">
    <div class="wrap pcontact__inner">
      <div>
        <span class="label" data-reveal>{t.pro.contactTitle}</span>
        <p class="pcontact__title" data-reveal>{t.pro.contactText}</p>
        <p class="small pcontact__meta" data-reveal>{t.pro.formIntro}</p>
      </div>
      <ul class="pcontact__links" data-reveal>
        <li><a href={`mailto:${SITE.proEmail}`}>{SITE.proEmail}</a></li>
        <li>
          <a href={SITE.whatsapp} target="_blank" rel="noopener">{t.common.whatsapp}</a>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .phead {
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .phead__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .phead__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .phead__text {
    display: grid;
    justify-items: start;
  }

  .phead__intro {
    max-width: 34ch;
  }

  .phead__media {
    aspect-ratio: 3 / 4;
  }

  @media (min-width: 900px) {
    .phead__media {
      aspect-ratio: 4 / 3;
    }
  }

  .commits,
  .offers {
    margin-top: var(--espace-titre);
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  @media (min-width: 800px) {
    .commits,
    .offers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .commits__icon {
    margin-bottom: 1.1rem;
    color: var(--accent);
  }

  .commits__title,
  .offers__name {
    font-size: 1.0625rem;
    margin-top: var(--espace-carte);
    margin-bottom: var(--espace-carte);
  }

  .offers__head {
    display: grid;
    gap: var(--espace-titre);
    max-width: 46ch;
  }

  .offers__title {
    font-size: var(--fs-h2);
  }

  .pcontact {
    padding-block: clamp(3rem, 7vw, 5rem);
    scroll-margin-top: var(--header-h);
  }

  .pcontact__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  /* Les liens se calent sur le bas du texte de gauche, et non sur son haut :
     les deux colonnes se referment sur la même ligne. */
  @media (min-width: 860px) {
    .pcontact__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: end;
    }
  }

  .pcontact__title {
    margin-top: var(--espace-surtitre);
    font-size: var(--fs-h3);
    max-width: 22ch;
  }

  .pcontact__meta {
    margin-top: var(--espace-titre);
    color: rgba(251, 250, 247, 0.66);
  }

  .pcontact__links {
    display: grid;
    gap: 0.5rem;
    font-size: var(--fs-small);
  }

  .pcontact__links a {
    position: relative;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(251, 250, 247, 0.3);
    transition: border-color 0.4s var(--ease);
  }

  .pcontact__links a:hover {
    border-color: var(--white);
  }
</style>
