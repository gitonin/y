---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import SplitTitle from '../../components/SplitTitle.astro';
import ProBand from '../../components/ProBand.astro';
import ClosingBand from '../../components/ClosingBand.astro';
import ProductCard from '../../components/ProductCard.astro';
import { langPaths } from '../../i18n/paths';
import { useTranslations, route, url, postUrl, formatDate, absolute, asset, type Lang } from '../../i18n/utils';
import { products } from '../../data/products';
import { SITE } from '../../consts';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

/* L'accueil met une référence en avant, deux la suivent ; le reste de la
   gamme attend sur la page cafés, vers laquelle mène le lien de la section. */
const [enAvant, ...suivants] = products.slice(0, 3);

const posts = (await getCollection('journal'))
  .filter((p) => p.id.startsWith(`${lang}/`) && !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const base = Astro.site ?? new URL('https://yunma.fr');
const jsonld = [
  {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, base).href,
    url: new URL(Astro.url.pathname, base).href,
    name: t.home.seoTitle,
    description: t.home.seoDescription,
    inLanguage: t.meta.hreflang,
    isPartOf: { '@id': `${base.origin}/#website` },
    about: { '@id': `${base.origin}/#organization` },
  },
  {
    '@type': 'ItemList',
    name: t.cafes.title,
    itemListElement: products.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absolute(Astro.site, `${lang}/cafes/${p.slug}/`),
      name: p.name[lang],
    })),
  },
];
---

<Base
  lang={lang}
  title={t.home.seoTitle}
  description={t.home.seoDescription}
  transparentHeader
  jsonld={jsonld}
  keywords={[
    'café de spécialité',
    'Yunnan',
    'specialty coffee',
    'torréfacteur',
    'drip bag',
    'Baoshan',
    "Pu'er",
  ]}
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero__media media is-visible">
      <Photo name="cretes-brumeuses" lang={lang} priority sizes="100vw" decorative />
    </div>
    <div class="hero__inner wrap">
      {/* Le logo, en grand, ne paraît que sur l'accueil : il signe la page.
          Celui de la barre de navigation prend le relais au défilement. */}
      <a class="hero__logo" href={url(lang)} aria-label={t.a11y.logo} data-logo-accueil>
        <img src={asset('brand/yunma-logo.svg')} alt="Yunma" width="430" height="648" />
      </a>
      <SplitTitle text={t.home.heroTitle} as="h1" size="xl" class="hero__title" />
      {/* Le titre dans l'autre langue de la marque, sur une ligne. */}
      <p class="hero__alt" lang={lang === 'zh' ? 'fr' : 'zh'}>{t.home.heroTitleAlt}</p>
      <a class="hero__cta link" href={route(lang, 'cafes')}>
        {t.home.heroCta}<span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <span class="hero__scroll label" aria-hidden="true">{t.common.scroll}</span>
  </section>

  <!-- ============ ORIGINE ============ -->
  <section class="section" aria-labelledby="h-origine">
    <div class="wrap grid grid--sidebar">
      <div data-reveal>
        <span class="label">{t.home.originLabel}</span>
      </div>
      <div>
        <SplitTitle text={t.home.originTitle} as="h2" size="lg" class="sec-title" />
        <p class="lead muted origin__text" data-reveal id="h-origine">{t.home.originText}</p>
        <a class="link" href={route(lang, 'origine')} data-reveal>
          {t.home.originCta}<span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <figure class="bleed">
      <div class="media media--wide">
        <Photo name="recolte-cueilleurs" lang={lang} sizes="(min-width: 1560px) 1560px, 100vw" />
      </div>
    </figure>
  </section>

  <!-- ============ CAFÉS ============ -->
  <section class="section section--tight panel" aria-labelledby="h-cafes">
    <div class="wrap">
      <header class="shead">
        <div>
          <span class="label" data-reveal>{t.home.coffeesLabel}</span>
          <SplitTitle text={t.home.coffeesTitle} as="h2" size="lg" class="sec-title" />
        </div>
        <div class="shead__aside">
          <p class="muted" data-reveal id="h-cafes">{t.home.coffeesText}</p>
          <a class="link" href={route(lang, 'cafes')} data-reveal>
            {t.home.coffeesCta}<span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </header>

      <ProductCard product={enAvant} lang={lang} feature />

      <div class="pgrid">
        {suivants.map((product, i) => <ProductCard product={product} lang={lang} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ============ APPROCHE ============ -->
  <section class="section" aria-labelledby="h-approche">
    <div class="wrap approach">
      <div class="approach__text">
        <span class="label" data-reveal>{t.home.approachLabel}</span>
        <SplitTitle text={t.home.approachTitle} as="h2" size="lg" class="sec-title" />
        <p class="lead muted" data-reveal id="h-approche">{t.home.approachText}</p>
        <a class="link" href={`${route(lang, 'origine')}#savoir-faire`} data-reveal>
          {t.home.approachCta}<span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <figure class="approach__media">
        <div class="media media--tall">
          <Photo name="cerises-branche" lang={lang} position="60% 55%" sizes="(min-width: 860px) 52vw, 100vw" />
        </div>
      </figure>
    </div>
  </section>

  <!-- ============ JOURNAL ============ -->
  {
    posts.length > 0 && (
      <section class="section section--tight panel panel--soft" aria-labelledby="h-journal">
        <div class="wrap">
          <header class="shead">
            <div>
              <span class="label" data-reveal>{t.home.journalLabel}</span>
              <SplitTitle text={t.home.journalTitle} as="h2" size="md" />
            </div>
            <div class="shead__aside">
              <a class="link" href={route(lang, 'journal')} data-reveal id="h-journal">
                {t.journal.all}
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </div>
          </header>

          <ul class="jgrid">
            {posts.map((post, i) => (
              <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
                <a class="jcard media-link" href={postUrl(lang, post.id.split('/')[1])}>
                  <div class="media media--wide">
                    <Photo name={post.data.photo} lang={lang} decorative sizes="(min-width: 760px) 32vw, 100vw" />
                  </div>
                  <time class="label jcard__date" datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date, lang)}
                  </time>
                  <h3 class="jcard__title">{post.data.title}</h3>
                  <p class="small muted jcard__desc">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ============ PRO ============ -->
  <ProBand lang={lang} />

  <!-- ============ IMAGE DE FIN ============ -->
  <ClosingBand lang={lang} />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    /* Le bloc se cale en haut, à la hauteur où commencent les grands titres
       des autres pages. Depuis que le logo ouvre l'accueil, c'est lui qui
       occupe ce repère, et le titre vient dessous. L'en-tête est fixe : on
       ajoute sa hauteur — plus le filet d'un pixel qui la souligne. */
    align-items: flex-start;
    --haut-titre: calc(var(--header-h) + 1px + var(--titre-page-haut));
    padding-top: var(--haut-titre);
    padding-bottom: clamp(3rem, 8vh, 6rem);
    overflow: hidden;
    color: var(--ink);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    background: var(--paper-2);
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Deux voiles superposés. Celui du haut protège la lecture du titre : il
       est exprimé en longueurs fixes, calées sur la hauteur du bloc de titre,
       pour qu'une fenêtre basse soit couverte comme une fenêtre haute — le
       cadrage de la photo change, la lisibilité non. Celui du bas donne de la
       profondeur et porte l'invitation à défiler. */
    background:
      linear-gradient(
        180deg,
        rgba(235, 231, 222, 0.84) 0,
        rgba(235, 231, 222, 0.82) var(--haut-titre),
        rgba(235, 231, 222, 0.78) calc(var(--haut-titre) + 10rem),
        rgba(235, 231, 222, 0.7) calc(var(--haut-titre) + 18rem),
        rgba(235, 231, 222, 0.62) calc(var(--haut-titre) + 25rem),
        rgba(235, 231, 222, 0.3) calc(var(--haut-titre) + 31rem),
        rgba(235, 231, 222, 0) calc(var(--haut-titre) + 40rem)
      ),
      linear-gradient(
        180deg,
        rgba(33, 33, 33, 0) 58%,
        rgba(33, 33, 33, 0.22) 82%,
        rgba(33, 33, 33, 0.46) 100%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
  }

  :global(.hero__title) {
    max-width: 16ch;
  }

  /* Le grand logo n'existe que sur cette page ; il est aligné à gauche sur le
     titre et sur le menu, dans la même gouttière. */
  .hero__logo {
    display: block;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .hero__logo img {
    height: clamp(68px, 9vw, 110px);
    width: auto;
  }

  /* Le titre dans l'autre langue : même encre, en gras, sur une ligne. */
  .hero__alt {
    margin-top: 1rem;
    font-size: clamp(1.0625rem, 0.85rem + 0.95vw, 1.625rem);
    font-weight: var(--w-bold);
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--ink);
  }

  .hero__cta {
    margin-top: 1.25rem;
  }

  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(3rem, 8vh, 6rem);
    z-index: 2;
    color: rgba(251, 250, 247, 0.7);
    writing-mode: vertical-rl;
    animation: drift 2.6s var(--ease) infinite;
  }

  @keyframes drift {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateY(10px);
      opacity: 1;
    }
  }

  /* ---------- Sections ---------- */
  :global(.sec-title) {
    margin-bottom: 1.25rem;
  }

  .origin__text {
    max-width: 46ch;
    margin-bottom: 1.5rem;
  }

  /* Ce visuel-là traverse l'écran. Les autres de la page restent alignés sur
     le texte : c'est l'alternance qui donne le rythme. */
  .bleed {
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  .shead {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  @media (min-width: 860px) {
    .shead {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: end;
      gap: clamp(2rem, 6vw, 5rem);
    }
  }

  .shead__aside {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 44ch;
  }

  /* Deux références sous celle mise en avant. Rien ne les sépare qu'un
     intervalle : le fond de page passe entre les deux, sans filet. */
  .pgrid {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2.5rem);
  }

  .approach {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 860px) {
    .approach {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .approach__text {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .approach__text .lead {
    max-width: 42ch;
  }

  /* ---------- Journal ---------- */
  .jgrid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
  }

  @media (min-width: 760px) {
    .jgrid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .jcard__date {
    margin-top: 1rem;
  }

  .jcard__title {
    margin-top: 0.5rem;
    font-size: 1.0625rem;
    line-height: 1.32;
    transition: color 0.4s var(--ease);
  }

  .jcard:hover .jcard__title {
    color: var(--accent);
  }

  .jcard__desc {
    margin-top: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

</style>

<script>
  /**
   * Relais entre le grand logo de la bannière et celui de la barre de
   * navigation : un seul des deux paraît à la fois. On observe le grand ; tant
   * qu'il est à l'écran, la classe posée sur la page efface le petit.
   *
   * La classe vit sur l'élément racine, hors de la page : elle doit donc être
   * retirée en quittant l'accueil, sans quoi le logo resterait invisible
   * ailleurs sur le site.
   */
  let observateur: IntersectionObserver | null = null;

  const relaisLogo = () => {
    observateur?.disconnect();
    observateur = null;

    const grand = document.querySelector('[data-logo-accueil]');
    if (!grand) {
      document.documentElement.classList.remove('grand-logo-visible');
      return;
    }

    document.documentElement.classList.add('grand-logo-visible');
    observateur = new IntersectionObserver(
      ([entree]) => {
        document.documentElement.classList.toggle('grand-logo-visible', entree.isIntersecting);
      },
      /* Le petit logo prend le relais dès que le grand passe sous l'en-tête. */
      { rootMargin: '-76px 0px 0px 0px', threshold: 0 },
    );
    observateur.observe(grand);
  };

  document.addEventListener('astro:page-load', relaisLogo);
  document.addEventListener('astro:before-swap', () => {
    observateur?.disconnect();
    document.documentElement.classList.remove('grand-logo-visible');
  });
  relaisLogo();
</script>
