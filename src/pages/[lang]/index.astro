---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import SplitTitle from '../../components/SplitTitle.astro';
import ProBand from '../../components/ProBand.astro';
import ProductCard from '../../components/ProductCard.astro';
import { langPaths } from '../../i18n/paths';
import { useTranslations, route, url, postUrl, formatDate, absolute, type Lang } from '../../i18n/utils';
import { products } from '../../data/products';
import { SITE } from '../../consts';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const posts = (await getCollection('journal'))
  .filter((p) => p.id.startsWith(`${lang}/`) && !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const base = Astro.site ?? new URL('https://yunma.fr');
const jsonld = [
  {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, base).href,
    url: new URL(Astro.url.pathname, base).href,
    name: t.home.seoTitle,
    description: t.home.seoDescription,
    inLanguage: t.meta.hreflang,
    isPartOf: { '@id': `${base.origin}/#website` },
    about: { '@id': `${base.origin}/#organization` },
  },
  {
    '@type': 'ItemList',
    name: t.cafes.title,
    itemListElement: products.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absolute(Astro.site, `${lang}/cafes/${p.slug}/`),
      name: p.name[lang],
    })),
  },
];
---

<Base
  lang={lang}
  title={t.home.seoTitle}
  description={t.home.seoDescription}
  transparentHeader
  jsonld={jsonld}
  keywords={[
    'café de spécialité',
    'Yunnan',
    'specialty coffee',
    'torréfacteur',
    'drip bag',
    'Baoshan',
    "Pu'er",
  ]}
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero__media media is-visible">
      <Photo name="cretes-brumeuses" lang={lang} priority sizes="100vw" decorative />
    </div>
    <div class="hero__inner wrap">
      <SplitTitle text={t.home.heroTitle} as="h1" size="xl" class="hero__title" />
      {/* Le titre dans l'autre langue de la marque, sur une ligne. */}
      <p class="hero__alt" lang={lang === 'zh' ? 'fr' : 'zh'}>{t.home.heroTitleAlt}</p>
      <a class="hero__cta link" href={route(lang, 'cafes')}>
        {t.home.heroCta}<span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <span class="hero__scroll label" aria-hidden="true">{t.common.scroll}</span>
  </section>

  <!-- ============ CAFÉS ============ -->
  <section class="section section--tight panel panel--soft" aria-labelledby="h-cafes">
    <div class="wrap">
      <header class="shead">
        <div>
          <span class="label" data-reveal>{t.home.coffeesLabel}</span>
          <SplitTitle text={t.home.coffeesTitle} as="h2" size="lg" class="sec-title" />
        </div>
        <div class="shead__aside">
          <p class="muted" data-reveal id="h-cafes">{t.home.coffeesText}</p>
          <a class="link" href={route(lang, 'cafes')} data-reveal>
            {t.home.coffeesCta}<span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </header>

      <div class="pgrid">
        {products.map((product, i) => <ProductCard product={product} lang={lang} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ============ ORIGINE ============ -->
  {/* Le visuel ouvre la section, sur toute la largeur, puis vient le texte. */}
  <section class="origine" aria-labelledby="h-origine">
    <figure class="media media--wide origine__media" data-reveal>
      <Photo name="recolte-cueilleurs" lang={lang} sizes="100vw" />
    </figure>

    <div class="wrap grid grid--sidebar origine__texte">
      <div data-reveal>
        <span class="label">{t.home.originLabel}</span>
      </div>
      <div>
        <SplitTitle text={t.home.originTitle} as="h2" size="lg" class="sec-title" />
        <p class="lead muted origin__text" data-reveal id="h-origine">{t.home.originText}</p>
        <a class="link" href={route(lang, 'origine')} data-reveal>
          {t.home.originCta}<span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ JOURNAL ============ -->
  {
    posts.length > 0 && (
      <section class="section section--tight panel" aria-labelledby="h-journal">
        <div class="wrap">
          <header class="shead">
            <div>
              <span class="label" data-reveal>{t.home.journalLabel}</span>
              <SplitTitle text={t.home.journalTitle} as="h2" size="md" />
            </div>
            <div class="shead__aside">
              <a class="link" href={route(lang, 'journal')} data-reveal id="h-journal">
                {t.journal.all}
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </div>
          </header>
        </div>

        {/* Carrousel : les carnets défilent sur une ligne plutôt que de
            s'empiler, pour que la page reste courte. */}
        <div class="carrousel" data-carrousel>
          <ul class="carrousel__piste" tabindex="0" aria-label={t.home.journalTitle}>
            {posts.map((post, i) => (
              <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
                <a class="jcard media-link" href={postUrl(lang, post.id.split('/')[1])}>
                  <div class="media media--wide">
                    <Photo name={post.data.photo} lang={lang} decorative sizes="(min-width: 760px) 32vw, 80vw" />
                  </div>
                  <time class="label jcard__date" datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date, lang)}
                  </time>
                  <h3 class="jcard__title">{post.data.title}</h3>
                  <p class="small muted jcard__desc">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ============ PRO ============ -->
  <ProBand lang={lang} />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    /* Le titre se cale en haut, à la même hauteur que sur les autres pages.
       L'en-tête est fixe : on ajoute sa hauteur — plus le filet d'un pixel
       qui la souligne — au retrait commun aux grands titres. */
    align-items: flex-start;
    /* Le bloc remonte : il commence désormais juste sous l'en-tête, à la
       hauteur du fil d'Ariane des autres pages plutôt qu'à celle de leur
       titre. Le voile de la photographie suit ce déplacement. */
    --haut-titre: calc(var(--header-h) + 1px + clamp(2.5rem, 6vw, 4.5rem));
    padding-top: var(--haut-titre);
    padding-bottom: clamp(3rem, 8vh, 6rem);
    overflow: hidden;
    color: var(--ink);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    background: var(--paper-2);
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Deux voiles superposés. Celui du haut protège la lecture du titre : il
       est exprimé en longueurs fixes, calées sur la hauteur du bloc de titre,
       pour qu'une fenêtre basse soit couverte comme une fenêtre haute — le
       cadrage de la photo change, la lisibilité non. Celui du bas donne de la
       profondeur et porte l'invitation à défiler. */
    background:
      linear-gradient(
        180deg,
        rgba(235, 231, 222, 0.6) 0,
        rgba(235, 231, 222, 0.58) var(--haut-titre),
        rgba(235, 231, 222, 0.56) calc(var(--haut-titre) + 10rem),
        rgba(235, 231, 222, 0.52) calc(var(--haut-titre) + 18rem),
        rgba(235, 231, 222, 0.24) calc(var(--haut-titre) + 22rem),
        rgba(235, 231, 222, 0) calc(var(--haut-titre) + 26rem)
      ),
      linear-gradient(
        180deg,
        rgba(33, 33, 33, 0) 58%,
        rgba(33, 33, 33, 0.22) 82%,
        rgba(33, 33, 33, 0.46) 100%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
  }

  :global(.hero__title) {
    max-width: 16ch;
  }

  .hero__alt {
    margin-top: var(--espace-titre);
    font-size: clamp(1rem, 0.82rem + 0.85vw, 1.5rem);
    font-weight: var(--w-bold);
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--ink);
  }

  .hero__cta {
    margin-top: 1.5rem;
  }

  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(3rem, 8vh, 6rem);
    z-index: 2;
    color: rgba(251, 250, 247, 0.7);
    writing-mode: vertical-rl;
    animation: drift 2.6s var(--ease) infinite;
  }

  @keyframes drift {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateY(10px);
      opacity: 1;
    }
  }

  /* ---------- Sections ---------- */
  :global(.sec-title) {
    margin-bottom: var(--espace-titre);
  }

  .origin__text {
    max-width: 46ch;
    margin-bottom: 1.5rem;
  }

  .shead {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  @media (min-width: 860px) {
    .shead {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: end;
      gap: clamp(2rem, 6vw, 5rem);
    }
  }

  .shead__aside {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 44ch;
  }

  .pgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.75rem);
  }

  @media (min-width: 700px) {
    .pgrid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .pgrid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* ---------- Origine ---------- */
  .origine {
    padding-bottom: var(--section);
  }

  .origine__texte {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* ---------- Journal ---------- */
  /* Les carnets défilent sur une ligne. La piste déborde volontairement de la
     gouttière à droite : une carte coupée au bord dit qu'il y en a d'autres. */
  .carrousel {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .carrousel__piste {
    display: grid;
    grid-auto-flow: column;
    /* Largeur exprimée par rapport à l'écran : dans une piste qui déborde,
       un pourcentage se résout sur le contenu et non sur la fenêtre. */
    grid-auto-columns: 76vw;
    gap: clamp(1rem, 3vw, 2rem);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding-inline: var(--gutter);
    padding-bottom: 0.5rem;
    scrollbar-width: thin;
  }

  .carrousel__piste > li {
    scroll-snap-align: start;
  }

  .carrousel__piste:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  @media (min-width: 760px) {
    .carrousel__piste {
      grid-auto-columns: 34vw;
    }
  }

  @media (min-width: 1100px) {
    .carrousel__piste {
      grid-auto-columns: 26vw;
    }
  }

  .jcard__date {
    margin-top: 1rem;
  }

  .jcard__title {
    margin-top: 0.5rem;
    font-size: 1.0625rem;
    line-height: 1.32;
    transition: color 0.4s var(--ease);
  }

  .jcard:hover .jcard__title {
    color: var(--accent);
  }

  .jcard__desc {
    margin-top: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

</style>
