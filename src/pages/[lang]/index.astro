---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import SplitTitle from '../../components/SplitTitle.astro';
import ProBand from '../../components/ProBand.astro';
import ProductCard from '../../components/ProductCard.astro';
import { langPaths } from '../../i18n/paths';
import { useTranslations, route, postUrl, formatDate, absolute, type Lang } from '../../i18n/utils';
import { getProduct, type Product } from '../../data/products';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const posts = (await getCollection('journal'))
  .filter((p) => p.id.startsWith(`${lang}/`) && !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

/* La vitrine : une référence en tête sur toute la largeur, puis deux côte à
   côte. Les trois sont nommées ici — l'ordre du catalogue n'a pas à décider de
   ce que l'accueil met en avant. */
const vitrine = ['drip-bags-bourbon-jaune', 'torch-estate-lot-01', 'yun-lan-estate']
  .map((slug) => getProduct(slug))
  .filter((p): p is Product => !!p);

const base = Astro.site ?? new URL('https://yunma.fr');
const jsonld = [
  {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, base).href,
    url: new URL(Astro.url.pathname, base).href,
    name: t.home.seoTitle,
    description: t.home.seoDescription,
    inLanguage: t.meta.hreflang,
    isPartOf: { '@id': `${base.origin}/#website` },
    about: { '@id': `${base.origin}/#organization` },
  },
  {
    '@type': 'ItemList',
    name: t.cafes.title,
    itemListElement: vitrine.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absolute(Astro.site, `${lang}/cafes/${p.slug}/`),
      name: p.name[lang],
    })),
  },
];
---

<Base
  lang={lang}
  title={t.home.seoTitle}
  description={t.home.seoDescription}
  transparentHeader
  accueil
  jsonld={jsonld}
  keywords={[
    'café de spécialité',
    'Yunnan',
    'specialty coffee',
    'torréfacteur',
    'drip bag',
    'Baoshan',
    "Pu'er",
  ]}
>
  <!-- ============ HERO ============ -->
  <section class="hero" data-accueil>
    <div class="hero__media media is-visible" data-banniere>
      <Photo name="cerises-branche-02" lang={lang} priority sizes="100vw" decorative />
    </div>
    <div class="hero__inner wrap">
      <SplitTitle text={t.home.heroTitle} as="h1" size="xl" class="hero__title" />
      {/* Le titre dans l'autre langue de la marque. Il suit les retours à la
          ligne du contenu — le français de la version chinoise en demande un,
          là où six idéogrammes tiennent d'un seul tenant. */}
      <p class="hero__alt" lang={lang === 'zh' ? 'fr' : 'zh'}>{t.home.heroTitleAlt}</p>
      <a class="hero__cta link" href={route(lang, 'cafes')}>
        {t.home.heroCta}<span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <span class="hero__scroll label" aria-hidden="true">{t.common.scroll}</span>
  </section>

  <!-- ============ CAFÉS ============ -->
  <section class="cafes section--tight" aria-labelledby="h-cafes">
    <div class="wrap">
      <header class="shead">
        <div>
          <span class="label" data-reveal>{t.home.coffeesLabel}</span>
          <SplitTitle text={t.home.coffeesTitle} as="h2" size="lg" class="sec-title" />
        </div>
        <div class="shead__aside shead__aside--texte">
          <p class="muted" data-reveal id="h-cafes">{t.home.coffeesText}</p>
          <a class="link" href={route(lang, 'cafes')} data-reveal>
            {t.home.coffeesCta}<span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </header>

      {/* La première carte prend toute la largeur, les deux suivantes se
          partagent la ligne : mêmes gouttières, donc mêmes alignements. */}
      <div class="pgrid">
        {vitrine.map((product, i) => <ProductCard product={product} lang={lang} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ============ ORIGINE ============ -->
  {/* Le visuel ouvre la section, sur toute la largeur, puis vient le texte. */}
  <section class="origine" aria-labelledby="h-origine">
    <div class="wrap origine__texte">
      <span class="label" data-reveal>{t.home.originLabel}</span>
      <SplitTitle text={t.home.originTitle} as="h2" size="lg" class="sec-title origine__titre" />
      <p class="lead muted origin__text" data-reveal id="h-origine">{t.home.originText}</p>
      <a class="link" href={route(lang, 'origine')} data-reveal>
        {t.home.originCta}<span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    {/* Le visuel referme la section, sur toute la largeur. */}
    <figure class="media media--wide origine__media" data-reveal>
      <Photo name="recolte-cueilleurs" lang={lang} sizes="100vw" />
    </figure>
  </section>

  <!-- ============ PRO ============ -->
  <ProBand lang={lang} />

  <!-- ============ JOURNAL ============ -->
  {
    posts.length > 0 && (
      <section class="section section--tight" aria-labelledby="h-journal">
        <div class="wrap">
          <header class="shead">
            <div>
              <span class="label" data-reveal>{t.home.journalLabel}</span>
              <SplitTitle text={t.home.journalTitle} as="h2" size="md" class="sec-title" />
            </div>
            <div class="shead__aside shead__aside--lien">
              <a class="link" href={route(lang, 'journal')} data-reveal id="h-journal">
                {t.journal.all}
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </div>
          </header>
        </div>

        {/* Carrousel : les carnets défilent sur une ligne plutôt que de
            s'empiler, pour que la page reste courte. */}
        <div class="carrousel" data-carrousel>
          <ul class="carrousel__piste" tabindex="0" aria-label={t.home.journalTitle}>
            {posts.map((post, i) => (
              <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
                <a class="jcard media-link" href={postUrl(lang, post.id.split('/')[1])}>
                  <div class="media media--wide">
                    <Photo name={post.data.photo} lang={lang} decorative sizes="(min-width: 760px) 32vw, 80vw" />
                  </div>
                  <time class="label jcard__date" datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date, lang)}
                  </time>
                  <h3 class="jcard__title">{post.data.title}</h3>
                  <p class="small muted jcard__desc">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    /* Le titre se cale en haut, à la même hauteur que sur les autres pages.
       L'en-tête est fixe : on ajoute sa hauteur — plus le filet d'un pixel
       qui la souligne — au retrait commun aux grands titres. */
    align-items: flex-start;
    /* Le bloc remonte : il commence désormais juste sous l'en-tête, à la
       hauteur du fil d'Ariane des autres pages plutôt qu'à celle de leur
       titre. Le voile de la photographie suit ce déplacement. */
    --haut-titre: calc(var(--header-h) + 1px + clamp(4.5rem, 9vw, 7.5rem));
    padding-top: var(--haut-titre);
    padding-bottom: clamp(3rem, 8vh, 6rem);
    overflow: hidden;
    color: var(--ink);
  }

  /* Le fond posé derrière la photographie, le temps qu'elle charge : celui de
     la page, pour qu'aucun rectangle plus sombre n'apparaisse avant elle. */
  .hero__media {
    position: absolute;
    inset: 0;
    background: var(--paper);
  }

  /* Une installation à l'arrivée : la photographie entre agrandie et se pose
     à sa taille. C'est le mouvement que le site donne déjà à tous ses médias
     — de 1,06 à 1 dès qu'ils paraissent — mais plus ample et beaucoup plus
     lent, parce qu'ici il installe la page entière : 1,08 sur trois secondes,
     sur une courbe qui ralentit jusqu'au bout.

     Reprendre ce mécanisme plutôt que d'en superposer un second n'est pas un
     détail : une animation CSS et cette règle de transformation se disputaient
     l'élément, et la photographie se retrouvait posée sans mouvement.

     Rien d'autre ne suit : c'est le décor qui se pose, pas la page qui bouge.
     Le cadrage reste intact du début à la fin, l'image ne faisant que déborder
     davantage de son cadre au départ. */
  .hero__media :global(img),
  .hero__media :global(picture > img) {
    transform: scale(1.08);
    transition: transform 3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .hero__media.is-visible :global(img),
  .hero__media.is-visible :global(picture > img) {
    transform: scale(1);
  }

  /* Le temps d'un battement, quand on remet la photographie à sa taille de
     départ pour rejouer l'entrée. Sans cela, le retour en arrière s'anime lui
     aussi — la transition vaut dans les deux sens — et l'on repartirait du
     milieu de nulle part au lieu de 1,08. */
  .hero__media[data-sans-transition] :global(img),
  .hero__media[data-sans-transition] :global(picture > img) {
    transition: none;
  }

  /* La photographie se donne telle quelle : aucun voile clair par-dessus. Seul
     subsiste le dégradé sombre du bas, qui donne de la profondeur et porte
     l'invitation à défiler. */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(33, 33, 33, 0) 58%,
      rgba(33, 33, 33, 0.22) 82%,
      rgba(33, 33, 33, 0.46) 100%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
  }

  :global(.hero__title) {
    max-width: 16ch;
  }

  /* La traduction se lit comme une ligne de plus du titre : même corps, même
     interligne, même encre — seule la graisse la distingue.
     Les idéogrammes remplissent presque toute la hauteur d'em, là où les
     capitales latines n'en occupent que les trois quarts : à interlignage
     égal, le blanc au-dessus du chinois se referme. La marge le rouvre : elle
     vaut l'écart mesuré entre les deux hauteurs d'encre (0,836 em contre
     0,692 em), pour que tous les intervalles du bloc se valent. */
  /* La ligne dans l'autre langue perd quatre points sur le titre : à corps
     égal, une écriture idéographique paraît plus grosse qu'une latine. La
     règle vaut dans les deux sens — c'est le français qui rapetisse sur la
     version chinoise. */
  .hero__alt {
    white-space: pre-line;
    margin-top: 0.15em;
    font-size: clamp(1.8125rem, 1.1625rem + 3.1vw, 4.0625rem);
    font-weight: var(--w-light);
    line-height: 1.04;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .hero__cta {
    margin-top: var(--espace-titre);
  }

  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(3rem, 8vh, 6rem);
    z-index: 2;
    color: rgba(251, 250, 247, 0.7);
    writing-mode: vertical-rl;
    animation: drift 2.6s var(--ease) infinite;
  }

  @keyframes drift {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateY(10px);
      opacity: 1;
    }
  }

  /* ---------- Sections ---------- */
  :global(.origine__titre) {
    max-width: 20ch;
  }

  .origin__text {
    max-width: 46ch;
    margin-bottom: 1.5rem;
  }

  .shead {
    display: grid;
    gap: var(--espace-titre);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  /* Le texte et le lien se calent sur le bas du titre, et non sur son haut :
     c'est l'alignement de la bande professionnelle, repris ici. */
  @media (min-width: 860px) {
    .shead {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      grid-template-rows: auto auto;
      align-items: end;
      row-gap: 0;
      column-gap: clamp(2rem, 6vw, 5rem);
    }

    /* Le titre garde la première ligne : c'est sur son bas que tout se cale. */
    .shead > :first-child {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .shead__aside {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 44ch;
  }

  /* Sur grand écran, c'est le bas du paragraphe qui doit venir sur le bas du
     titre, et non le bas du bloc entier — sans quoi c'est le lien qui s'aligne
     et le texte flotte au-dessus. Le cadre s'efface donc (`display: contents`)
     et ses deux enfants prennent place eux-mêmes : le paragraphe sur la ligne
     du titre, le lien sur une seconde ligne, sous l'alignement. */
  @media (min-width: 860px) {
    .shead__aside--texte {
      display: contents;
    }

    .shead__aside--texte > p {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
      max-width: 44ch;
    }

    .shead__aside--texte > a {
      grid-column: 2;
      grid-row: 2;
      justify-self: start;
      margin-top: 1rem;
    }
  }

  /* Quand la colonne ne porte qu'un lien, il se ferre à droite, comme celui
     de la bande professionnelle. Une colonne de texte, elle, reste à gauche. */
  @media (min-width: 860px) {
    .shead__aside--lien {
      justify-items: end;
    }
  }

  /* Sur petit écran, la référence de tête occupe la ligne entière et les deux
     suivantes se la partagent. Sur grand écran, les trois se rangent en autant
     de colonnes égales : aucune n'est mise en avant. */
  .pgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 2.5vw, 2.5rem);
  }

  /* :global() est nécessaire : la carte vient d'un composant, elle ne porte
     donc pas la portée de cette page. */
  .pgrid > :global(:first-child) {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .pgrid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pgrid > :global(:first-child) {
      grid-column: auto;
    }
  }

  .cafes {
    padding-top: var(--section);
  }

  /* ---------- Origine ---------- */
  /* Sur grand écran, le 4/3 de ce visuel faisait près d'un écran de haut : on
     n'en voyait pas le bout au défilement. Le cadre se réduit de moitié et
     rogne la photographie plutôt que de la réduire — elle reste un bandeau,
     pas un mur. Sur mobile, où la largeur est petite, le 4/3 convient. */
  @media (min-width: 900px) {
    .origine__media {
      aspect-ratio: 8 / 3;
    }
  }

  .origine__texte {
    padding-block: var(--espace-apres-visuel);
  }

  /* ---------- Journal ---------- */
  /* Les carnets défilent sur une ligne. La piste déborde volontairement de la
     gouttière à droite : une carte coupée au bord dit qu'il y en a d'autres. */
  .carrousel {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .carrousel__piste {
    display: grid;
    grid-auto-flow: column;
    /* Largeur exprimée par rapport à l'écran : dans une piste qui déborde,
       un pourcentage se résout sur le contenu et non sur la fenêtre. */
    grid-auto-columns: 76vw;
    gap: clamp(1rem, 3vw, 2rem);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding-inline: var(--gutter);
    /* Aucun indicateur de défilement : la carte coupée au bord droit suffit à
       dire qu'il y en a d'autres. */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .carrousel__piste::-webkit-scrollbar {
    display: none;
  }

  .carrousel__piste > li {
    scroll-snap-align: start;
  }

  .carrousel__piste:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  @media (min-width: 760px) {
    .carrousel__piste {
      grid-auto-columns: 34vw;
    }
  }

  @media (min-width: 1100px) {
    .carrousel__piste {
      grid-auto-columns: 26vw;
    }
  }

  .jcard__date {
    margin-top: 1rem;
  }

  .jcard__title {
    margin-top: var(--espace-carte);
    font-size: 1.0625rem;
    line-height: 1.32;
    transition: color 0.4s var(--ease);
  }

  .jcard:hover .jcard__title {
    color: var(--accent);
  }

  .jcard__desc {
    margin-top: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

</style>

<script>
  /**
   * L'installation de la bannière : la photographie entre agrandie et se pose.
   *
   * Le HTML porte déjà `is-visible`, donc sans JavaScript la photographie
   * s'affiche à sa taille, posée — jamais agrandie pour toujours. Ce script ne
   * fait que retirer la classe puis la remettre, ce qui rejoue la transition
   * depuis son premier instant. Il le fait à chaque arrivée sur l'accueil, y
   * compris la première : le site navigue sans recharger la page, et sans cela
   * la photographie revenait posée d'avance quand on retournait à l'accueil.
   */
  const installerBanniere = () => {
    /* Qui a demandé moins de mouvement n'en reçoit pas davantage au retour. */
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const banniere = document.querySelector<HTMLElement>('[data-banniere]');
    if (!banniere) return;

    /* On coupe la transition avant de reculer : sans cela le retour à 1,08
       s'animerait lui aussi, et la remise de la classe repartirait du milieu
       du chemin plutôt que du début. */
    /* Deux trames d'attente, et non zéro : au retour sur l'accueil, la page
       vient d'être échangée et la transition de vue du navigateur n'a pas
       fini de rendre la main. Agir tout de suite ne donnait rien — mesuré,
       l'échelle ne bougeait pas d'un millième. Une fois la première image
       peinte, l'élément a un état de départ, et la transition part. */
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        banniere.setAttribute('data-sans-transition', '');
        banniere.classList.remove('is-visible');
        /* Cette lecture fige l'état reculé : sans elle, le navigateur regroupe
           tout en un seul recalcul et rien ne repart. */
        void banniere.offsetWidth;
        banniere.removeAttribute('data-sans-transition');
        banniere.classList.add('is-visible');
      });
    });
  };

  document.addEventListener('astro:page-load', installerBanniere);
</script>
