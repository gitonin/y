---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import SplitTitle from '../../components/SplitTitle.astro';
import ProBand from '../../components/ProBand.astro';
import ClosingBand from '../../components/ClosingBand.astro';
import ProductCard from '../../components/ProductCard.astro';
import { langPaths } from '../../i18n/paths';
import { useTranslations, route, absolute, type Lang } from '../../i18n/utils';
import { products } from '../../data/products';
import { SITE } from '../../consts';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

/* L'accueil ne montre que trois références : la première en pleine largeur,
   les deux suivantes côte à côte. Le reste de la gamme est sur la page cafés. */
const [enAvant, ...suivants] = products.slice(0, 3);

const base = Astro.site ?? new URL('https://yunma.fr');
const jsonld = [
  {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, base).href,
    url: new URL(Astro.url.pathname, base).href,
    name: t.home.seoTitle,
    description: t.home.seoDescription,
    inLanguage: t.meta.hreflang,
    isPartOf: { '@id': `${base.origin}/#website` },
    about: { '@id': `${base.origin}/#organization` },
  },
  {
    '@type': 'ItemList',
    name: t.cafes.title,
    itemListElement: products.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absolute(Astro.site, `${lang}/cafes/${p.slug}/`),
      name: p.name[lang],
    })),
  },
];
---

<Base
  lang={lang}
  title={t.home.seoTitle}
  description={t.home.seoDescription}
  transparentHeader
  jsonld={jsonld}
  keywords={[
    'café de spécialité',
    'Yunnan',
    'specialty coffee',
    'torréfacteur',
    'drip bag',
    'Baoshan',
    "Pu'er",
  ]}
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero__media media is-visible">
      <Photo name="cretes-brumeuses" lang={lang} priority sizes="100vw" decorative />
    </div>
    <div class="hero__inner wrap">
      <SplitTitle text={t.home.heroTitle} as="h1" size="xl" class="hero__title" />
      {/* Le titre dans l'autre langue de la marque, sous le premier. */}
      <p class="hero__alt prewrap" lang={lang === 'zh' ? 'fr' : 'zh'}>{t.home.heroTitleAlt}</p>
      <a class="btn hero__cta" href={route(lang, 'cafes')}>
        {t.home.heroCta}<span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <span class="hero__scroll label" aria-hidden="true">{t.common.scroll}</span>
  </section>

  <!-- ============ CAFÉS ============ -->
  <section class="cafes" aria-labelledby="h-cafes">
    <div class="wrap">
      <SplitTitle text={t.home.introBig} as="h2" size="lg" class="cafes__title" />
      <p class="visually-hidden" id="h-cafes">{t.home.introBig.split('\n').join(' ')}</p>

      <ProductCard product={enAvant} lang={lang} feature />
    </div>

    {/* Deux références bord à bord, séparées d'un simple filet. */}
    <div class="cafes__duo">
      {suivants.map((product, i) => <ProductCard product={product} lang={lang} index={i} />)}
    </div>

    <div class="wrap">
      <a class="link cafes__lien" href={route(lang, 'cafes')}>
        {t.home.coffeesCta}<span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ============ PUSH ORIGINE ============ -->
  <ClosingBand lang={lang} />

  <!-- ============ PUSH PRO ============ -->
  <ProBand lang={lang} />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    /* Le titre se cale en haut, à la même hauteur que sur les autres pages.
       L'en-tête est fixe : on ajoute sa hauteur — plus le filet d'un pixel
       qui la souligne — au retrait commun aux grands titres. */
    align-items: flex-start;
    --haut-titre: calc(var(--header-h) + 1px + var(--titre-page-haut));
    padding-top: var(--haut-titre);
    padding-bottom: clamp(3rem, 8vh, 6rem);
    overflow: hidden;
    color: var(--ink);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    background: var(--paper-2);
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Deux voiles superposés. Celui du haut protège la lecture du titre : il
       est exprimé en longueurs fixes, calées sur la hauteur du bloc de titre,
       pour qu'une fenêtre basse soit couverte comme une fenêtre haute — le
       cadrage de la photo change, la lisibilité non. Celui du bas donne de la
       profondeur et porte l'invitation à défiler. */
    background:
      linear-gradient(
        180deg,
        rgba(235, 231, 222, 0.74) 0,
        rgba(235, 231, 222, 0.7) var(--haut-titre),
        rgba(235, 231, 222, 0.58) calc(var(--haut-titre) + 11rem),
        rgba(235, 231, 222, 0.28) calc(var(--haut-titre) + 18rem),
        rgba(235, 231, 222, 0) calc(var(--haut-titre) + 25rem)
      ),
      linear-gradient(
        180deg,
        rgba(33, 33, 33, 0) 58%,
        rgba(33, 33, 33, 0.22) 82%,
        rgba(33, 33, 33, 0.46) 100%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
  }

  :global(.hero__title) {
    max-width: 16ch;
  }

  /* Le titre dans l'autre langue, à la même encre que le premier, plus petit :
     un écho, pas un sous-titre. */
  .hero__alt {
    margin-top: 1rem;
    font-size: clamp(1.0625rem, 0.8rem + 1.15vw, 1.75rem);
    font-weight: var(--w-medium);
    line-height: 1.28;
    letter-spacing: 0.01em;
    color: var(--ink);
  }

  .hero__cta {
    margin-top: 1.75rem;
    width: auto;
    padding-inline: 2.25rem;
  }

  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(3rem, 8vh, 6rem);
    z-index: 2;
    color: rgba(251, 250, 247, 0.7);
    writing-mode: vertical-rl;
    animation: drift 2.6s var(--ease) infinite;
  }

  @keyframes drift {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateY(10px);
      opacity: 1;
    }
  }

  /* ---------- Présentation ---------- */
  .intro {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .intro__text {
    margin-top: 1rem;
    text-wrap: pretty;
  }

  /* ---------- Cafés ---------- */
  .cafes {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  :global(.cafes__title) {
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
  }

  /* Deux références bord à bord, sur toute la largeur de l'écran : aucune
     marge sur les côtés, un simple filet entre les deux colonnes. */
  .cafes__duo {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1px;
    background: var(--line);
  }

  .cafes__duo > :global(*) {
    background: var(--paper);
  }

  /* Le visuel remplit sa colonne : le retrait de gouttière n'a plus cours. */
  .cafes__duo :global(.bleed-mobile) {
    margin-inline: 0;
    width: 100%;
  }

  /* Le texte, lui, garde de l'air sous le visuel. */
  .cafes__duo :global(.pcard__body) {
    padding: 1rem var(--gutter) clamp(1.5rem, 4vw, 2.5rem);
  }

  /* Sur grand écran, la paire passe au carré : deux visuels au format
     portrait dépasseraient en hauteur celui du produit mis en avant, et la
     hiérarchie de la page s'inverserait. */
  @media (min-width: 700px) {
    .cafes__duo :global(.shot) {
      aspect-ratio: 1 / 1;
    }
  }

  .cafes__lien {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

</style>
