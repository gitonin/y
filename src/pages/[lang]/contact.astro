---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PushFin from '../../components/PushFin.astro';
import { langPaths } from '../../i18n/paths';
import { useTranslations, route, absolute, type Lang } from '../../i18n/utils';
import { SITE } from '../../consts';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const base = Astro.site ?? new URL('https://yunma.fr');

const jsonld = [
  {
    '@type': 'ContactPage',
    '@id': new URL(Astro.url.pathname, base).href,
    name: t.contact.seoTitle,
    description: t.contact.seoDescription,
    inLanguage: t.meta.hreflang,
    mainEntity: { '@id': `${base.origin}/#organization` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.common.home, item: absolute(Astro.site, `${lang}/`) },
      { '@type': 'ListItem', position: 2, name: t.nav.contact, item: absolute(Astro.site, `${lang}/contact/`) },
    ],
  },
];
---

<Base lang={lang} title={t.contact.seoTitle} description={t.contact.seoDescription} jsonld={jsonld}>
  <PageHero
    lang={lang}
    label={t.contact.label}
    title={t.contact.title}
    intro={t.contact.intro}
    size="md"
  />

  <div class="wrap contact">
    {/* Les trois sujets d'abord, sans adresse répétée sous chacun : une seule
        adresse pour tout le monde, donnée une fois, en bas. */}
    <ul class="ccards">
      <li class="ccard" data-reveal>
        <span class="label">{t.contact.generalTitle}</span>
        <p class="muted ccard__text">{t.contact.generalText}</p>
      </li>

      <li class="ccard" data-reveal style="--reveal-delay:90ms">
        <span class="label">{t.contact.proTitle}</span>
        <p class="muted ccard__text">{t.contact.proText}</p>
        <a class="small muted ccard__more" href={route(lang, 'pro')}>{t.pro.forWhoCta}</a>
      </li>

      <li class="ccard" data-reveal style="--reveal-delay:180ms">
        <span class="label">{t.contact.pressTitle}</span>
        <p class="muted ccard__text">{t.contact.pressText}</p>
      </li>
    </ul>

    <aside class="cecrire panel panel--soft" data-reveal>
      <div>
        <span class="label">{t.nav.contact}</span>
        <p class="lead cecrire__intro">{t.contact.writeIntro}</p>
      </div>
      <div class="cecrire__liens">
        <a class="link" href={`mailto:${SITE.email}`}>
          {t.contact.writeUs}<span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="link" href={SITE.whatsapp} target="_blank" rel="noopener">
          {t.common.whatsapp}<span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </aside>
  </div>

  {/* La page se referme comme la page Origine, sur le même bloc. */}
  <PushFin lang={lang} text={t.apropos.closing} cta={t.contact.discoverCta} href={route(lang, 'cafes')} />
</Base>



<style>
  .contact {
    padding-bottom: var(--section);
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  .ccards {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  @media (min-width: 860px) {
    .ccards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ccard {
    display: grid;
    justify-items: start;
    gap: var(--espace-carte);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .ccard__text {
    max-width: 40ch;
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .ccard__link {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: var(--fs-body);
  }

  .ccard__more {
    border-bottom: 1px solid var(--line);
    padding-bottom: 1px;
  }

  .ccard__more:hover {
    border-color: var(--accent);
  }

  .cecrire {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }

  @media (min-width: 760px) {
    .cecrire {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }

  .cecrire__intro {
    margin-top: var(--espace-surtitre);
    max-width: 40ch;
  }

  .cecrire__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem clamp(1.5rem, 4vw, 2.5rem);
  }

</style>
