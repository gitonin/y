---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { langPaths } from '../../i18n/paths';
import { useTranslations, route, type Lang } from '../../i18n/utils';
import { SITE } from '../../consts';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const base = Astro.site ?? new URL('https://yunma.fr');

const jsonld = [
  {
    '@type': 'ContactPage',
    '@id': new URL(Astro.url.pathname, base).href,
    name: t.contact.seoTitle,
    description: t.contact.seoDescription,
    inLanguage: t.meta.hreflang,
    mainEntity: { '@id': `${base.origin}/#organization` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.common.home, item: new URL(`${lang}/`, base).href },
      { '@type': 'ListItem', position: 2, name: t.nav.contact, item: new URL(`${lang}/contact/`, base).href },
    ],
  },
];
---

<Base lang={lang} title={t.contact.seoTitle} description={t.contact.seoDescription} jsonld={jsonld}>
  <PageHero
    lang={lang}
    label={t.contact.label}
    title={t.contact.title}
    intro={t.contact.intro}
    crumb={t.nav.contact}
    size="md"
  />

  <div class="wrap contact">
    <div class="contact__cards">
      <div class="ccard" data-reveal>
        <span class="label">{t.contact.generalTitle}</span>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
      <div class="ccard" data-reveal>
        <span class="label">{t.contact.proTitle}</span>
        <a href={`mailto:${SITE.proEmail}`}>{SITE.proEmail}</a>
        <a class="small muted" href={route(lang, 'pro')}>{t.pro.forWhoCta}</a>
      </div>
      <div class="ccard" data-reveal>
        <span class="label">{t.contact.pressTitle}</span>
        <a href={`mailto:${SITE.pressEmail}`}>{SITE.pressEmail}</a>
      </div>
      <div class="ccard" data-reveal>
        <span class="label">{t.contact.hoursTitle}</span>
        <address>
          {SITE.address.street}<br />
          {SITE.address.postalCode} {SITE.address.city}
        </address>
        <p class="small muted">{t.contact.hoursText}</p>
      </div>
    </div>

    <form
      class="cform"
      data-reveal
      action={`mailto:${SITE.email}`}
      method="post"
      enctype="text/plain"
      data-contact-form
    >
      <h2 class="label cform__title">{t.contact.formTitle}</h2>

      <label class="field">
        <span>{t.common.name}</span>
        <input type="text" name="name" autocomplete="name" required />
      </label>

      <label class="field">
        <span>{t.common.email}</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>

      <label class="field">
        <span>{t.contact.subject}</span>
        <select name="subject">
          {t.contact.subjects.map((subject) => <option value={subject}>{subject}</option>)}
        </select>
      </label>

      <label class="field">
        <span>{t.common.message}</span>
        <textarea name="message" rows="5" required></textarea>
      </label>

      <button class="btn" type="submit">{t.common.send}</button>
      <p class="small muted cform__note">{t.contact.formNote}</p>
    </form>
  </div>
</Base>

<script>
  /* Sans back-office, le formulaire compose un e-mail dans le client de l'utilisateur.
     Branchez ici votre service (Formspree, Basin, Shopify Forms…) le moment venu. */
  const initContactForm = () => {
    document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = '1';
      form.addEventListener('submit', (event) => {
        if (!form.reportValidity()) return;
        event.preventDefault();
        const data = new FormData(form);
        const to = (form.getAttribute('action') || '').replace('mailto:', '');
        const subject = `${data.get('subject') ?? 'Contact'} — ${data.get('name') ?? ''}`;
        const body = `${data.get('message') ?? ''}\n\n— ${data.get('name') ?? ''} (${data.get('email') ?? ''})`;
        window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
    });
  };

  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .contact {
    padding-bottom: var(--section);
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  @media (min-width: 960px) {
    .contact {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: start;
    }
  }

  .contact__cards {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 620px) {
    .contact__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ccard {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
  }

  .ccard a {
    border-bottom: 1px solid var(--line);
    padding-bottom: 1px;
    transition: border-color 0.35s var(--ease);
  }

  .ccard a:hover {
    border-color: var(--accent);
  }

  .ccard address {
    font-style: normal;
    line-height: 1.6;
  }

  .cform {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--paper-2);
  }

  .cform__title {
    margin-bottom: 1.5rem;
  }

  .cform__note {
    margin-top: 1rem;
  }
</style>
