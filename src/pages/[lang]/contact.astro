---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { langPaths } from '../../i18n/paths';
import { useTranslations, route, absolute, type Lang } from '../../i18n/utils';
import { SITE } from '../../consts';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const base = Astro.site ?? new URL('https://yunma.fr');

const jsonld = [
  {
    '@type': 'ContactPage',
    '@id': new URL(Astro.url.pathname, base).href,
    name: t.contact.seoTitle,
    description: t.contact.seoDescription,
    inLanguage: t.meta.hreflang,
    mainEntity: { '@id': `${base.origin}/#organization` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.common.home, item: absolute(Astro.site, `${lang}/`) },
      { '@type': 'ListItem', position: 2, name: t.nav.contact, item: absolute(Astro.site, `${lang}/contact/`) },
    ],
  },
];
---

<Base lang={lang} title={t.contact.seoTitle} description={t.contact.seoDescription} jsonld={jsonld}>
  <PageHero
    lang={lang}
    label={t.contact.label}
    title={t.contact.title}
    intro={t.contact.intro}
    crumb={t.nav.contact}
    size="md"
  />

  <div class="wrap contact">
    <ul class="ccards">
      <li class="ccard" data-reveal>
        <span class="label">{t.contact.generalTitle}</span>
        <p class="muted ccard__text">{t.contact.generalText}</p>
        <a class="link ccard__link" href={`mailto:${SITE.email}`}>
          {SITE.email}<span class="arrow" aria-hidden="true">→</span>
        </a>
      </li>

      <li class="ccard" data-reveal style="--reveal-delay:90ms">
        <span class="label">{t.contact.proTitle}</span>
        <p class="muted ccard__text">{t.contact.proText}</p>
        <a class="link ccard__link" href={`mailto:${SITE.proEmail}`}>
          {SITE.proEmail}<span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="small muted ccard__more" href={route(lang, 'pro')}>{t.pro.forWhoCta}</a>
      </li>

      <li class="ccard" data-reveal style="--reveal-delay:180ms">
        <span class="label">{t.contact.pressTitle}</span>
        <p class="muted ccard__text">{t.contact.pressText}</p>
        <a class="link ccard__link" href={`mailto:${SITE.pressEmail}`}>
          {SITE.pressEmail}<span class="arrow" aria-hidden="true">→</span>
        </a>
      </li>
    </ul>

    <aside class="cplace panel panel--soft" data-reveal>
      <div>
        <span class="label">{t.contact.hoursTitle}</span>
        <address class="cplace__address">
          {SITE.address.street}<br />
          {SITE.address.postalCode} {SITE.address.city}
        </address>
        <p class="small muted">{t.contact.hoursText}</p>
      </div>
      <div class="cplace__phone">
        <span class="label">{t.nav.contact}</span>
        <a class="link link--ink" href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a>
      </div>
    </aside>
  </div>
</Base>



<style>
  .contact {
    padding-bottom: var(--section);
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  .ccards {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  @media (min-width: 860px) {
    .ccards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ccard {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .ccard__text {
    max-width: 40ch;
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .ccard__link {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: var(--fs-body);
  }

  .ccard__more {
    border-bottom: 1px solid var(--line);
    padding-bottom: 1px;
  }

  .ccard__more:hover {
    border-color: var(--accent);
  }

  .cplace {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  @media (min-width: 700px) {
    .cplace {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }
  }

  .cplace__address {
    font-style: normal;
    line-height: 1.6;
    margin-block: 0.5rem 0.4rem;
  }

  .cplace__phone {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
  }
</style>
