---
/**
 * L'expérience immersive de la v5 — plein écran, sans en-tête ni pied de page :
 * une fois entré, il n'y a plus que la tasse et la main qui la tient.
 *
 * La page ne va pas dans le plan du site et demande à ne pas être indexée :
 * c'est un banc d'essai, pas une page de la boutique.
 */
import type { GetStaticPaths } from 'astro';
import '../../styles/global.css';
import { langPaths } from '../../i18n/paths';
import { useTranslations, url, asset, type Lang } from '../../i18n/utils';

export const getStaticPaths: GetStaticPaths = () => langPaths();

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const x = t.experience;
---

<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#212121" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{x.seoTitle}</title>
    <meta name="description" content={x.seoDescription} />
    <link rel="icon" href={asset('brand/favicon-96.png')} type="image/png" sizes="96x96" />
  </head>

  <body class="xp-body">
    <div class="xp" data-experience>
      {/* Le flux de la caméra, muet et sans commande : c'est un décor. */}
      <video class="xp__video" data-video playsinline muted autoplay></video>
      <canvas class="xp__toile" data-toile></canvas>

      <a class="xp__fermer" href={url(lang)} aria-label={x.close}>
        <svg viewBox="0 0 22 22" aria-hidden="true"
          ><path d="M3 3l16 16M19 3L3 19" stroke="currentColor" stroke-width="1.4" /></svg
        >
      </a>

      <!-- ============ PANNEAU D'ACCUEIL ============ -->
      <div class="xp__panneau" data-panneau>
        <div class="xp__carte">
          <span class="label xp__label">{x.label}</span>
          <h1 class="xp__titre">{x.title}</h1>
          <p class="xp__intro">{x.intro}</p>
          <p class="xp__note">{x.cameraNote}</p>
          <button class="xp__bouton" type="button" data-debut>{x.start}</button>
          <p class="xp__permission">{x.permission}</p>
          <a class="xp__retour" href={url(lang)}>{x.back}</a>
        </div>
      </div>

      <!-- ============ TABLEAU DE BORD ============ -->
      <div class="xp__bord" aria-hidden="true">
        <div class="xp__mesure">
          <span class="label">{x.score}</span>
          <strong><span data-chrono>0.0</span> {x.seconds}</strong>
        </div>
        <div class="xp__mesure">
          <span class="label">{x.best}</span>
          <strong data-record>—</strong>
        </div>
        <div class="xp__mesure xp__mesure--jauge">
          <span class="label">{x.level}</span>
          <span class="xp__jauge" data-jauge><i></i></span>
        </div>
      </div>

      <p class="xp__consigne" data-consigne>{x.howto}</p>

      {/* Les libellés dont le moteur a besoin. Un module importé ne peut pas
          recevoir de variables au rendu : ils transitent par ce bloc. */}
      <script is:inline type="application/json" data-libelles set:html={JSON.stringify({
        score: x.score,
        best: x.best,
        spilled: x.spilled,
        again: x.again,
        howto: x.howto,
        seconds: x.seconds,
        level: x.level,
        noCamera: x.noCamera,
        noMotion: x.noMotion,
      })} />

      <!-- ============ FIN DE PARTIE ============ -->
      <div class="xp__fin" data-fin hidden>
        <div class="xp__carte">
          <h2 class="xp__titre xp__titre--fin">{x.spilled}</h2>
          <p class="xp__score"><span data-fin-score>0.0</span></p>
          <button class="xp__bouton" type="button" data-rejouer>{x.again}</button>
          <a class="xp__retour" href={url(lang)}>{x.back}</a>
        </div>
      </div>
    </div>

    <script>
      import { demarrerExperience } from '../../scripts/experience';

      const racine = document.querySelector<HTMLElement>('[data-experience]');
      const source = racine?.querySelector<HTMLScriptElement>('[data-libelles]');
      if (racine && source) {
        const arreter = demarrerExperience(racine, JSON.parse(source.textContent || '{}'));
        /* Quitter la page coupe la caméra sans attendre le ramasse-miettes. */
        window.addEventListener('pagehide', arreter);
      }
    </script>

    <style>
      .xp-body {
        margin: 0;
        background: #141210;
        color: var(--paper);
        overflow: hidden;
        overscroll-behavior: none;
      }

      /* Le grain global n'a pas cours ici : la caméra a le sien. */
      .xp-body::before,
      .xp-body::after {
        display: none;
      }

      .xp {
        position: fixed;
        inset: 0;
        display: grid;
        place-items: center;
        overflow: hidden;
      }

      .xp__video,
      .xp__toile {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .xp__video {
        object-fit: cover;
        opacity: 0;
        transition: opacity 1.2s var(--ease);
      }

      .xp.is-camera .xp__video {
        opacity: 1;
      }

      /* Sans caméra, un fond chaud tient lieu de décor : la tasse ne flotte
         jamais dans le vide. */
      .xp::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(120% 90% at 50% 30%, #3a2f26, #141210 72%);
      }

      .xp.is-camera::before {
        background: linear-gradient(180deg, rgba(20, 18, 16, 0.32), rgba(20, 18, 16, 0.58));
      }

      .xp__toile {
        z-index: 2;
        pointer-events: none;
      }

      /* ---------- Fermeture ---------- */
      .xp__fermer {
        position: absolute;
        top: max(1rem, env(safe-area-inset-top));
        right: max(1rem, env(safe-area-inset-right));
        z-index: 6;
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 999px;
        color: var(--paper);
        background: rgba(20, 18, 16, 0.5);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }

      .xp__fermer svg {
        width: 16px;
        height: 16px;
      }

      /* ---------- Panneaux ---------- */
      .xp__panneau,
      .xp__fin {
        position: absolute;
        inset: 0;
        z-index: 5;
        display: grid;
        place-items: center;
        padding: var(--gutter);
        background: rgba(20, 18, 16, 0.55);
        backdrop-filter: blur(22px) saturate(1.1);
        -webkit-backdrop-filter: blur(22px) saturate(1.1);
      }

      /* `display: grid` l'emporte sur l'attribut `hidden` : il faut le dire. */
      .xp__panneau[hidden],
      .xp__fin[hidden] {
        display: none;
      }

      .xp__carte {
        max-width: 34rem;
        display: grid;
        justify-items: start;
        gap: var(--espace-carte);
        text-align: left;
      }

      .xp__label {
        color: rgba(235, 231, 222, 0.6);
      }

      .xp__titre {
        margin-top: var(--espace-surtitre);
        margin-bottom: var(--espace-titre);
        font-size: var(--fs-h1);
        font-family: var(--font-titre);
        font-weight: var(--w-semi);
        line-height: 1.04;
        letter-spacing: -0.022em;
        color: var(--paper);
      }

      .xp__intro {
        font-size: var(--fs-lead);
        line-height: 1.45;
        max-width: 32ch;
        color: rgba(235, 231, 222, 0.88);
      }

      .xp__note,
      .xp__permission {
        font-size: var(--fs-small);
        line-height: 1.6;
        max-width: 40ch;
        color: rgba(235, 231, 222, 0.58);
      }

      .xp__bouton {
        margin-top: var(--espace-titre);
        padding: 0.9rem 1.9rem;
        border: 0;
        border-radius: 999px;
        background: var(--paper);
        color: #181513;
        font-family: var(--font-sans);
        font-size: var(--fs-label);
        font-weight: var(--w-medium);
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
        cursor: pointer;
        transition:
          transform 0.4s var(--ease-out-expo),
          background-color 0.3s var(--ease);
      }

      .xp__bouton:hover {
        transform: translateY(-2px);
      }

      .xp__bouton:disabled {
        opacity: 0.55;
        cursor: progress;
      }

      .xp__retour {
        margin-top: var(--espace-titre);
        font-size: var(--fs-label);
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
        color: rgba(235, 231, 222, 0.6);
        border-bottom: 1px solid rgba(235, 231, 222, 0.28);
        padding-bottom: 2px;
      }

      .xp__score {
        font-family: var(--font-titre);
        font-weight: var(--w-semi);
        font-size: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
        line-height: 1;
        color: var(--accent-clair);
      }

      /* ---------- Tableau de bord ---------- */
      .xp__bord {
        position: absolute;
        top: max(1rem, env(safe-area-inset-top));
        left: max(1rem, env(safe-area-inset-left));
        z-index: 4;
        display: grid;
        gap: 0.85rem;
        opacity: 0;
        transition: opacity 0.6s var(--ease);
      }

      .xp.is-jeu .xp__bord {
        opacity: 1;
      }

      .xp__mesure {
        display: grid;
        gap: 2px;
      }

      .xp__mesure .label {
        color: rgba(235, 231, 222, 0.52);
      }

      .xp__mesure strong {
        font-family: var(--font-titre);
        font-weight: var(--w-semi);
        font-size: 1.35rem;
        font-variant-numeric: tabular-nums;
      }

      .xp__jauge {
        display: block;
        width: 88px;
        height: 4px;
        margin-top: 4px;
        border-radius: 999px;
        background: rgba(235, 231, 222, 0.22);
        overflow: hidden;
      }

      .xp__jauge i {
        display: block;
        height: 100%;
        width: calc(var(--part, 0.62) * 100%);
        background: var(--accent-clair);
        transition: width 0.12s linear;
      }

      /* ---------- Consigne ---------- */
      .xp__consigne {
        position: absolute;
        bottom: max(1.5rem, env(safe-area-inset-bottom));
        left: 50%;
        translate: -50% 0;
        z-index: 4;
        margin: 0;
        padding-inline: var(--gutter);
        max-width: 40ch;
        text-align: center;
        font-size: var(--fs-small);
        color: rgba(235, 231, 222, 0.72);
        opacity: 0;
        transition: opacity 0.6s var(--ease);
      }

      .xp.is-jeu .xp__consigne {
        opacity: 1;
      }

      .xp.is-fini .xp__consigne,
      .xp.is-fini .xp__bord {
        opacity: 0;
      }
    </style>
  </body>
</html>
