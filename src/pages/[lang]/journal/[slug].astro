---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { createSatteriMarkdownProcessor } from '@astrojs/markdown-satteri';
import { photos } from '../../../data/photos';
import Base from '../../../layouts/Base.astro';
import Photo from '../../../components/Photo.astro';
import Poincon from '../../../components/Poincon.astro';
import { languages, useTranslations, route, postUrl, formatDate, absolute, type Lang } from '../../../i18n/utils';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('journal');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => {
      const [lang, ...rest] = post.id.split('/');
      return { params: { lang, slug: rest.join('/') }, props: { post } };
    });
};

const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
/* L'article vient de getStaticPaths ; on le type ici pour que la page soit vérifiable. */
const post = Astro.props.post as CollectionEntry<'journal'>;
const t = useTranslations(lang);
const { Content } = await render(post);
const base = Astro.site ?? new URL('https://yunma.fr');
const canonical = new URL(Astro.url.pathname, base).href;

/* Alternates : uniquement les langues où l'article existe */
const all = await getCollection('journal');
const available = new Set(all.filter((p) => p.id.endsWith(`/${slug}`)).map((p) => p.id.split('/')[0]));
const alternates = Object.fromEntries(
  languages.map((code) => [code, available.has(code) ? postUrl(code, slug) : route(code, 'journal')])
) as Record<Lang, string>;

/* L'illustration de l'article, et non le visuel de partage générique :
   c'est elle que Google Discover et les moteurs de réponse affichent. */
const imageArticle = new URL(
  (await getImage({ src: photos[post.data.photo].src, width: 1200 })).src,
  base
).href;

/* Le corps se coupe aux intertitres, et une photographie se glisse dans chaque
   coupure : l'article n'est plus un seul bloc de texte.

   Les coupures visent des parts égales — pour deux photographies, aux tiers ;
   pour trois, aux quarts — et l'on retient à chaque fois l'intertitre le plus
   proche de la cible. Deux photographies ne peuvent pas tomber au même
   endroit : une coupure déjà prise laisse la place à l'intertitre libre le
   plus proche.

   Moins d'intertitres que de photographies demandées, et les dernières sont
   ignorées : mieux vaut un article un peu plus dense qu'une image collée à la
   précédente. Sans intertitre du tout, le corps reste d'un tenant. */
const couper = (markdown: string, combien: number): string[] => {
  const reperes = [...markdown.matchAll(/^## /gm)].map((m) => m.index ?? 0).filter((i) => i > 0);
  if (reperes.length === 0 || combien === 0) return [markdown];

  const parts = Math.min(combien, reperes.length);
  const pris = new Set<number>();
  const coupes: number[] = [];
  for (let i = 1; i <= parts; i++) {
    const cible = (markdown.length * i) / (parts + 1);
    const libres = reperes.filter((r) => !pris.has(r));
    if (libres.length === 0) break;
    const coupe = libres.reduce((a, b) => (Math.abs(b - cible) < Math.abs(a - cible) ? b : a));
    pris.add(coupe);
    coupes.push(coupe);
  }

  coupes.sort((a, b) => a - b);
  const morceaux: string[] = [];
  let debut = 0;
  for (const c of coupes) {
    morceaux.push(markdown.slice(debut, c));
    debut = c;
  }
  morceaux.push(markdown.slice(debut));
  return morceaux;
};

const illustrations = post.data.photoMilieu;
const morceaux = post.body && illustrations.length > 0 ? couper(post.body, illustrations.length) : [];
const rendus: string[] = [];
if (morceaux.length > 1) {
  const processeur = await createSatteriMarkdownProcessor({});
  for (const m of morceaux) rendus.push((await processeur.render(m)).code);
}
/* Une photographie par coupure, ni plus ni moins : celles qui n'ont pas de
   place restent au placard plutôt que de s'entasser à la fin. */
const posees = rendus.length > 1 ? illustrations.slice(0, rendus.length - 1) : [];

const words = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(2, Math.round(words / (lang === 'zh' ? 300 : 200)));

const jsonld = [
  {
    '@type': 'BlogPosting',
    '@id': `${canonical}#article`,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    inLanguage: t.meta.hreflang,
    keywords: post.data.tags.join(', '),
    wordCount: words,
    author: { '@type': 'Organization', name: post.data.author, url: base.origin },
    publisher: { '@id': `${base.origin}/#organization` },
    mainEntityOfPage: canonical,
    image: imageArticle,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.common.home, item: absolute(Astro.site, `${lang}/`) },
      { '@type': 'ListItem', position: 2, name: t.nav.journal, item: absolute(Astro.site, `${lang}/journal/`) },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
    ],
  },
];
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  type="article"
  alternates={alternates}
  jsonld={jsonld}
  keywords={post.data.tags}
  fil={[{ href: route(lang, 'journal'), label: t.nav.journal }, { label: post.data.title }]}
>
  <article class="post">
    <header class="post__head wrap wrap--narrow">
      <p class="label post__meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
        <span> · {readingTime} {t.common.minRead}</span>
      </p>
      <h1 class="post__title">{post.data.title}</h1>
      <p class="lead muted post__lead">{post.data.description}</p>
    </header>

    <figure class="wrap post__cover">
      <div class="media media--wide">
        <Photo name={post.data.photo} lang={lang} priority sizes="(min-width: 1560px) 1560px, 100vw" />
      </div>
    </figure>

    {
      rendus.length > 1 ? (
        rendus.map((morceau, i) => (
          <>
            <div
              class:list={['wrap', 'wrap--narrow', 'post__body', i > 0 && 'post__body--suite']}
              set:html={morceau}
            />
            {posees[i] && (
              <figure class="wrap post__milieu">
                <div class="media media--wide">
                  <Photo name={posees[i]} lang={lang} sizes="(min-width: 1560px) 1560px, 100vw" />
                </div>
              </figure>
            )}
          </>
        ))
      ) : (
        <div class="wrap wrap--narrow post__body">
          <Content />
        </div>
      )
    }

    {
      post.data.tags.length > 0 && (
        <div class="wrap wrap--narrow">
          <Poincon />
        </div>
      )
    }

    {
      post.data.tags.length > 0 && (
        <footer class="wrap wrap--narrow post__foot">
          <span class="label">{t.journal.tags}</span>
          <ul class="post__tags">
            {post.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          <a class="link" href={route(lang, 'journal')}>
            <span class="arrow" aria-hidden="true">←</span>
            {t.common.backToJournal}
          </a>
        </footer>
      )
    }
  </article>
</Base>

<style>
  .post {
    padding-bottom: var(--section);
  }

  .post__head {
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .post__meta {
    color: var(--ink-50);
  }

  .post__title {
    margin-top: var(--espace-surtitre);
    font-size: clamp(1.85rem, 1.4rem + 2vw, 3rem);
    letter-spacing: -0.022em;
    line-height: 1.1;
  }

  .post__lead {
    margin-top: var(--espace-titre);
  }

  .post__cover {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .post__milieu {
    margin-block: clamp(2.5rem, 6vw, 4rem);
  }

  /* L'intertitre qui ouvre la seconde moitié suit déjà la photographie. */
  .post__body--suite :global(h2:first-child) {
    margin-top: 0;
  }

  .post__body {
    font-size: 1rem;
    line-height: 1.75;
  }

  .post__body :global(p) {
    margin-bottom: 1.4rem;
    max-width: 68ch;
  }

  .post__body :global(h2) {
    margin-top: clamp(2rem, 4vw, 3rem);
    margin-bottom: 0.9rem;
    font-size: var(--fs-h3);
    letter-spacing: -0.015em;
  }

  .post__body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.6rem;
    font-size: 1.0625rem;
  }

  .post__body :global(strong) {
    font-weight: 500;
  }

  .post__body :global(ol),
  .post__body :global(ul) {
    margin-bottom: 1.4rem;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.5rem;
    max-width: 66ch;
  }

  .post__body :global(ol) {
    list-style: decimal;
  }

  .post__body :global(ul) {
    list-style: disc;
  }

  .post__body :global(li)::marker {
    color: var(--accent);
  }

  .post__body :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: 1px solid var(--accent);
    font-size: var(--fs-lead);
    line-height: 1.45;
  }

  .post__body :global(a) {
    border-bottom: 1px solid var(--accent);
  }

  .post__foot {
    display: grid;
    gap: var(--espace-surtitre);
    justify-items: start;
  }

  .post__foot .link {
    margin-top: var(--espace-carte);
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post__tags li {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-70);
  }
</style>
