---
/**
 * /products/{handle}/ — la forme qu'emploie Shopify pour désigner un produit,
 * dans ses courriels de commande comme dans les liens de son thème.
 */
import Passerelle from '../../components/Passerelle.astro';
import { products } from '../../data/products';
import { absolute, productUrl, languages, type Lang } from '../../i18n/utils';

export const prerender = true;

export function getStaticPaths() {
  return products.map((produit) => ({
    params: { handle: produit.shopifyHandle },
    props: { slug: produit.slug, nom: produit.name.fr },
  }));
}

const { slug, nom } = Astro.props;
const destinations = Object.fromEntries(
  languages.map((code) => [code, productUrl(code, slug)]),
) as Record<Lang, string>;
---

<Passerelle
  destinations={destinations}
  canonical={absolute(Astro.site, `fr/cafes/${slug}/`)}
  titre={nom}
/>
