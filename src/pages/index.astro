---
/**
 * Racine : redirection vers la langue de l'utilisateur (français par défaut).
 * Une redirection serveur (_redirects / vercel.json) prend le relais si elle est configurée.
 */
export const prerender = true;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Yunma — Cafés de spécialité du Yunnan</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://yunma.fr/fr/" />
    <link rel="alternate" hreflang="fr-FR" href="https://yunma.fr/fr/" />
    <link rel="alternate" hreflang="en" href="https://yunma.fr/en/" />
    <link rel="alternate" hreflang="zh-Hans" href="https://yunma.fr/zh/" />
    <link rel="alternate" hreflang="x-default" href="https://yunma.fr/fr/" />
    <meta http-equiv="refresh" content="0; url=/fr/" />
    <script is:inline>
      (function () {
        var supported = ['fr', 'en', 'zh'];
        var stored = null;
        try {
          stored = localStorage.getItem('yunma:lang');
        } catch (e) {}
        var nav = (navigator.language || 'fr').toLowerCase();
        var guess = nav.indexOf('zh') === 0 ? 'zh' : nav.indexOf('fr') === 0 ? 'fr' : nav.indexOf('en') === 0 ? 'en' : 'fr';
        var lang = supported.indexOf(stored) > -1 ? stored : guess;
        location.replace('/' + lang + '/');
      })();
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #f4f2ec;
        color: #1c1c1a;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-size: 14px;
        letter-spacing: 0.02em;
      }
      ul {
        display: flex;
        gap: 1.5rem;
        list-style: none;
        padding: 0;
        margin: 1.5rem 0 0;
      }
      a {
        color: #b95f2c;
      }
    </style>
  </head>
  <body>
    <main>
      <img src="/brand/yunma-logo.png" alt="Yunma" width="114" height="171" style="margin-inline:auto" />
      <ul>
        <li><a href="/fr/">Français</a></li>
        <li><a href="/en/">English</a></li>
        <li><a href="/zh/">简体中文</a></li>
      </ul>
    </main>
  </body>
</html>
