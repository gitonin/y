---
/**
 * Racine : redirection vers la langue de l'utilisateur (français par défaut).
 * Une redirection serveur (_redirects / vercel.json) prend le relais si elle est configurée.
 */
import { asset, absolute, languages, dictionaries } from '../i18n/utils';

export const prerender = true;

const base = asset('');
const canonical = absolute(Astro.site, 'fr/');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Yunma — Cafés de spécialité du Yunnan</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    {
      languages.map((code) => (
        <link
          rel="alternate"
          hreflang={dictionaries[code].meta.hreflang}
          href={absolute(Astro.site, `${code}/`)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" href={asset('brand/favicon-96.png')} type="image/png" sizes="96x96" />
    <meta http-equiv="refresh" content={`0; url=${base}fr/`} />
    <script is:inline define:vars={{ base }}>
      (function () {
        var supported = ['fr', 'en', 'zh'];
        var stored = null;
        try {
          stored = localStorage.getItem('yunma:lang');
        } catch (e) {}
        var nav = (navigator.language || 'fr').toLowerCase();
        var guess =
          nav.indexOf('zh') === 0 ? 'zh' : nav.indexOf('fr') === 0 ? 'fr' : nav.indexOf('en') === 0 ? 'en' : 'fr';
        var lang = supported.indexOf(stored) > -1 ? stored : guess;
        location.replace(base + lang + '/');
      })();
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #ebe7de;
        color: #212121;
        font-family: 'Helvetica Neue', Helvetica, Arial, 'Liberation Sans', sans-serif;
        font-size: 14px;
        letter-spacing: 0.02em;
      }
      ul {
        display: flex;
        gap: 1.5rem;
        list-style: none;
        padding: 0;
        margin: 1.5rem 0 0;
      }
      a {
        color: #b95f2c;
      }
    </style>
  </head>
  <body>
    <main>
      <img src={asset('brand/yunma-logo.svg')} alt="Yunma" width="215" height="324" style="margin-inline:auto" />
      <ul>
        {
          languages.map((code) => (
            <li>
              <a href={`${base}${code}/`}>{dictionaries[code].meta.label}</a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
