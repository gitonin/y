---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cart from '../components/Cart.astro';
import Seo from '../components/Seo.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  transparentHeader?: boolean;
  alternates?: Partial<Record<Lang, string>>;
  jsonld?: Record<string, unknown>[];
  type?: 'website' | 'article' | 'product';
  image?: string;
  keywords?: string[];
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  transparentHeader = false,
  alternates,
  jsonld = [],
  type = 'website',
  image,
  keywords,
  noindex,
} = Astro.props;

const t = useTranslations(lang);
---

<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f2ec" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <link rel="icon" href="/brand/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/brand/icon-512.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap"
    />
    <link rel="preload" as="image" href="/brand/yunma-logo.png" />

    <Seo
      lang={lang}
      title={title}
      description={description}
      alternates={alternates}
      jsonld={jsonld}
      type={type}
      image={image}
      keywords={keywords}
      noindex={noindex}
    />

    <ClientRouter />
  </head>

  <body>
    <Header lang={lang} transparent={transparentHeader} />

    <main id="main" class:list={['main', transparentHeader && 'main--flush']}>
      <slot />
    </main>

    <Footer lang={lang} />
    <Cart lang={lang} />

    <style is:global>
      .main {
        position: relative;
        z-index: 2;
        padding-top: var(--header-h);
      }

      .main--flush {
        padding-top: 0;
      }

      /* Transitions de page */
      @view-transition {
        navigation: auto;
      }

      ::view-transition-old(root) {
        animation: yunma-out 0.32s cubic-bezier(0.4, 0, 1, 1) both;
      }

      ::view-transition-new(root) {
        animation: yunma-in 0.42s cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      @keyframes yunma-out {
        to {
          opacity: 0;
        }
      }

      @keyframes yunma-in {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>

    <script>
      /* Révélations au scroll — partagées par toutes les pages */
      let observer: IntersectionObserver | null = null;

      const initReveal = () => {
        const targets = document.querySelectorAll<HTMLElement>('[data-reveal], .reveal-lines, .media');
        if (!('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        observer?.disconnect();
        observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer?.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        targets.forEach((el, i) => {
          if (!el.style.getPropertyValue('--reveal-delay') && el.hasAttribute('data-reveal-stagger')) {
            el.style.setProperty('--reveal-delay', `${(i % 6) * 70}ms`);
          }
          observer!.observe(el);
        });
      };

      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
