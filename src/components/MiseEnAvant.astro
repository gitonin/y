---
/**
 * Mise en avant d'une référence, en pleine largeur et sur photographie.
 * Le ton est celui d'une réclame : une image qui porte, un nom, une phrase,
 * un prix, un bouton. À réserver à une seule référence par page.
 */
import type { Lang } from '../i18n/utils';
import { formatPrice, productUrl, useTranslations } from '../i18n/utils';
import type { Product } from '../data/products';
import { fromPrice, hasPriceRange } from '../data/products';
import Photo from './Photo.astro';

interface Props {
  product: Product;
  lang: Lang;
}
const { product, lang } = Astro.props;
const t = useTranslations(lang);
const prix = fromPrice(product);
const aPartirDe = hasPriceRange(product);
---

<section class="avant">
  <div class="avant__media media">
    <Photo name={product.ambiance} lang={lang} decorative sizes="100vw" />
  </div>

  <div class="avant__inner wrap">
    <span class="label avant__label">{product.subtitle[lang]}</span>
    <h3 class="avant__nom">{product.name[lang]}</h3>
    <p class="avant__texte">{product.short[lang]}</p>
    <p class="avant__prix mono-num">
      {aPartirDe && <span class="avant__from">{t.common.from} </span>}
      {formatPrice(prix, lang)}
    </p>
    <a class="btn avant__cta" href={productUrl(lang, product.slug)}>
      {t.common.discover}
    </a>
  </div>
</section>

<style>
  .avant {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(26rem, 52vw, 34rem);
    padding-block: clamp(2.5rem, 6vw, 4rem);
    overflow: hidden;
  }

  .avant__media {
    position: absolute;
    inset: 0;
  }

  /* Un voile clair du bas vers le haut : le texte se pose à l'encre du site,
     comme partout ailleurs, plutôt qu'en blanc sur une image assombrie. */
  .avant__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      rgba(235, 231, 222, 0.94) 0,
      rgba(235, 231, 222, 0.88) 9rem,
      rgba(235, 231, 222, 0.62) 15rem,
      rgba(235, 231, 222, 0.18) 21rem,
      rgba(235, 231, 222, 0) 27rem
    );
  }

  .avant__inner {
    position: relative;
    z-index: 2;
    color: var(--ink);
    display: grid;
    justify-items: start;
    max-width: min(var(--max), 100%);
  }

  .avant__nom {
    margin-top: var(--espace-surtitre);
    font-size: var(--fs-h2);
    font-weight: var(--w-bold);
    line-height: 1.04;
    letter-spacing: -0.02em;
    max-width: 16ch;
  }

  .avant__texte {
    margin-top: var(--espace-titre);
    line-height: 1.35;
    max-width: 42ch;
  }

  .avant__prix {
    margin-top: 0.75rem;
    font-size: var(--fs-lead);
  }

  .avant__from {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-50);
  }

  .avant__cta {
    margin-top: 1.5rem;
    width: auto;
    padding-inline: 2.5rem;
  }
</style>
