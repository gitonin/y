---
import type { Lang } from '../i18n/utils';
import SplitTitle from './SplitTitle.astro';

interface Props {
  /* Conservé pour l'appel, même si l'entrée de page n'a plus de texte à traduire. */
  lang?: Lang;
  label: string;
  title: string;
  intro?: string;
  size?: 'lg' | 'md';
}
const { label, title, intro, size = 'lg' } = Astro.props;
---

<header class="phero wrap">
  <span class="label phero__label" data-reveal>{label}</span>
  <SplitTitle text={title} as="h1" size={size === 'lg' ? 'xl' : 'lg'} class={`sec-title phero__title phero__title--${size}`} />
  {intro && <p class="lead muted phero__intro" data-reveal>{intro}</p>}
</header>

<style>
  .phero {
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  :global(.phero__title--lg) {
    max-width: 16ch;
  }

  :global(.phero__title--md) {
    max-width: 20ch;
  }

  .phero__intro {
    max-width: 52ch;
  }
</style>
