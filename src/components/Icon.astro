---
/**
 * Icônes Yunma — tracés fins, épaisseur constante, angles arrondis.
 * Dessinées d'après la planche d'iconographie de la charte.
 * À utiliser avec parcimonie : pour rythmer une liste technique ou
 * souligner un engagement, jamais en décoration systématique.
 */
interface Props {
  name: IconName;
  size?: number;
  /** Étiquette accessible — sinon l'icône est décorative et masquée aux lecteurs d'écran. */
  label?: string;
  class?: string;
}

const paths = {
  /* Origine, qualité */
  leaf: ['M20.5 3.5c0 8.6-4.9 13.5-11 13.5a5.5 5.5 0 0 1-5.5-5.5C4 5.4 11.9 3.5 20.5 3.5Z', 'M3.5 20.5 12 12'],
  /* Altitude */
  mountains: ['M2.5 18.5 8 9l4.2 6.4L15 11l6.5 7.5z', 'M8 9l1.6 2.7'],
  /* Récolte — cerises */
  cherries: [
    'M8.2 21.4a3.6 3.6 0 1 0 0-7.2 3.6 3.6 0 0 0 0 7.2Z',
    'M16.7 21.5a3.1 3.1 0 1 0 0-6.2 3.1 3.1 0 0 0 0 6.2Z',
    'M8.2 14.2C8.6 9.9 10.4 6.4 13.7 4',
    'M16.7 15.3c.3-4-.7-7.9-3-11.3',
    'M13.7 4c1.6-1.2 3.5-1.6 5.5-1.1',
  ],
  /* Traitement, eau */
  droplet: ['M12 3.5c3.2 3.6 5.5 6.6 5.5 9.6a5.5 5.5 0 0 1-11 0c0-3 2.3-6 5.5-9.6Z'],
  /* Séchage — lits surélevés et chaleur */
  dry: [
    'M3.5 17h17',
    'M6.2 17v3.6',
    'M17.8 17v3.6',
    'M6.4 12.4c1.1-1.3 2.3-1.3 3.4 0s2.3 1.3 3.4 0 2.3-1.3 3.4 0',
    'M8.6 7.6c.9-1.1 1.9-1.1 2.8 0s1.9 1.1 2.8 0',
  ],
  /* Tri */
  funnel: ['M3.5 5h17l-6.5 7.7V20l-4 1.5v-8.8L3.5 5Z'],
  /* Torréfaction — grain */
  bean: [
    'M7.2 5.1A5.4 8.4 -35 0 1 16.8 18.9 5.4 8.4 -35 0 1 7.2 5.1Z',
    'M10 15.4c1-1.2 1.2-2.5 2.1-3.9s1.9-2.3 2.2-3.6',
  ],
  /* Dégustation — tasse */
  cup: [
    'M4.5 8.5H16V13a5.5 5.5 0 0 1-5.5 5.5h-.5A5.5 5.5 0 0 1 4.5 13V8.5Z',
    'M16 10h1.3a2.8 2.8 0 0 1 0 5.6H16',
    'M3 21.5h15',
  ],
  /* Relations directes */
  community: [
    'M9 11.5a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z',
    'M16.8 11.2a2.8 2.8 0 1 0 0-5.6 2.8 2.8 0 0 0 0 5.6Z',
    'M2.5 19.8c0-3.6 2.9-6.3 6.5-6.3s6.5 2.7 6.5 6.3',
    'M17 13.7c2.7.3 4.5 2.6 4.5 5.5',
  ],
  /* Juste mesure, durabilité */
  sprout: [
    'M12 21.5V13',
    'M12 13c-3.6 0-6-2.3-6-5.7 3.6 0 6 2.3 6 5.7Z',
    'M12 13c0-3.9 2.4-6.3 6-6.3 0 3.9-2.4 6.3-6 6.3Z',
  ],
  /* Accompagnement, guide */
  book: [
    'M3.5 5.5h5.2A3.3 3.3 0 0 1 12 8.8v11a3.3 3.3 0 0 0-3.3-3.3H3.5V5.5Z',
    'M20.5 5.5h-5.2A3.3 3.3 0 0 0 12 8.8v11a3.3 3.3 0 0 1 3.3-3.3h5.2V5.5Z',
  ],
  /* Durée d'infusion — chronomètre */
  timer: [
    'M12 21a7.8 7.8 0 1 0 0-15.6A7.8 7.8 0 0 0 12 21Z',
    'M12 9.4v3.8l2.6 1.7',
    'M9.8 2.6h4.4',
    'M12 2.6v2.8',
  ],
  /* Paiement sécurisé */
  lock: ['M5.5 10.5h13v10h-13z', 'M8.5 10.5V7a3.5 3.5 0 0 1 7 0v3.5'],
} as const;

export type IconName = keyof typeof paths;

const { name, size = 20, label, class: className = '' } = Astro.props;
const d = paths[name];
---

<svg
  class={`icon ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {d.map((path) => <path d={path} />)}
</svg>

<style>
  .icon {
    display: block;
    flex: none;
    overflow: visible;
  }
</style>
