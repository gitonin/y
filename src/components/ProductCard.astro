---
import type { Lang } from '../i18n/utils';
import { formatPrice, productUrl, useTranslations } from '../i18n/utils';
import type { Product } from '../data/products';
import { fromPrice, hasPriceRange } from '../data/products';
import Packshot from './Packshot.astro';

interface Props {
  product: Product;
  lang: Lang;
  index?: number;
  compact?: boolean;
}
const { product, lang, index = 0, compact = false } = Astro.props;
const t = useTranslations(lang);
/* Plusieurs formats à des prix différents : on annonce le plus bas, sans le laisser
   passer pour le prix unique. */
const price = fromPrice(product);
const aPartirDe = hasPriceRange(product);
---

<article class:list={['pcard', compact && 'pcard--compact']} data-reveal style={`--reveal-delay:${(index % 3) * 90}ms`}>
  <a class="pcard__link media-link" href={productUrl(lang, product.slug)}>
    <div class="media pcard__media">
      <Packshot product={product} lang={lang} size={compact ? 'sm' : 'md'} decorative />
    </div>
    <div class="pcard__body">
      <h3 class="pcard__name">{product.name[lang]}</h3>
      <p class="pcard__sub muted small">{product.subtitle[lang]}</p>
      {!compact && <p class="pcard__notes small">{product.short[lang]}</p>}
      <p class="pcard__price mono-num">
        {aPartirDe && <span class="pcard__from">{t.common.from} </span>}
        {formatPrice(price, lang)}
      </p>
    </div>
  </a>
</article>

<style>
  .pcard__link {
    display: block;
  }

  .pcard__media {
    background: none;
  }

  .pcard__media :global(.shot) {
    transform: none;
  }

  .pcard__from {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-50);
  }

  .pcard__body {
    padding-top: 1rem;
    display: grid;
    gap: 0.2rem;
  }

  /* Le nom du produit est un titre : encre du site, gras, un point de moins.
     L'orange reste aux liens, où il signale l'action. */
  .pcard__name {
    font-size: 1rem;
    font-weight: var(--w-bold);
    letter-spacing: -0.014em;
    color: var(--ink);
    transition: color 0.4s var(--ease);
  }

  .pcard--compact .pcard__name {
    font-size: 0.8125rem;
  }

  .pcard__link:hover .pcard__name {
    color: var(--accent);
  }

  .pcard__notes {
    color: var(--ink-70);
    margin-top: 0.35rem;
  }

  .pcard__price {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
  }
</style>
