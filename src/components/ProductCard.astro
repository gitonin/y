---
import type { Lang } from '../i18n/utils';
import { productUrl, useTranslations } from '../i18n/utils';
import type { Product } from '../data/products';
import Packshot from './Packshot.astro';
import Prix from './Prix.astro';

interface Props {
  product: Product;
  lang: Lang;
  index?: number;
  compact?: boolean;
}
const { product, lang, index = 0, compact = false } = Astro.props;
const t = useTranslations(lang);

/* La grille dit la vérité : un café dont plus aucun format n'est disponible
   porte sa mention dès la vitrine, plutôt que de la réserver à la fiche. */
const epuise = product.variants.every((v) => !v.available);
---

<article class:list={['pcard', compact && 'pcard--compact']} data-reveal style={`--reveal-delay:${(index % 3) * 90}ms`}>
  <a class="pcard__link media-link" href={productUrl(lang, product.slug)}>
    <div class="media pcard__media" transition:name={`packshot-${product.slug}`}>
      <Packshot product={product} lang={lang} size={compact ? 'sm' : 'md'} decorative />
    </div>
    <div class="pcard__body">
      <h3 class="pcard__name">{product.name[lang]}</h3>
      <p class="pcard__sub muted small">{product.subtitle[lang]}</p>
      {!compact && <p class="pcard__notes small">{product.short[lang]}</p>}
      <Prix product={product} lang={lang} class="pcard__price" />
      {epuise && <p class="label pcard__rupture">{t.product.rupture.badge}</p>}
    </div>
  </a>
</article>

<style>
  .pcard__link {
    display: block;
  }

  .pcard__media {
    background: none;
  }

  /* Le visuel ne se déforme pas au repos ; il avance à peine quand la carte
     est survolée, juste assez pour dire qu'elle est cliquable. */
  .pcard__media :global(.shot) {
    transform: none;
    transition: transform 0.9s var(--ease-out-expo);
  }

  .pcard__link:hover .pcard__media :global(.shot) {
    transform: scale(1.025);
  }

  @media (prefers-reduced-motion: reduce) {
    .pcard__media :global(.shot) {
      transition: none;
    }

    .pcard__link:hover .pcard__media :global(.shot) {
      transform: none;
    }
  }

  .pcard__body {
    padding-top: 1rem;
    display: grid;
    gap: 0.2rem;
  }

  /* Le nom du produit est un titre : encre du site, semi-gras, un point de moins.
     L'orange reste aux liens, où il signale l'action. */
  .pcard__name {
    font-size: 1rem;
    font-family: var(--font-titre);
    font-weight: var(--w-semi);
    letter-spacing: -0.014em;
    color: var(--ink);
    transition: color 0.4s var(--ease);
  }

  .pcard--compact .pcard__name {
    font-size: 0.8125rem;
  }

  .pcard__link:hover .pcard__name {
    color: var(--accent);
  }

  /* Interlignage resserré : ces descriptions tiennent en deux ou trois lignes,
     elles n'ont pas besoin de l'aération d'un paragraphe courant. */
  .pcard__sub,
  .pcard__notes {
    line-height: 1.35;
  }

  .pcard__notes {
    color: var(--ink-70);
    margin-top: 0.35rem;
  }

  :global(.pcard__price) {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
  }

  /* La mention se pose sous le prix, dans l'orange foncé des libellés actifs.
     Elle informe, elle ne barre rien : le café reste désirable, il est
     simplement en attente de sa prochaine torréfaction. */
  .pcard__rupture {
    margin-top: 0.35rem;
    color: var(--accent-deep);
  }

  /* Sur un écran de bureau, la carte a de la place et le lecteur du recul : les
     quatre lignes gagnent deux points. Sur mobile, où la carte est déjà près de
     l'œil et la largeur comptée, elles gardent leur taille. */
  @media (min-width: 900px) {
    .pcard__name {
      font-size: 1.125rem;
    }

    .pcard--compact .pcard__name {
      font-size: 0.9375rem;
    }

    .pcard__sub,
    .pcard__notes {
      font-size: 0.9375rem;
    }

    :global(.pcard__price) {
      font-size: 0.9375rem;
    }
  }
</style>
