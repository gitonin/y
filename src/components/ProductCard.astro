---
import type { Lang } from '../i18n/utils';
import { formatPrice, productUrl, useTranslations } from '../i18n/utils';
import type { Product } from '../data/products';
import { fromPrice, hasPriceRange } from '../data/products';
import Packshot from './Packshot.astro';

interface Props {
  product: Product;
  lang: Lang;
  index?: number;
  compact?: boolean;
  /** Produit mis en avant : visuel et texte côte à côte, sur toute la largeur. */
  feature?: boolean;
}
const { product, lang, index = 0, compact = false, feature = false } = Astro.props;
const t = useTranslations(lang);
/* Plusieurs formats à des prix différents : on annonce le plus bas, sans le laisser
   passer pour le prix unique. */
const price = fromPrice(product);
const aPartirDe = hasPriceRange(product);
---

<article
  class:list={['pcard', compact && 'pcard--compact', feature && 'pcard--feature']}
  data-reveal
  style={`--reveal-delay:${(index % 3) * 90}ms`}
>
  <a class="pcard__link media-link" href={productUrl(lang, product.slug)}>
    <div class="media pcard__media bleed-mobile">
      <Packshot product={product} lang={lang} size={feature ? 'lg' : compact ? 'sm' : 'md'} decorative />
    </div>
    <div class="pcard__body">
      <h3 class="pcard__name">{product.name[lang]}</h3>
      <p class="pcard__sub muted small">{product.subtitle[lang]}</p>
      {!compact && <p class="pcard__notes small">{product.short[lang]}</p>}
      {feature && <p class="pcard__story muted">{product.description[lang]}</p>}
      <p class="pcard__price mono-num">
        {aPartirDe && <span class="pcard__from">{t.common.from} </span>}
        {formatPrice(price, lang)}
      </p>
      {feature && (
        <span class="link pcard__cta">
          {t.common.discover}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </span>
      )}
    </div>
  </a>
</article>

<style>
  .pcard__link {
    display: block;
  }

  .pcard__media {
    background: none;
  }

  .pcard__media :global(.shot) {
    transform: none;
  }

  .pcard__from {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-50);
  }

  .pcard__body {
    padding-top: 1rem;
    display: grid;
    gap: 0.2rem;
  }

  .pcard__name {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    color: var(--accent);
    transition: color 0.4s var(--ease);
  }

  .pcard--compact .pcard__name {
    font-size: 0.875rem;
    color: var(--ink);
  }

  .pcard__link:hover .pcard__name {
    color: var(--accent-deep);
  }

  .pcard__notes {
    color: var(--ink-70);
    margin-top: 0.35rem;
  }

  .pcard__price {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
  }

  /* ---------- Produit mis en avant ---------- */
  .pcard--feature .pcard__link {
    display: grid;
    gap: clamp(1rem, 3vw, 3rem);
    align-items: center;
  }

  @media (min-width: 800px) {
    .pcard--feature .pcard__link {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  .pcard--feature .pcard__body {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }

  .pcard--feature .pcard__name {
    font-size: var(--fs-h3);
    font-weight: var(--w-bold);
    letter-spacing: -0.016em;
  }

  .pcard__story {
    margin-top: 0.75rem;
    max-width: 46ch;
  }

  .pcard--feature .pcard__price {
    margin-top: 0.75rem;
    font-size: var(--fs-lead);
  }

  .pcard__cta {
    margin-top: 1rem;
  }
</style>
