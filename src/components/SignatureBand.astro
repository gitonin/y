---
/**
 * Signature défilante, en bas de chaque page.
 * Le motif « Slow Coffee ✦ Slow Life » glisse en continu, sans couture : la
 * piste contient deux groupes identiques et se décale de la moitié de sa
 * largeur, si bien que le second groupe prend exactement la place du premier
 * au moment où l'animation reboucle.
 */
import type { Lang } from '../i18n/utils';
import { useTranslations, asset } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Sur fond sombre, le lettrage passe en clair. */
  dark?: boolean;
}
const { lang, dark = false } = Astro.props;
const t = useTranslations(lang);

/* Assez de répétitions pour couvrir les très larges écrans sans laisser de vide. */
const motifs = Array.from({ length: 10 });
/* Le lettrage de la signature est fourni tracé : l'étoile et la typographie
   sont celles de la marque, identiques d'une langue à l'autre. */
const signe = asset(dark ? 'brand/yunma-signature-clair.svg' : 'brand/yunma-signature.svg');
const lecture = `${t.common.signatureStart} — ${t.common.signatureEnd}`;
---

<div class="sig">
  <p class="visually-hidden">{lecture}</p>

  <div class="sig__piste" aria-hidden="true">
    {
      [0, 1].map(() => (
        <div class="sig__groupe">
          {motifs.map(() => (
            <span class="sig__motif">
              <img class="sig__signe" src={signe} alt="" width="1118" height="157" loading="lazy" />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .sig {
    overflow: hidden;
    padding-block: clamp(1.75rem, 4vw, 3rem);
  }

  .sig__piste {
    display: flex;
    width: max-content;
    /* La piste s'élargit avec le corps du texte : on allonge la durée à
       l'avenant pour garder la même vitesse apparente, environ 25 px par
       seconde, du téléphone au grand écran. */
    animation: defiler 100s linear infinite;
  }

  @media (min-width: 900px) {
    .sig__piste {
      animation-duration: 160s;
    }
  }

  .sig__groupe {
    display: flex;
  }

  .sig__motif {
    display: inline-flex;
    align-items: center;
    /* Un large blanc sépare les répétitions entre elles. */
    padding-right: clamp(4rem, 9vw, 9rem);
    font-size: clamp(1.05rem, 0.85rem + 0.7vw, 1.5rem);
    line-height: 1.2;
    white-space: nowrap;
  }

  /* Le lettrage est un tracé, pas du texte : sa hauteur totale dépasse celle
     des capitales, d'où le rapport appliqué au corps de référence. */
  .sig__signe {
    flex: none;
    display: block;
    height: 1.34em;
    width: auto;
  }

  @keyframes defiler {
    to {
      transform: translateX(-50%);
    }
  }
</style>
