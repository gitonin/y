---
/**
 * Visuels de marque — illustrations vectorielles générées.
 * Elles occupent l'emplacement des photographies : remplacez simplement
 * <Scene /> par une <img> lorsque les visuels définitifs sont disponibles.
 */
interface Props {
  variant?: 'ridges' | 'terraces' | 'cherries' | 'canopy' | 'counter' | 'portrait';
  class?: string;
  tone?: 'warm' | 'cool' | 'deep';
}
const { variant = 'ridges', class: className = '', tone = 'warm' } = Astro.props;
const uid = `s${Math.random().toString(36).slice(2, 8)}`;

const palettes = {
  warm: ['#efe9dd', '#dcd3c1', '#bdb49f', '#8d8974', '#5d5f4c', '#3a3d31'],
  cool: ['#e8e8e2', '#d2d5cb', '#adb2a5', '#7f867a', '#565e52', '#333a32'],
  deep: ['#dfd8c8', '#b9b09a', '#8b8570', '#5f5f4d', '#3f4235', '#262922'],
} as const;
const c = palettes[tone];

/** Générateur pseudo-aléatoire déterministe (rendu identique à chaque build). */
function rng(seed: number) {
  let state = seed >>> 0;
  return () => {
    state = (state * 1664525 + 1013904223) >>> 0;
    return state / 4294967296;
  };
}
const rand = rng(variant === 'cherries' ? 7411 : 2205);
const cherries = Array.from({ length: 76 }).map(() => {
  const r = 22 + rand() * 40;
  return {
    x: -40 + rand() * 1280,
    y: 40 + rand() * 840,
    r,
    fill: ['#a63f27', '#b8532f', '#8d3524', '#c86b33', '#732f21', '#9a4526'][Math.floor(rand() * 6)],
    hi: r * 0.28,
  };
});
const leaves = Array.from({ length: 34 }).map(() => ({
  x: rand() * 1200,
  y: rand() * 900,
  rot: rand() * 180,
  rx: 34 + rand() * 26,
}));
---

<svg
  class={`scene ${className}`}
  viewBox="0 0 1200 900"
  preserveAspectRatio="xMidYMid slice"
  role="presentation"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={`${uid}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color={c[0]} />
      <stop offset="60%" stop-color={c[1]} />
      <stop offset="100%" stop-color={c[2]} />
    </linearGradient>
    <linearGradient id={`${uid}-fade`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.55" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>
    <filter id={`${uid}-blur`} x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="34" />
    </filter>
    <filter id={`${uid}-grain`}>
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" />
      <feColorMatrix type="saturate" values="0" />
      <feComponentTransfer><feFuncA type="linear" slope="0.14" /></feComponentTransfer>
    </filter>
  </defs>

  <rect width="1200" height="900" fill={`url(#${uid}-sky)`} />

  {variant === 'ridges' && (
    <g>
      <circle cx="905" cy="215" r="92" fill="#ffffff" opacity="0.42" />
      <circle cx="905" cy="215" r="150" fill="#ffffff" opacity="0.14" filter={`url(#${uid}-blur)`} />
      <path
        d="M0 486 C 130 420 210 356 320 388 C 430 420 486 334 596 352 C 706 370 772 300 892 340 C 992 374 1084 332 1200 366 L1200 900 L0 900 Z"
        fill={c[2]}
        opacity="0.9"
      />
      <ellipse cx="560" cy="470" rx="720" ry="46" fill="#ffffff" opacity="0.55" filter={`url(#${uid}-blur)`} />
      <path
        d="M0 588 C 150 534 236 462 356 496 C 476 530 546 438 668 470 C 796 504 884 428 1014 470 C 1104 498 1152 478 1200 494 L1200 900 L0 900 Z"
        fill={c[3]}
        opacity="0.94"
      />
      <ellipse cx="700" cy="572" rx="700" ry="40" fill="#ffffff" opacity="0.48" filter={`url(#${uid}-blur)`} />
      <path
        d="M0 692 C 170 640 268 588 408 620 C 548 652 628 570 768 602 C 908 634 1020 582 1200 622 L1200 900 L0 900 Z"
        fill={c[4]}
      />
      <ellipse cx="420" cy="686" rx="620" ry="34" fill="#ffffff" opacity="0.34" filter={`url(#${uid}-blur)`} />
      <path
        d="M0 806 C 210 764 330 704 492 734 C 654 764 772 704 932 734 C 1058 758 1136 744 1200 754 L1200 900 L0 900 Z"
        fill={c[5]}
      />
    </g>
  )}

  {variant === 'terraces' && (
    <g>
      <path d="M0 420 L220 320 L470 428 L700 330 L940 440 L1200 356 L1200 900 L0 900 Z" fill={c[2]} />
      <path d="M0 540 L240 452 L520 552 L780 462 L1020 556 L1200 500 L1200 900 L0 900 Z" fill={c[3]} />
      <g stroke={c[5]} stroke-opacity="0.3" fill="none" stroke-width="3">
        <path d="M-40 620 Q 300 566 640 622 T 1240 616" />
        <path d="M-40 676 Q 320 618 660 680 T 1240 668" />
        <path d="M-40 734 Q 280 676 620 740 T 1240 724" />
        <path d="M-40 794 Q 340 736 680 800 T 1240 784" />
        <path d="M-40 854 Q 300 796 640 858 T 1240 844" />
      </g>
      <g fill={c[5]} opacity="0.45">
        {Array.from({ length: 46 }).map((_, i) => (
          <circle cx={(i * 137) % 1200} cy={640 + ((i * 53) % 230)} r={3 + ((i * 7) % 4)} />
        ))}
      </g>
      <ellipse cx="600" cy="470" rx="700" ry="46" fill="#ffffff" opacity="0.5" filter={`url(#${uid}-blur)`} />
    </g>
  )}

  {variant === 'cherries' && (
    <g>
      <rect width="1200" height="900" fill={c[5]} />
      <g>
        {leaves.map((l) => (
          <ellipse
            cx={l.x}
            cy={l.y}
            rx={l.rx}
            ry={l.rx * 0.34}
            fill={c[4]}
            opacity="0.7"
            transform={`rotate(${l.rot} ${l.x} ${l.y})`}
          />
        ))}
      </g>
      <g>
        {cherries.map((ch) => (
          <g>
            <circle cx={ch.x} cy={ch.y} r={ch.r} fill={ch.fill} />
            <circle cx={ch.x - ch.r * 0.3} cy={ch.y - ch.r * 0.34} r={ch.hi} fill="#ffffff" opacity="0.2" />
          </g>
        ))}
      </g>
      <ellipse cx="600" cy="880" rx="760" ry="150" fill={c[5]} opacity="0.55" filter={`url(#${uid}-blur)`} />
      <ellipse cx="180" cy="60" rx="460" ry="130" fill="#ffffff" opacity="0.16" filter={`url(#${uid}-blur)`} />
    </g>
  )}

  {variant === 'canopy' && (
    <g>
      <rect width="1200" height="900" fill={c[4]} />
      <g stroke={c[5]} stroke-width="6" fill="none" opacity="0.75">
        {Array.from({ length: 9 }).map((_, i) => (
          <path d={`M${-100 + i * 160} 940 C ${60 + i * 160} 620, ${180 + i * 160} 420, ${40 + i * 160} 60`} />
        ))}
      </g>
      <g fill={c[2]} opacity="0.8">
        {Array.from({ length: 40 }).map((_, i) => {
          const x = 40 + ((i * 173) % 1120);
          const y = 60 + ((i * 211) % 800);
          return <ellipse cx={x} cy={y} rx="46" ry="16" transform={`rotate(${(i * 37) % 180} ${x} ${y})`} />;
        })}
      </g>
      <ellipse cx="600" cy="450" rx="620" ry="300" fill="#ffffff" opacity="0.14" filter={`url(#${uid}-blur)`} />
    </g>
  )}

  {variant === 'counter' && (
    <g>
      {/* Mur du fond */}
      <rect width="1200" height="900" fill={c[1]} />
      <rect y="0" width="1200" height="560" fill={c[2]} opacity="0.45" />

      {/* Étagère + bocaux */}
      <rect x="120" y="330" width="420" height="8" rx="4" fill={c[4]} opacity="0.5" />
      <g fill={c[4]} opacity="0.55">
        <rect x="150" y="272" width="46" height="58" rx="6" />
        <rect x="214" y="286" width="38" height="44" rx="6" />
        <rect x="268" y="262" width="52" height="68" rx="6" />
        <rect x="336" y="290" width="34" height="40" rx="6" />
        <rect x="386" y="276" width="44" height="54" rx="6" />
      </g>

      {/* Suspensions */}
      <g stroke={c[4]} stroke-width="3" opacity="0.65">
        <line x1="760" y1="0" x2="760" y2="150" />
        <line x1="900" y1="0" x2="900" y2="196" />
        <line x1="1040" y1="0" x2="1040" y2="122" />
      </g>
      <g fill={c[5]} opacity="0.8">
        <path d="M716 150 h88 l24 46 h-136 z" />
        <path d="M856 196 h88 l24 46 h-136 z" />
        <path d="M996 122 h88 l24 46 h-136 z" />
      </g>
      <g fill="#f4efe2" opacity="0.5">
        <ellipse cx="760" cy="212" rx="86" ry="26" filter={`url(#${uid}-blur)`} />
        <ellipse cx="900" cy="258" rx="86" ry="26" filter={`url(#${uid}-blur)`} />
        <ellipse cx="1040" cy="184" rx="86" ry="26" filter={`url(#${uid}-blur)`} />
      </g>

      {/* Machine espresso */}
      <g>
        <rect x="742" y="392" width="230" height="118" rx="10" fill={c[5]} />
        <rect x="762" y="412" width="80" height="34" rx="5" fill={c[3]} opacity="0.85" />
        <rect x="880" y="412" width="72" height="18" rx="5" fill={c[3]} opacity="0.6" />
        <rect x="792" y="510" width="18" height="30" rx="4" fill={c[5]} />
        <rect x="768" y="536" width="66" height="8" rx="4" fill={c[5]} />
      </g>

      {/* Comptoir */}
      <rect x="0" y="556" width="1200" height="26" fill={c[5]} />
      <rect x="0" y="582" width="1200" height="318" fill={c[3]} />
      <g stroke={c[4]} stroke-width="2" opacity="0.5">
        <line x1="240" y1="582" x2="240" y2="900" />
        <line x1="640" y1="582" x2="640" y2="900" />
        <line x1="1000" y1="582" x2="1000" y2="900" />
      </g>

      {/* Tasse + sachet posés */}
      <g fill={c[4]}>
        <path d="M300 500 h74 a6 6 0 0 1 6 6 v22 a34 34 0 0 1 -34 34 h-18 a34 34 0 0 1 -34 -34 v-22 a6 6 0 0 1 6 -6 z" />
        <path d="M382 512 a20 20 0 0 1 0 34" fill="none" stroke={c[4]} stroke-width="8" />
        <rect x="450" y="452" width="96" height="104" rx="6" opacity="0.75" />
      </g>

      <ellipse cx="600" cy="300" rx="760" ry="230" fill="#ffffff" opacity="0.14" filter={`url(#${uid}-blur)`} />
    </g>
  )}

  {variant === 'portrait' && (
    <g>
      {/* Ciel et crêtes lointaines */}
      <path
        d="M0 430 C 150 380 250 336 380 366 C 510 396 590 330 720 362 C 850 394 960 344 1200 384 L1200 900 L0 900 Z"
        fill={c[2]}
        opacity="0.85"
      />
      <ellipse cx="520" cy="424" rx="700" ry="42" fill="#ffffff" opacity="0.5" filter={`url(#${uid}-blur)`} />
      <path
        d="M0 536 C 180 492 300 452 460 482 C 620 512 740 460 900 492 C 1020 516 1120 502 1200 514 L1200 900 L0 900 Z"
        fill={c[3]}
      />

      {/* Plantation */}
      <path d="M0 640 C 240 610 480 632 720 618 C 940 606 1080 626 1200 616 L1200 900 L0 900 Z" fill={c[4]} />
      <g fill={c[5]} opacity="0.55">
        {leaves.map((l) => (
          <ellipse cx={l.x} cy={660 + (l.y % 230)} rx={l.rx * 0.5} ry={l.rx * 0.34} />
        ))}
      </g>

      {/* Deux silhouettes de dos, chapeaux de paille */}
      <g fill={c[5]}>
        <path d="M470 686 c 0 -74 40 -116 96 -116 s 96 42 96 116 l 0 214 -192 0 z" />
        <circle cx="566" cy="520" r="46" />
        <path d="M486 524 c 0 -22 36 -40 80 -40 s 80 18 80 40 c 0 8 -36 14 -80 14 s -80 -6 -80 -14 z" />
        <path d="M700 712 c 0 -66 36 -104 86 -104 s 86 38 86 104 l 0 188 -172 0 z" />
        <circle cx="786" cy="562" r="41" />
        <path d="M714 566 c 0 -20 32 -36 72 -36 s 72 16 72 36 c 0 7 -32 12 -72 12 s -72 -5 -72 -12 z" />
      </g>

      {/* Paniers de cerises */}
      <g fill={c[4]}>
        <path d="M604 800 h96 l-12 92 h-72 z" />
        <path d="M842 826 h84 l-10 74 h-64 z" />
      </g>
      <g fill="#a63f27" opacity="0.85">
        <circle cx="628" cy="806" r="9" />
        <circle cx="652" cy="800" r="10" />
        <circle cx="676" cy="808" r="8" />
        <circle cx="862" cy="832" r="8" />
        <circle cx="886" cy="828" r="9" />
      </g>

      <ellipse cx="600" cy="600" rx="720" ry="70" fill="#ffffff" opacity="0.26" filter={`url(#${uid}-blur)`} />
    </g>
  )}

  <rect width="1200" height="900" filter={`url(#${uid}-grain)`} opacity="0.5" style="mix-blend-mode:multiply" />
  <rect width="1200" height="240" fill={`url(#${uid}-fade)`} opacity="0.5" />
</svg>

<style>
  .scene {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
