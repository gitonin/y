---
import type { Lang } from '../i18n/utils';
import { useTranslations, route } from '../i18n/utils';
import { SHOPIFY, SITE } from '../consts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const config = {
  domain: SHOPIFY.domain,
  token: SHOPIFY.token,
  apiVersion: '2024-10',
  lang,
  currency: SITE.currency,
  strings: {
    empty: t.cart.empty,
    total: t.cart.total,
    checkout: t.cart.checkout,
    notice: t.cart.notice,
    added: t.common.added,
    error: t.common.error,
    shopSoon: t.common.shopSoon,
    remove: t.nav.close,
  },
};
---

<script type="application/json" id="yunma-config" set:html={JSON.stringify(config)} is:inline />

<div class="cart" data-cart hidden>
  <div class="cart__scrim" data-cart-close></div>
  <aside class="cart__panel" role="dialog" aria-modal="true" aria-label={t.cart.title}>
    <header class="cart__head">
      <span class="label">{t.cart.title}</span>
      <button type="button" class="cart__close" data-cart-close>
        <svg viewBox="0 0 22 22" aria-hidden="true"
          ><path d="M3 3l16 16M19 3L3 19" stroke="currentColor" stroke-width="1.2" /></svg
        >
        <span class="visually-hidden">{t.nav.close}</span>
      </button>
    </header>

    <div class="cart__body" data-cart-body>
      <p class="cart__empty muted" data-cart-empty>{t.cart.empty}</p>
      <ul class="cart__lines" data-cart-lines></ul>
    </div>

    <footer class="cart__foot">
      <div class="cart__total">
        <span class="label">{t.cart.total}</span>
        <span class="cart__amount mono-num" data-cart-total>—</span>
      </div>
      <p class="cart__notice small muted">{t.cart.notice}</p>
      <p class="cart__demo small" data-cart-demo hidden>{t.common.shopSoon}</p>
      <a class="btn" href="#" data-cart-checkout>{t.cart.checkout}</a>
      <button class="cart__continue small" type="button" data-cart-close>{t.cart.continue}</button>
      <a class="cart__help small muted" href={route(lang, 'faq')}>{t.nav.faq}</a>
    </footer>
  </aside>
</div>

<div class="toast" data-toast role="status" aria-live="polite"></div>

<style>
  .cart {
    position: fixed;
    inset: 0;
    z-index: 120;
  }

  .cart[hidden] {
    display: none;
  }

  .cart__scrim {
    position: absolute;
    inset: 0;
    background: rgba(28, 28, 26, 0.34);
    opacity: 0;
    transition: opacity 0.5s var(--ease);
    backdrop-filter: blur(2px);
  }

  .cart.is-open .cart__scrim {
    opacity: 1;
  }

  .cart__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(420px, 100%);
    background: var(--paper);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.65s var(--ease-out-expo);
    box-shadow: -30px 0 60px -40px rgba(28, 28, 26, 0.5);
  }

  .cart.is-open .cart__panel {
    transform: none;
  }

  .cart__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem var(--gutter);
    border-bottom: 1px solid var(--line-soft);
    flex: none;
  }

  .cart__close svg {
    width: 16px;
    height: 16px;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .cart__close:hover svg {
    transform: rotate(90deg);
  }

  .cart__body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem var(--gutter);
  }

  .cart__empty {
    padding-block: 2rem;
  }

  .cart__lines {
    display: grid;
    gap: 1.25rem;
  }

  .cart__lines:empty {
    display: none;
  }

  .cart__foot {
    flex: none;
    padding: 1.25rem var(--gutter) calc(1.25rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line-soft);
    display: grid;
    gap: 0.75rem;
  }

  .cart__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .cart__amount {
    font-size: 1.125rem;
  }

  .cart__demo {
    color: var(--accent);
  }

  .cart__continue,
  .cart__help {
    justify-self: center;
    color: var(--ink-50);
    text-align: center;
  }

  .cart__continue:hover {
    color: var(--ink);
  }

  /* Ligne panier */
  :global(.cline) {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    gap: 0.9rem;
    align-items: start;
  }

  :global(.cline__thumb) {
    aspect-ratio: 4 / 5;
    background: var(--paper-2);
    display: grid;
    place-items: center;
  }

  :global(.cline__thumb img) {
    width: 42%;
    opacity: 0.75;
  }

  :global(.cline__title) {
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  :global(.cline__meta) {
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-50);
    margin-top: 0.25rem;
  }

  :global(.cline__qty) {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    border: 1px solid var(--line);
    padding: 0.15rem 0.5rem;
  }

  :global(.cline__qty button) {
    line-height: 1;
    color: var(--ink-50);
    padding: 0.2rem;
  }

  :global(.cline__qty button:hover) {
    color: var(--ink);
  }

  :global(.cline__price) {
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  :global(.cline__remove) {
    display: block;
    margin-top: 0.5rem;
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-30);
  }

  :global(.cline__remove:hover) {
    color: var(--accent);
  }

  /* Toast */
  .toast {
    position: fixed;
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    z-index: 130;
    transform: translate(-50%, 130%);
    opacity: 0;
    pointer-events: none;
    background: var(--ink);
    color: var(--paper);
    padding: 0.85rem 1.25rem;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    border-radius: 2px;
    transition:
      transform 0.6s var(--ease-out-expo),
      opacity 0.4s var(--ease);
    max-width: calc(100vw - 2rem);
    text-align: center;
  }

  .toast.is-visible {
    transform: translate(-50%, 0);
    opacity: 1;
  }
</style>

<script>
  type Line = {
    id: string;
    quantity: number;
    title: string;
    variantTitle: string;
    amount: number;
    currency: string;
    url?: string;
  };

  type Config = {
    domain: string;
    token: string;
    apiVersion: string;
    lang: 'fr' | 'en' | 'zh';
    currency: string;
    strings: Record<string, string>;
  };

  const STORAGE_KEY = 'yunma:cart-id';
  const DEMO_KEY = 'yunma:cart-demo';

  let cfg: Config | null = null;
  let checkoutUrl = '';
  let lines: Line[] = [];
  let bound = false;

  const readConfig = (): Config | null => {
    const el = document.getElementById('yunma-config');
    if (!el?.textContent) return null;
    try {
      return JSON.parse(el.textContent) as Config;
    } catch {
      return null;
    }
  };

  const isLive = () => !!(cfg?.domain && cfg?.token);

  const money = (amount: number, currency: string) => {
    const locales = { fr: 'fr-FR', en: 'en-GB', zh: 'zh-CN' } as const;
    return new Intl.NumberFormat(locales[cfg?.lang ?? 'fr'], {
      style: 'currency',
      currency: currency || cfg?.currency || 'EUR',
    }).format(amount);
  };

  const toast = (message: string) => {
    const el = document.querySelector<HTMLElement>('[data-toast]');
    if (!el) return;
    el.textContent = message;
    el.classList.add('is-visible');
    window.clearTimeout((el as any)._t);
    (el as any)._t = window.setTimeout(() => el.classList.remove('is-visible'), 2600);
  };

  /* ---------------- Storefront API ---------------- */
  const CART_FIELDS = `
    id
    checkoutUrl
    totalQuantity
    cost { subtotalAmount { amount currencyCode } }
    lines(first: 50) {
      nodes {
        id
        quantity
        merchandise {
          ... on ProductVariant {
            id
            title
            price { amount currencyCode }
            product { title handle }
          }
        }
      }
    }
  `;

  async function gql<T>(query: string, variables: Record<string, unknown> = {}): Promise<T> {
    const res = await fetch(`https://${cfg!.domain}/api/${cfg!.apiVersion}/graphql.json`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Shopify-Storefront-Access-Token': cfg!.token,
      },
      body: JSON.stringify({ query, variables }),
    });
    const json = await res.json();
    if (json.errors) throw new Error(json.errors[0]?.message ?? 'Storefront error');
    return json.data as T;
  }

  const mapCart = (cart: any) => {
    if (!cart) return false;
    checkoutUrl = cart.checkoutUrl ?? '';
    lines = (cart.lines?.nodes ?? []).map((node: any) => ({
      id: node.id,
      quantity: node.quantity,
      title: node.merchandise?.product?.title ?? '',
      variantTitle: node.merchandise?.title === 'Default Title' ? '' : (node.merchandise?.title ?? ''),
      amount: Number(node.merchandise?.price?.amount ?? 0),
      currency: node.merchandise?.price?.currencyCode ?? cfg?.currency ?? 'EUR',
    }));
    return true;
  };

  async function fetchCart() {
    const id = localStorage.getItem(STORAGE_KEY);
    if (!id) return;
    try {
      const data = await gql<{ cart: any }>(`query($id: ID!){ cart(id: $id){ ${CART_FIELDS} } }`, { id });
      if (!data.cart) localStorage.removeItem(STORAGE_KEY);
      else mapCart(data.cart);
    } catch {
      localStorage.removeItem(STORAGE_KEY);
    }
  }

  async function addLive(variantId: string, quantity: number) {
    const id = localStorage.getItem(STORAGE_KEY);
    if (!id) {
      const data = await gql<{ cartCreate: any }>(
        `mutation($lines: [CartLineInput!]!){ cartCreate(input:{lines:$lines}){ cart { ${CART_FIELDS} } userErrors { message } } }`,
        { lines: [{ merchandiseId: variantId, quantity }] }
      );
      const cart = data.cartCreate?.cart;
      if (!cart) throw new Error(data.cartCreate?.userErrors?.[0]?.message ?? 'cartCreate failed');
      localStorage.setItem(STORAGE_KEY, cart.id);
      mapCart(cart);
      return;
    }
    const data = await gql<{ cartLinesAdd: any }>(
      `mutation($id: ID!, $lines: [CartLineInput!]!){ cartLinesAdd(cartId:$id, lines:$lines){ cart { ${CART_FIELDS} } userErrors { message } } }`,
      { id, lines: [{ merchandiseId: variantId, quantity }] }
    );
    const cart = data.cartLinesAdd?.cart;
    if (!cart) {
      localStorage.removeItem(STORAGE_KEY);
      throw new Error('cartLinesAdd failed');
    }
    mapCart(cart);
  }

  async function updateLive(lineId: string, quantity: number) {
    const id = localStorage.getItem(STORAGE_KEY);
    if (!id) return;
    if (quantity <= 0) {
      const data = await gql<{ cartLinesRemove: any }>(
        `mutation($id: ID!, $ids: [ID!]!){ cartLinesRemove(cartId:$id, lineIds:$ids){ cart { ${CART_FIELDS} } } }`,
        { id, ids: [lineId] }
      );
      mapCart(data.cartLinesRemove?.cart);
      return;
    }
    const data = await gql<{ cartLinesUpdate: any }>(
      `mutation($id: ID!, $lines: [CartLineUpdateInput!]!){ cartLinesUpdate(cartId:$id, lines:$lines){ cart { ${CART_FIELDS} } } }`,
      { id, lines: [{ id: lineId, quantity }] }
    );
    mapCart(data.cartLinesUpdate?.cart);
  }

  /* ---------------- Mode démonstration (Shopify non connecté) ---------------- */
  const loadDemo = () => {
    try {
      lines = JSON.parse(localStorage.getItem(DEMO_KEY) || '[]');
    } catch {
      lines = [];
    }
  };
  const saveDemo = () => localStorage.setItem(DEMO_KEY, JSON.stringify(lines));

  /* ---------------- Rendu ---------------- */
  const render = () => {
    const count = lines.reduce((n, l) => n + l.quantity, 0);
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
      el.textContent = String(count);
      el.hidden = count === 0;
    });
    document.querySelectorAll<HTMLElement>('[data-cart-count-inline]').forEach((el) => {
      el.textContent = String(count);
    });

    const list = document.querySelector<HTMLElement>('[data-cart-lines]');
    const empty = document.querySelector<HTMLElement>('[data-cart-empty]');
    const totalEl = document.querySelector<HTMLElement>('[data-cart-total]');
    const checkout = document.querySelector<HTMLAnchorElement>('[data-cart-checkout]');
    if (!list || !empty || !totalEl) return;

    empty.hidden = count > 0;
    list.innerHTML = lines
      .map(
        (l) => `
        <li class="cline" data-line="${l.id}">
          <span class="cline__thumb"><img src="/brand/yunma-mark.png" alt="" loading="lazy" /></span>
          <div>
            <p class="cline__title">${l.title}</p>
            ${l.variantTitle ? `<p class="cline__meta">${l.variantTitle}</p>` : ''}
            <span class="cline__qty">
              <button type="button" data-line-dec aria-label="−">−</button>
              <span class="mono-num">${l.quantity}</span>
              <button type="button" data-line-inc aria-label="+">+</button>
            </span>
          </div>
          <div>
            <p class="cline__price">${money(l.amount * l.quantity, l.currency)}</p>
            <button type="button" class="cline__remove" data-line-remove>×</button>
          </div>
        </li>`
      )
      .join('');

    const total = lines.reduce((sum, l) => sum + l.amount * l.quantity, 0);
    totalEl.textContent = count ? money(total, lines[0]?.currency ?? 'EUR') : '—';

    if (checkout) {
      const usable = isLive() && !!checkoutUrl && count > 0;
      checkout.setAttribute('href', usable ? checkoutUrl : '#');
      checkout.toggleAttribute('data-disabled', !usable);
      checkout.style.opacity = usable ? '1' : '0.4';
      checkout.style.pointerEvents = usable ? 'auto' : 'none';
    }
  };

  const openCart = () => {
    const el = document.querySelector<HTMLElement>('[data-cart]');
    if (!el) return;
    el.hidden = false;
    document.body.classList.add('is-locked');
    requestAnimationFrame(() => el.classList.add('is-open'));
  };

  const closeCart = () => {
    const el = document.querySelector<HTMLElement>('[data-cart]');
    if (!el) return;
    el.classList.remove('is-open');
    document.body.classList.remove('is-locked');
    window.setTimeout(() => {
      el.hidden = true;
    }, 550);
  };

  async function addToCart(btn: HTMLElement) {
    const variantId = btn.dataset.variant || '';
    const qtyInput = btn.dataset.qtyTarget
      ? document.querySelector<HTMLInputElement>(btn.dataset.qtyTarget)
      : null;
    const quantity = Math.max(1, Number(qtyInput?.value || btn.dataset.quantity || 1));
    const original = btn.textContent;

    btn.setAttribute('disabled', 'true');
    try {
      if (isLive() && variantId) {
        await addLive(variantId, quantity);
      } else {
        loadDemo();
        const key = `demo:${btn.dataset.sku || variantId || btn.dataset.title}`;
        const existing = lines.find((l) => l.id === key);
        if (existing) existing.quantity += quantity;
        else
          lines.push({
            id: key,
            quantity,
            title: btn.dataset.title || '',
            variantTitle: btn.dataset.variantTitle || '',
            amount: Number(btn.dataset.price || 0),
            currency: cfg?.currency || 'EUR',
          });
        saveDemo();
      }
      render();
      openCart();
      toast(cfg?.strings.added ?? '');
    } catch (err) {
      console.error('[yunma] cart', err);
      toast(cfg?.strings.error ?? '');
    } finally {
      btn.removeAttribute('disabled');
      if (original) btn.textContent = original;
    }
  }

  async function changeLine(lineId: string, quantity: number) {
    if (isLive()) {
      await updateLive(lineId, quantity);
    } else {
      loadDemo();
      const line = lines.find((l) => l.id === lineId);
      if (line) {
        line.quantity = quantity;
        if (quantity <= 0) lines = lines.filter((l) => l.id !== lineId);
      }
      saveDemo();
    }
    render();
  }

  const bindGlobals = () => {
    if (bound) return;
    bound = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const toggle = target.closest<HTMLElement>('[data-cart-toggle]');
      if (toggle) {
        e.preventDefault();
        openCart();
        return;
      }

      if (target.closest('[data-cart-close]')) {
        e.preventDefault();
        closeCart();
        return;
      }

      const add = target.closest<HTMLElement>('[data-add-to-cart]');
      if (add) {
        e.preventDefault();
        void addToCart(add);
        return;
      }

      const lineEl = target.closest<HTMLElement>('[data-line]');
      if (lineEl) {
        const id = lineEl.dataset.line!;
        const current = lines.find((l) => l.id === id)?.quantity ?? 1;
        if (target.closest('[data-line-inc]')) void changeLine(id, current + 1);
        else if (target.closest('[data-line-dec]')) void changeLine(id, current - 1);
        else if (target.closest('[data-line-remove]')) void changeLine(id, 0);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const el = document.querySelector<HTMLElement>('[data-cart]');
      if (el && !el.hidden) closeCart();
    });
  };

  const init = async () => {
    cfg = readConfig();
    if (!cfg) return;
    bindGlobals();
    if (isLive()) {
      await fetchCart();
    } else {
      loadDemo();
      document.querySelectorAll<HTMLElement>('[data-cart-demo]').forEach((el) => el.removeAttribute('hidden'));
    }
    render();
  };

  document.addEventListener('astro:page-load', () => void init());
</script>
