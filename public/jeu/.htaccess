# La base des parties ne se sert pas : elle se lit depuis PHP, jamais par le web.
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Rien à mettre en cache : une partie change à chaque seconde.
<IfModule mod_headers.c>
  <FilesMatch "\.(php|json)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
