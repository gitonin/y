# Yunma — configuration Apache pour un hébergement mutualisé (Infomaniak).
#
# Ce fichier part avec chaque construction : il est déposé dans `public/`, et
# Astro le recopie à la racine du dossier livré. Rien à déposer à la main.
#
# Chaque bloc est protégé par <IfModule> : si l'hébergeur n'active pas un
# module, la règle est ignorée au lieu de mettre le site en erreur 500.

# ----------------------------------------------------------------------------
# Page d'erreur
# ----------------------------------------------------------------------------
# Une adresse inconnue rend la page 404 du site plutôt que celle d'Apache.
# Elle détecte la langue du visiteur et lui propose de repartir.
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------------
# Adresse canonique : https, sans www
# ----------------------------------------------------------------------------
# Les adresses canoniques et le plan du site annoncent https://yunma.fr — tout
# le reste doit y mener, sous peine de compter deux fois chaque page aux yeux
# des moteurs.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Le certificat est souvent terminé en amont du serveur : `%{HTTPS}` vaut
  # alors `off` même sur une visite sécurisée. On interroge donc aussi l'en-tête
  # que le relais ajoute, sans quoi la règle boucle indéfiniment.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://yunma.fr/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ----------------------------------------------------------------------------
# Racine : renvoi vers la langue du visiteur
# ----------------------------------------------------------------------------
# Mieux vaut renvoyer depuis le serveur que servir une page qui se contente de
# rebondir : un renvoi HTTP ne laisse aucune page à indexer, donc aucun signal
# contradictoire à démêler pour les moteurs. La page de rebond reste en place
# derrière, au cas où mod_rewrite manquerait.
#
# 302 et non 301 : la destination dépend du visiteur. Figée dans les caches,
# elle enverrait tout le monde vers la langue du premier arrivé.
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP:Accept-Language} ^zh [NC]
  RewriteRule ^(index\.html)?$ /zh/ [R=302,L]

  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^(index\.html)?$ /en/ [R=302,L]

  RewriteRule ^(index\.html)?$ /fr/ [R=302,L]
</IfModule>

# Les caches doivent distinguer les langues, sans quoi le premier passage
# servirait sa destination à tous les suivants.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Vary "Accept-Language"
  </FilesMatch>
</IfModule>

# Une adresse sans barre finale reçoit sa barre : le site est construit en
# dossiers (`/fr/cafes/` → `/fr/cafes/index.html`), et c'est mod_dir qui s'en
# charge. On le réaffirme, le réglage pouvant être désactivé sur certains hôtes.
<IfModule mod_dir.c>
  DirectorySlash On
  DirectoryIndex index.html
</IfModule>

# ----------------------------------------------------------------------------
# Compression
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  # Les images matricielles et les polices sont déjà compressées : les repasser
  # à la moulinette coûte du calcul sans gagner un octet.
</IfModule>

# ----------------------------------------------------------------------------
# Durées de cache
# ----------------------------------------------------------------------------
# Trois régimes, selon que l'adresse d'un fichier change avec son contenu.
# On distingue les fichiers à empreinte des autres par leur dossier, ce qu'un
# <FilesMatch> ne sait pas faire — d'où ce marquage par mod_rewrite.
<IfModule mod_rewrite.c>
  RewriteRule ^_astro/ - [E=EMPREINTE:1]
</IfModule>

<IfModule mod_headers.c>
  # Un an, et sans jamais revenir demander : le nom change avec le contenu.
  Header set Cache-Control "public, max-age=31536000, immutable" env=EMPREINTE
  Header set Cache-Control "public, max-age=31536000, immutable" env=REDIRECT_EMPREINTE

  # Les autres visuels — logo, icônes, images de partage — gardent leur nom
  # d'une version à l'autre. Une semaine : assez pour soulager le serveur, assez
  # court pour qu'un logo remplacé paraisse sans attendre.
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Les pages, elles, gardent leur adresse : il faut les revalider à chaque
  # visite, sinon une correction de texte mettrait des jours à paraître.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Le plan du site et les fichiers de tête changent d'adresse jamais, de
  # contenu souvent : une journée suffit.
  <FilesMatch "^(sitemap.*\.xml|robots\.txt|llms\.txt|site\.webmanifest)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Ne pas laisser deviner le type d'un fichier à partir de son contenu, et ne
  # transmettre l'adresse de provenance qu'aux sites tiers, sans le chemin.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------------------
# Types de fichiers
# ----------------------------------------------------------------------------
# Servis avec le mauvais type, ils sont téléchargés au lieu d'être affichés.
<IfModule mod_mime.c>
  AddType image/webp                 .webp
  AddType image/avif                 .avif
  AddType image/svg+xml              .svg
  AddType font/woff2                 .woff2
  AddType application/manifest+json  .webmanifest
  AddCharset UTF-8                   .html .css .js .json .xml .txt
</IfModule>

# ----------------------------------------------------------------------------
# Discrétion
# ----------------------------------------------------------------------------
# Pas d'index automatique : un dossier sans page ne doit pas livrer sa liste.
Options -Indexes

# Ce fichier ne se sert pas lui-même.
<Files ".htaccess">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>
